module storage.mojom;

import "third_party/blink/public/mojom/cache_storage_raw/cache_storage_raw.mojom";

// Controls the state of CacheStorageRaw within a partition. This is a privileged
// interface and must not be brokered to untrusted clients.
//
// Currently this is consumed and implemented in the browser process, but the
// implementation will eventually live in the storage service which may run
// out-of-process.
interface CacheStorageRawControl {
  // Binds a CacheStorageRaw receiver to the CacheStorageRawControl to access
  // the cache storage.
  AddReceiver(
      pending_receiver<blink.mojom.CacheStorageRaw> receiver);

};
