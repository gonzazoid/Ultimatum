<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="el">
<translation id="1001534784610492198">Το αρχείο του προγράμματος εγκατάστασης είναι κατεστραμμένο ή μη έγκυρο. Κατεβάστε το Ultimatum ξανά.</translation>
<translation id="1018937009655463387">Για να μοιραστείτε το παράθυρό σας, επιτρέψτε την εγγραφή οθόνης για το Ultimatum στις Ρυθμίσεις συστήματος.</translation>
<translation id="1026101648481255140">Συνέχιση εγκατάστασης</translation>
<translation id="102763973188675173">Προσαρμόστε και ελέγξτε το Ultimatum. Υπάρχει διαθέσιμη ενημέρωση.</translation>
<translation id="1028061813283459617">Για να διαγράψετε τα δεδομένα περιήγησης μόνο από αυτή τη συσκευή και να τα διατηρήσετε στον Λογαριασμό σας Google, <ph name="BEGIN_LINK" />αποσυνδεθείτε από το Ultimatum<ph name="END_LINK" />.</translation>
<translation id="1042270987544905725">Κάντε κλικ για να κλείσετε το παράθυρο διαλόγου σύνδεσης του Ultimatum</translation>
<translation id="1059838145689930908">Για να χρησιμοποιήσετε αυτή την επέκταση με τον λογαριασμό <ph name="USER_EMAIL_ADDRESS" />, συνδεθείτε στο Ultimatum.</translation>
<translation id="1065672644894730302">Δεν είναι δυνατή η ανάγνωση των προτιμήσεών σας. Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες και οι αλλαγές στις προτιμήσεις δεν θα αποθηκευτούν.</translation>
<translation id="1086486568852410168">Αναζήτηση με Google Lens</translation>
<translation id="1088300314857992706">Η διεύθυνση <ph name="USER_EMAIL_ADDRESS" /> χρησιμοποιούσε το Ultimatum στο παρελθόν</translation>
<translation id="110877069173485804">Ορίστε το δικό σας Ultimatum</translation>
<translation id="1125124144982679672">Ποιος χρησιμοποιεί το Ultimatum;</translation>
<translation id="1142745911746664600">Δεν είναι δυνατή η ενημέρωση του Ultimatum</translation>
<translation id="1152920704813762236">Σχετικά με το UltimatumOS</translation>
<translation id="1154147086299354128">&amp;Άνοιγμα στο Ultimatum</translation>
<translation id="1157985233335035034">Πρόσφατες γλώσσες</translation>
<translation id="1184145431117212167">Η εγκατάσταση απέτυχε επειδή η έκδοση των Windows που χρησιμοποιείτε δεν υποστηρίζεται.</translation>
<translation id="1194807384646768652">Το Ultimatum απέκλεισε αυτή τη λήψη επειδή δεν πραγματοποιείται συχνά λήψη αυτού του τύπου αρχείου και ενδέχεται να είναι επικίνδυνος</translation>
<translation id="1203500561924088507">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε το πρόγραμμα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME" />.</translation>
<translation id="1278833599417554002">Επανεκκίνηση για ενημέρωση του &amp;Ultimatum</translation>
<translation id="1290883685122687410">Σφάλμα ρύθμισης: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1302523850133262269">Περιμένετε μέχρι να γίνει εγκατάσταση των πιο πρόσφατων ενημερώσεων συστήματος από το Ultimatum.</translation>
<translation id="1330562121671411446">Εντοπισμός γλώσσας</translation>
<translation id="1335640173511558774">Το <ph name="MANAGER" /> απαιτεί να διαβάσετε και να αποδεχτείτε τους παρακάτω Όρους Παροχής Υπηρεσιών πριν από τη χρήση αυτής της συσκευής. Οι συγκεκριμένοι όροι δεν επεκτείνουν, τροποποιούν ή περιορίζουν τους Όρους του UltimatumOS Flex.</translation>
<translation id="1341711321000856656">Μπορείτε να κάνετε εναλλαγή για να δείτε τους κωδικούς πρόσβασης από ένα άλλο προφίλ Ultimatum</translation>
<translation id="1356661055722410047">Νέο! Μπορείτε να μεταφράσετε κείμενο και εικόνες που εμφανίζονται στην οθόνη σας</translation>
<translation id="1363996462118479832">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Ultimatum OS λόγω σφάλματος κατά τη σύνδεση.</translation>
<translation id="137466361146087520">Ultimatum Beta</translation>
<translation id="1383876407941801731">Αναζήτηση</translation>
<translation id="1399397803214730675">Αυτός ο υπολογιστής διαθέτει ήδη μια πιο πρόσφατη έκδοση του Ultimatum. Αν το λογισμικό δεν λειτουργεί, απεγκαταστήστε το Ultimatum και δοκιμάστε ξανά.</translation>
<translation id="141901961143729572">Μοιραστείτε τις σκέψεις σας</translation>
<translation id="1425903838053942728">{COUNT,plural, =0{Ολοκληρώθηκε η ενημέρωση του Ultimatum. Επανεκκινήστε το για να χρησιμοποιήσετε την πιο πρόσφατη έκδοση. Στη συνέχεια, οι τρέχουσες καρτέλες σας θα ανοίξουν ξανά.}=1{Ολοκληρώθηκε η ενημέρωση του Ultimatum. Επανεκκινήστε το για να χρησιμοποιήσετε την πιο πρόσφατη έκδοση. Στη συνέχεια, οι τρέχουσες καρτέλες σας θα ανοίξουν ξανά. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Ολοκληρώθηκε η ενημέρωση του Ultimatum. Επανεκκινήστε το για να χρησιμοποιήσετε την πιο πρόσφατη έκδοση. Στη συνέχεια, οι τρέχουσες καρτέλες σας θα ανοίξουν ξανά. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="1434626383986940139">Εφαρμογές Ultimatum Canary</translation>
<translation id="146866447420868597">Σύνδεση στο Ultimatum;</translation>
<translation id="1492280395845991349">Κάντε επανεκκίνηση για να ολοκληρώσετε την ενημέρωση του Ultimatum</translation>
<translation id="1497802159252041924">Σφάλμα εγκατάστασης: <ph name="INSTALL_ERROR" /></translation>
<translation id="1507198376417198979">Προσαρμόστε το νέο σας προφίλ Ultimatum</translation>
<translation id="1518627427551567882">Αυτή η σελίδα είναι προστατευμένη</translation>
<translation id="1547295885616600893">Το Ultimatum OS υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS" />λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="1547469039832541117">Τερματίζει την επισημασμένη εργασία.</translation>
<translation id="1553358976309200471">Ενημερώστε το Ultimatum</translation>
<translation id="1587223624401073077">Το Ultimatum χρησιμοποιεί την κάμερά σας.</translation>
<translation id="1587325591171447154">Το αρχείο <ph name="FILE_NAME" /> είναι επικίνδυνο, επομένως έχει αποκλειστεί από το Ultimatum.</translation>
<translation id="1597911401261118146">Για να ελέγξετε αν οι κωδικοί πρόσβασής σας είναι ασφαλείς από παραβιάσεις δεδομένων και άλλα ζητήματα ασφαλείας, <ph name="BEGIN_LINK" />συνδεθείτε στο Ultimatum<ph name="END_LINK" />.</translation>
<translation id="1619887657840448962">Για να κάνουμε το Ultimatum πιο ασφαλές, απενεργοποιήσαμε τις ακόλουθες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="1628000112320670027">Λήψη βοήθειας σχετικά με το Ultimatum</translation>
<translation id="1640672724030957280">Γίνεται λήψη…</translation>
<translation id="1651617469580841801">Όταν χρησιμοποιείτε το Google Lens, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, αποστέλλονται στην Google. <ph name="LEARN_MORE" /></translation>
<translation id="1662146548738125461">Σχετικά με το UltimatumOS Flex</translation>
<translation id="1674870198290878346">Άνοιγμα Συνδέσμου σε Παράθυρο ανών&amp;υμης περιήγησης Ultimatum</translation>
<translation id="1682634494516646069">Το Ultimatum δεν έχει δυνατότητα ανάγνωσης και εγγραφής στον κατάλογο δεδομένων του:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="1698376642261615901">Το Ultimatum είναι ένα πρόγραμμα περιήγησης ιστού που εκτελεί εφαρμογές και ιστοσελίδες με απίστευτη ταχύτητα. Είναι γρήγορο, σταθερό και εύχρηστο. Περιηγηθείτε στον ιστό με μεγαλύτερη ασφάλεια με την ενσωματωμένη προστασία από κακόβουλα προγράμματα και ηλεκτρονικό "ψάρεμα" (phishing).</translation>
<translation id="1713301662689114961">{0,plural, =1{Η επανεκκίνηση του Ultimatum θα γίνει σε μία ώρα}other{Η επανεκκίνηση του Ultimatum θα γίνει σε # ώρες}}</translation>
<translation id="1722488837206509557">Αυτό θα σας επιτρέψει να επιλέγετε μία από τις διαθέσιμες συσκευές και να προβάλλετε περιεχόμενο σε αυτήν.</translation>
<translation id="1786003790898721085">Βεβαιωθείτε ότι έχετε συνδεθεί στο Ultimatum στη συσκευή σας <ph name="TARGET_DEVICE_NAME" /> και έπειτα δοκιμάστε ξανά την αποστολή.</translation>
<translation id="1786044937610313874">Οι συντομεύσεις ανοίγουν στο Ultimatum</translation>
<translation id="178701303897325119">Αυτή η επέκταση δεν υποστηρίζεται πλέον. Το Ultimatum συνιστά να την καταργήσετε.</translation>
<translation id="1812689907177901597">Με την απενεργοποίηση αυτής της λειτουργίας, μπορείτε να συνδεθείτε σε ιστοτόπους Google, όπως το Gmail, χωρίς να συνδεθείτε στο Ultimatum</translation>
<translation id="1821644463306970002">{NUM_TABS,plural, =1{Το Ultimatum συνιστά να θέσετε σε παύση την καρτέλα που επιβραδύνει το πρόγραμμα περιήγησης}other{Το Ultimatum συνιστά να θέσετε σε παύση τις καρτέλες που επιβραδύνουν το πρόγραμμα περιήγησης}}</translation>
<translation id="1838374766361614909">Διαγραφή αναζητήσεων</translation>
<translation id="1860536484129686729">Το Ultimatum χρειάζεται άδεια, για να αποκτήσει πρόσβαση στην κάμερα για αυτόν τον ιστότοπο</translation>
<translation id="1873233029667955273">Το Ultimatum δεν είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="1874309113135274312">Ultimatum Beta (mDNS-In)</translation>
<translation id="1877026089748256423">Το Ultimatum δεν είναι ενημερωμένο</translation>
<translation id="1880677175115548835">Επιλογή κειμένου</translation>
<translation id="1919130412786645364">Να επιτρέπεται η σύνδεση στο Ultimatum</translation>
<translation id="1953553007165777902">Λήψη… Απομένουν <ph name="MINUTE" /> λεπτά</translation>
<translation id="2001586581944147178">Κάντε πιο δύσκολο για άτομα που έχουν πρόσβαση στη διαδικτυακή κίνησή σας να βλέπουν ποιους ιστοτόπους επισκέπτεστε. Το Ultimatum χρησιμοποιεί μια ασφαλή σύνδεση για να αναζητήσει τη διεύθυνση IP ενός ιστοτόπου στο DNS (Domain Name System).</translation>
<translation id="2008942457798486387">{NUM_EXTENSIONS,plural, =1{Αυτή η επέκταση δεν υποστηρίζεται πλέον. Το Ultimatum συνιστά να την καταργήσετε.}other{Αυτές οι επεκτάσεις δεν υποστηρίζονται πλέον. Το Ultimatum συνιστά να τις καταργήσετε.}}</translation>
<translation id="2018528049276128029">Κάθε προφίλ διατηρεί τις δικές του πληροφορίες στο Ultimatum, όπως σελιδοδείκτες, ιστορικό, κωδικούς πρόσβασης και άλλα.</translation>
<translation id="2018879682492276940">Αποτυχία εγκατάστασης. Δοκιμάστε ξανά.</translation>
<translation id="2024959665595762054">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Ultimatum στον Λογαριασμό σας Google, επαληθεύστε την ταυτότητά σας</translation>
<translation id="2034233344106846793">Το Ultimatum αναβαθμίζει αυτόματα τις μη ασφαλείς συνδέσεις σε HTTPS όταν είναι εφικτό</translation>
<translation id="207902854391093810">Όταν είναι ενεργοποιημένες οι δοκιμές, η Μέτρηση διαφημίσεων επιτρέπει στους ιστοτόπους που επισκέπτεστε να ζητούν πληροφορίες από το Ultimatum που βοηθούν τον ιστότοπο να μετρήσει την απόδοση των διαφημίσεών του. Η Μέτρηση διαφημίσεων περιορίζει την παρακολούθηση μεταξύ ιστοτόπων μεταφέροντας όσο το δυνατόν λιγότερες πληροφορίες μεταξύ των ιστοτόπων.</translation>
<translation id="2091012649849228750">Για τη λήψη μελλοντικών ενημερώσεων του Ultimatum, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 8.</translation>
<translation id="2094648590148273905">Όροι UltimatumOS Flex</translation>
<translation id="2094919256425865063">Να τερματιστεί η λειτουργία του Ultimatum ούτως ή άλλως;</translation>
<translation id="2106831557840787829">Το UltimatumOS Flex υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS" />λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS" />, όπως είναι το <ph name="BEGIN_LINK_LINUX_OSS" />περιβάλλον ανάπτυξης Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="2108778574543343055">Απενεργοποίηση του Ultimatum, όταν εκτελούνται εφαρμογές στο παρασκήνιο</translation>
<translation id="2120620239521071941">Με αυτή την ενέργεια θα διαγραφούν <ph name="ITEMS_COUNT" /> στοιχεία από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Ultimatum ως <ph name="USER_EMAIL" />.</translation>
<translation id="2121284319307530122">Επανεκκίνηση για ενημέρωση του &amp;Ultimatum</translation>
<translation id="2123055963409958220">Συμβάλετε στη βελτίωση του Ultimatum, αναφέροντας τις <ph name="BEGIN_LINK" />τρέχουσες ρυθμίσεις<ph name="END_LINK" /></translation>
<translation id="2126108037660393668">Η επιβεβαίωση του ληφθέντος αρχείου απέτυχε.</translation>
<translation id="2128411189117340671">Διαχείριση προφίλ Ultimatum</translation>
<translation id="2131230230468101642">Για την προστασία του απορρήτου σας, διαγράφουμε αυτόματα τα ενδιαφέροντα που είναι παλαιότερα των 4 εβδομάδων. Καθώς συνεχίζετε την περιήγηση, ενδέχεται να εμφανιστεί ξανά ένα ενδιαφέρον στη λίστα. Εναλλακτικά, μπορείτε να καταργήσετε τα ενδιαφέροντα που δεν θέλετε να λαμβάνει υπόψη το Ultimatum.</translation>
<translation id="2137162749895930932">Κλείσιμο οθόνης μετάφρασης</translation>
<translation id="2139300032719313227">Επανεκκίνηση Ultimatum OS</translation>
<translation id="2151406531797534936">Επανεκκινήστε το Ultimatum τώρα</translation>
<translation id="2163089732491971196">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Ultimatum στον Λογαριασμό σας Google, εισαγάγετε τη φράση πρόσβασης</translation>
<translation id="2174917724755363426">Η εγκατάσταση δεν έχει ολοκληρωθεί. Είστε βέβαιοι ότι θέλετε να την ακυρώσετε;</translation>
<translation id="2186206192313702726">Google Lens</translation>
<translation id="2190166659037789668">Σφάλμα ελέγχου για ενημερώσεις: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199691482078155239">Το Ultimatum προσφέρει περισσότερο έλεγχο ως προς τις διαφημίσεις που βλέπετε και περιορίζει τις πληροφορίες που μπορούν να μάθουν για εσάς οι ιστότοποι κατά την προβολή εξατομικευμένων διαφημίσεων</translation>
<translation id="2216543877350048334">Για να καταργήσετε τον Λογαριασμό σας Google από το Ultimatum, αποσυνδεθείτε</translation>
<translation id="2236949375853147973">Η δραστηριότητά μου</translation>
<translation id="2290014774651636340">Λείπουν κλειδιά του Google API. Ορισμένες λειτουργίες του Ultimatum θα απενεργοποιηθούν.</translation>
<translation id="2290095356545025170">Είστε βέβαιοι ότι θέλετε να απεγκαταστήσετε του Ultimatum;</translation>
<translation id="2309047409763057870">Αυτή είναι μια δευτερεύουσα εγκατάσταση του Ultimatum και δεν μπορεί να γίνει το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="2345992953227471816">Το Ultimatum εντόπισε κακόβουλο πρόγραμμα σε αυτές τις επεκτάσεις:</translation>
<translation id="2348335408836342058">Το Ultimatum χρειάζεται άδεια, για να αποκτήσει πρόσβαση στην κάμερα και στο μικρόφωνο για αυτόν τον ιστότοπο</translation>
<translation id="234869673307233423">Το Ultimatum δεν μπορεί να ελέγξει τους κωδικούς πρόσβασής σας. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="2359808026110333948">Συνέχεια</translation>
<translation id="2403703063067034158">Σφάλμα εκκίνησης: Αυτή τη στιγμή εκτελείται μια άλλη παρουσία της ρύθμισης. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="2409816192575564775">{NUM_DEVICES,plural, =0{Αποκτήθηκε πρόσβαση σε 1 συσκευή HID από μία ή περισσότερες επεκτάσεις Ultimatum}=1{Αποκτήθηκε πρόσβαση σε 1 συσκευή HID από μία ή περισσότερες επεκτάσεις Ultimatum}other{Αποκτήθηκε πρόσβαση σε # συσκευές HID από μία ή περισσότερες επεκτάσεις Ultimatum}}</translation>
<translation id="2424440923901031101">Αυτή η επέκταση παραβαίνει την πολιτική του Ultimatum Web Store και μπορεί να μην είναι ασφαλής. Καταργήστε την από το Ultimatum, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="2467438592969358367">Το Ultimatum θέλει να εξαγάγει τους κωδικούς πρόσβασής σας. Για να το επιτρέψετε αυτό, πληκτρολογήστε τον κωδικό πρόσβασης για τα Windows.</translation>
<translation id="2472092250898121027">Αυτή η επέκταση περιέχει κακόβουλο πρόγραμμα και δεν είναι ασφαλής. Καταργήστε την από το Ultimatum, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="2485422356828889247">Απεγκατάσταση</translation>
<translation id="2513154137948333830">Απαιτείται επανεκκίνηση: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2534365042754120737">Για την προστασία των δεδομένων σας, επιτρέψτε στο Ultimatum να καταργεί τις άδειες από τους ιστοτόπους που δεν έχετε επισκεφτεί πρόσφατα. Δεν διακόπτει τις ειδοποιήσεις.</translation>
<translation id="2556847002339236023">Ο οργανισμός σας κλείνει το Ultimatum όταν δεν χρησιμοποιείται για <ph name="TIMEOUT_DURATION" />. Τα δεδομένα περιήγησης διαγράφηκαν. Σε αυτά περιλαμβάνονται το ιστορικό, τα δεδομένα αυτόματης συμπλήρωσης και οι λήψεις.</translation>
<translation id="2559253115192232574">Αργότερα, ένας ιστότοπος που επισκέπτεστε μπορεί να ζητήσει από το Ultimatum να δει τα ενδιαφέροντά σας, προκειμένου να εξατομικεύσει τις διαφημίσεις που βλέπετε. Το Ultimatum μπορεί να κοινοποιήσει έως και 3 ενδιαφέροντα.</translation>
<translation id="2563121210305478421">Επανεκκίνηση του Ultimatum;</translation>
<translation id="2569974318947988067">Το Ultimatum θα προσπαθήσει να αναβαθμίσει τις πλοηγήσεις σε HTTPS</translation>
<translation id="2571392474191184472">Ο οργανισμός σας διαχειρίζεται το Ultimatum</translation>
<translation id="2574930892358684005">Ο χρήστης <ph name="EXISTING_USER" /> είναι συνδεδεμένος ήδη με αυτό το προφίλ Ultimatum. Για να διατηρήσει ξεχωριστά την περιήγησή σας, το Ultimatum μπορεί να δημιουργήσει το προφίλ σας για εσάς.</translation>
<translation id="2580411288591421699">Δεν είναι δυνατή η εγκατάσταση της ίδιας έκδοσης του Ultimatum που εκτελείται αυτήν τη στιγμή. Κλείστε το Ultimatum και προσπαθήστε ξανά.</translation>
<translation id="2586406160782125153">Με αυτή την ενέργεια θα διαγραφούν τα δεδομένα περιήγησης από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Ultimatum ως <ph name="USER_EMAIL" />.</translation>
<translation id="259935314519650377">Απέτυχε η αποθήκευση του ληφθέντος προγράμματος εγκατάστασης στην κρυφή μνήμη. Σφάλμα: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Σύστημα</translation>
<translation id="2645435784669275700">UltimatumOS</translation>
<translation id="2649768380733403658">Το Ultimatum ελέγχει τακτικά για να διασφαλίζει ότι το πρόγραμμα περιήγησης που χρησιμοποιείτε έχει τις πιο ασφαλείς ρυθμίσεις. Θα σας ενημερώνουμε, αν χρειάζεται να ελέγξετε κάτι.</translation>
<translation id="2652691236519827073">Άνοιγμα Συνδέσμου σε Νέα καρτέ&amp;λα Ultimatum</translation>
<translation id="2665296953892887393">Βοηθήστε μας να κάνουμε το Ultimatum καλύτερο, αποστέλλωντας αναφορές σφαλμάτων και <ph name="UMA_LINK" /> στην Google</translation>
<translation id="2668094785979141847">Κάντε κλικ για έξοδο από το Google Lens</translation>
<translation id="2681444469812712297">Ανοίξτε τη διεύθυνση <ph name="URL" /> σε νέα καρτέλα στο Ultimatum.</translation>
<translation id="2712141162840347885">Επιλέξτε οτιδήποτε για αναζήτηση με το Google Lens ή πατήστε Escape για έξοδο από το Google Lens</translation>
<translation id="2738871930057338499">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. HTTP 403 Forbidden. Ελέγξτε τη διαμόρφωση των παραμέτρων του διακομιστή μεσολάβησης.</translation>
<translation id="2742320827292110288">Προειδοποίηση: Το Ultimatum δεν μπορεί να αποτρέψει την καταγραφή του ιστορικού περιήγησής σας από τις επεκτάσεις. Για να απενεργοποιήσετε αυτή την επέκταση σε κατάσταση ανώνυμης περιήγησης, καταργήστε αυτή την επιλογή.</translation>
<translation id="2753623023919742414">Κάντε κλικ για αναζήτηση</translation>
<translation id="2765403129283291972">Το Ultimatum χρειάζεται άδεια, για να αποκτήσει πρόσβαση στο μικρόφωνο για αυτόν τον ιστότοπο</translation>
<translation id="2770231113462710648">Αλλαγή προεπιλεγμένου προγράμματος περιήγησης σε:</translation>
<translation id="2775140325783767197">Το Ultimatum δεν μπορεί να ελέγξει τους κωδικούς πρόσβασής σας. Δοκιμάστε να ελέγξετε τη σύνδεσή σας στο διαδίκτυο.</translation>
<translation id="2797864378188255696">Όταν συνδέεστε σε υπηρεσίες Google, όπως το Gmail ή το YouTube, με τον λογαριασμό <ph name="USER_EMAIL" />, μπορείτε να συνδέεστε αυτόματα στο Ultimatum με τον ίδιο λογαριασμό</translation>
<translation id="2799162042226656283">Το δικό σας Ultimatum</translation>
<translation id="2799223571221894425">Επανεκκίνηση</translation>
<translation id="2818684386420968393">Απενεργοποίηση του Ultimatum, όταν εκτελούνται εφαρμογές στο παρασκήνιο</translation>
<translation id="2825024317344269723">Επικίνδυνος ιστότοπος. Το Ultimatum κατάργησε ειδοποιήσεις.</translation>
<translation id="2841525013647267359">Μετάφραση από</translation>
<translation id="2846251086934905009">Σφάλμα εγκατάστασης: Το πρόγραμμα εγκατάστασης δεν ολοκληρώθηκε. Η εγκατάσταση ακυρώθηκε.</translation>
<translation id="2853415089995957805">Το Ultimatum προφορτώνει σελίδες που είναι πιθανό να επισκεφτείτε, ώστε να φορτώνονται πιο γρήγορα όταν τις επισκέπτεστε</translation>
<translation id="2857540653560290388">Εκκίνηση του Ultimatum…</translation>
<translation id="286025080868315611">Μάθετε γιατί το Ultimatum αποκλείει ορισμένες λήψεις</translation>
<translation id="2861074815332034794">Ενημέρωση του Ultimatum (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="2871893339301912279">Έχετε συνδεθεί στο Ultimatum!</translation>
<translation id="2876628302275096482">Μάθετε περισσότερα σχετικά με το <ph name="BEGIN_LINK" />πώς το Ultimatum διατηρεί ιδιωτικά τα δεδομένα σας<ph name="END_LINK" /></translation>
<translation id="2885378588091291677">Διαχείριση εργασιών</translation>
<translation id="2888126860611144412">Σχετικά με το Ultimatum</translation>
<translation id="2915996080311180594">Επανεκκίνηση αργότερα</translation>
<translation id="2926676257163822632">Είναι εύκολο να μαντέψει κανείς τους ασθενείς κωδικούς πρόσβασης. Επιτρέψτε στο Ultimatum να <ph name="BEGIN_LINK" />δημιουργεί και να απομνημονεύει ισχυρούς κωδικούς πρόσβασης για εσάς<ph name="END_LINK" />.</translation>
<translation id="2926952073016206995">Το Ultimatum χρειάζεται άδεια κάμερας για αυτόν τον ιστότοπο.</translation>
<translation id="2928420929544864228">Η εγκατάσταση ολοκληρώθηκε.</translation>
<translation id="2945997411976714835">Σφάλμα εγκατάστασης: Απέτυχε η εκκίνηση της διεργασίας του προγράμματος εγκατάστασης.</translation>
<translation id="2969728957078202736"><ph name="PAGE_TITLE" /> - Σύνδεση δικτύου - Ultimatum</translation>
<translation id="2970681950995291301">Για να καταργήσετε τον Λογαριασμό σας Google από το Ultimatum, αποσυνδεθείτε από το Ultimatum στη σελίδα Ρυθμίσεις</translation>
<translation id="2991167882679440829">Οι κωδικοί πρόσβασης και άλλα δεδομένα του Ultimatum που αποθηκεύσατε στον Λογαριασμό σας Google θα καταργηθούν από αυτή τη συσκευή. Για να τα χρησιμοποιήσετε ξανά στο Ultimatum, συνδεθείτε ξανά.</translation>
<translation id="2994465299455873643">Παρέχει υπηρεσίες κρυπτογράφησης και έναν ασφαλή τρόπο για ανάκτηση του <ph name="BROWSER_NAME" />, σε περίπτωση που δεν έχει ενημερωθεί. Αν απενεργοποιηθεί αυτή η υπηρεσία, το <ph name="BROWSER_NAME" /> ενδέχεται να χάσει την πρόσβαση στα κρυπτογραφημένα δεδομένα, με αποτέλεσμα το <ph name="BROWSER_NAME" /> να μην μπορεί να ανακτήσει τον εαυτό του.</translation>
<translation id="3003694935412297923">Όλες οι εργασίες</translation>
<translation id="3018957014024118866">Να διαγραφούν επίσης δεδομένα από το Ultimatum (<ph name="URL" />)</translation>
<translation id="3019382870990049182">Επανεκκίνηση για ενημέρωση του UltimatumOS Flex</translation>
<translation id="3037838751736561277">Το Ultimatum εκτελείται στο παρασκήνιο.</translation>
<translation id="3038232873781883849">Αναμονή για εγκατάσταση…</translation>
<translation id="3045032126857188731">Γλώσσα μετάφρασης: <ph name="LANGUAGE" /></translation>
<translation id="306179102415443347">Χρησιμοποιήστε τη συντόμευση για να μεταβείτε γρήγορα στον Διαχειριστή κωδικών πρόσβασης Google. Μπορείτε να μετακινήσετε τη συντόμευση στην αρχική οθόνη ή στην εφαρμογή εκκίνησης του υπολογιστή.</translation>
<translation id="3065168410429928842">Καρτέλα Ultimatum</translation>
<translation id="3080151273017101988">Να συνεχίζεται η εκτέλεση εφαρμογών παρασκηνίου όταν το Ultimatum είναι κλειστό</translation>
<translation id="3100998948628680988">Ονομάστε το προφίλ σας στο Ultimatum</translation>
<translation id="310459126943037700">Ο τερματισμός των εργασιών απέτυχε.</translation>
<translation id="3112458742631356345">Το Ultimatum απέκλεισε αυτή τη λήψη επειδή δεν πραγματοποιείται συχνά λήψη αυτού του αρχείου και ενδέχεται να είναι επικίνδυνο</translation>
<translation id="3114643501466072395">Για να ελέγξετε αν οι άλλοι κωδικοί πρόσβασής σας είναι ασφαλείς από παραβιάσεις δεδομένων και άλλα ζητήματα ασφαλείας, <ph name="BEGIN_LINK" />συνδεθείτε στο Ultimatum<ph name="END_LINK" />.</translation>
<translation id="3119573284443908657">Το Ultimatum απέκλεισε αυτή τη λήψη, επειδή το αρχείο αρχειοθέτησης περιλαμβάνει άλλα αρχεία που ενδέχεται να κρύβουν κάποιο κακόβουλο πρόγραμμα</translation>
<translation id="3135560418014806498">Προσθήκη προφίλ Ultimatum</translation>
<translation id="3137969841538672700">Σύρετε για αναζήτηση</translation>
<translation id="3140883423282498090">Οι αλλαγές που πραγματοποιήσατε θα ισχύσουν την επόμενη φορά που θα επανεκκινήσετε το Ultimatum.</translation>
<translation id="3149510190863420837">Εφαρμογές Ultimatum</translation>
<translation id="3161522574479303604">Όλες οι γλώσσες</translation>
<translation id="319199214552513804">Για να λάβετε αυτή την επέκταση και άλλα στοιχεία σε όλους τους υπολογιστές σας, συνδεθείτε στο Ultimatum</translation>
<translation id="3196187562065225381">Το Ultimatum απέκλεισε αυτή τη λήψη επειδή το αρχείο είναι επικίνδυνο</translation>
<translation id="3222857603094643834">Αναζητήστε οτιδήποτε σε αυτή τη σελίδα με το Google Lens</translation>
<translation id="3226612997184048185">Εάν αποθηκεύσετε τους σελιδοδείκτες σας και στον Λογαριασμό σας Google, μπορείτε να παρακολουθείτε τις τιμές των προϊόντων στο Ultimatum και να λαμβάνετε ειδοποιήσεις όταν παρατηρείται πτώση τιμών</translation>
<translation id="3242123554343253302">Προσθήκη προφίλ Ultimatum</translation>
<translation id="3245429137663807393">Εάν κοινοποιείτε επίσης αναφορές χρήσης του Ultimatum, αυτές περιλαμβάνουν τα URL που επισκέπτεστε</translation>
<translation id="3282568296779691940">Σύνδεση στο Ultimatum</translation>
<translation id="3286538390144397061">Άμεση επανεκκίνηση</translation>
<translation id="3292333338048274092">Στη συνέχεια, θα πρέπει να επανεκκινήσετε το Ultimatum.</translation>
<translation id="3327226547491422998">Αργότερα, το Ultimatum μπορεί να σας ρωτήσει αν θέλετε να χρησιμοποιήσετε τα αποθηκευμένα στοιχεία για την αυτόματη συμπλήρωση φορμών για εσάς</translation>
<translation id="3352986031709923790">επάνω δεξιά γωνία της περιοχής αναζήτησης: δεξιά <ph name="RIGHT" />%, επάνω <ph name="TOP" />%</translation>
<translation id="3360895254066713204">Ultimatum Helper</translation>
<translation id="3379938682270551431">{0,plural, =0{Η επανεκκίνηση του Ultimatum θα γίνει τώρα}=1{Η επανεκκίνηση του Ultimatum θα γίνει σε 1 δευτερόλεπτο}other{Η επανεκκίνηση του Ultimatum θα γίνει σε # δευτερόλεπτα}}</translation>
<translation id="3396977131400919238">Παρουσιάστηκε σφάλμα στο λειτουργικό σύστημα κατά την εγκατάσταση. Κατεβάστε το Ultimatum ξανά.</translation>
<translation id="3428747202529429621">Διατηρεί την ασφάλειά σας στο Ultimatum και μπορεί να χρησιμοποιηθεί για τη βελτίωση της ασφάλειάς σας σε άλλες εφαρμογές Google όταν είστε συνδεδεμένοι.</translation>
<translation id="3434246496373299699">Το Ultimatum μπορεί να ελέγξει τους κωδικούς πρόσβασής σας όταν συνδέεστε με τον Λογαριασμό σας Google.</translation>
<translation id="3438681572027105609">Για να έχετε πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Ultimatum</translation>
<translation id="3450887623636316740">Αυτό το αρχείο ενδέχεται να είναι επικίνδυνο<ph name="LINE_BREAK" />Το Ultimatum μπορεί να ελέγξει αυτή τη λήψη για εσάς εάν καταχωρίσετε τον κωδικό πρόσβασης. Οι πληροφορίες σχετικά με το αρχείο αποστέλλονται στην Ασφαλή περιήγηση Google, αλλά το περιεχόμενο και ο κωδικός πρόσβασης του αρχείου παραμένουν στη συσκευή σας.</translation>
<translation id="3451115285585441894">Προσθήκη στο Ultimatum...</translation>
<translation id="345171907106878721">Προσθήκη του εαυτού σας στο Ultimatum</translation>
<translation id="3453763134178591239">Όροι Ultimatum OS</translation>
<translation id="3503306920980160878">Το Ultimatum χρειάζεται πρόσβαση στην τοποθεσία σας, για να την κοινοποιήσει σε αυτόν τον ιστότοπο</translation>
<translation id="3533694711092285624">Δεν υπάρχουν αποθηκευμένοι κωδικοί πρόσβασης. Το Ultimatum μπορεί να ελέγξει τους κωδικούς πρόσβασής σας όταν τους αποθηκεύσετε.</translation>
<translation id="3541482654983822893">Το Ultimatum δεν μπορεί να ελέγξει τους κωδικούς πρόσβασής σας. Δοκιμάστε ξανά σε 24 ώρες.</translation>
<translation id="3576528680708590453">Ο διαχειριστής συστήματος έχει διαμορφώσει το Ultimatum έτσι ώστε να ανοίγει άλλο πρόγραμμα περιήγησης για την πρόσβαση στη διεύθυνση <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="3582972582564653026">Συγχρονίστε και εξατομικεύστε το Ultimatum στις συσκευές σας</translation>
<translation id="3583751698304738917">Είστε ήδη συνδεδεμένοι ως <ph name="USER_EMAIL_ADDRESS" /> σε ένα άλλο προφίλ Ultimatum</translation>
<translation id="3595784445906693824">Σύνδεση στο Ultimatum σε ένα νέο προφίλ;</translation>
<translation id="3596080736082218006">{COUNT,plural, =0{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Ultimatum, προκειμένου να εφαρμοστεί μια ενημέρωση.}=1{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Ultimatum, προκειμένου να εφαρμοστεί μια ενημέρωση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Ultimatum, προκειμένου να εφαρμοστεί μια ενημέρωση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="3597003331831379823">Απέτυχε η εκτέλεση της ρύθμισης με αναβαθμισμένα προνόμια. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3609788354808247807">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Ultimatum κατάργησε τις άδειες <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" /></translation>
<translation id="3622716124581627104">Αναγνωρίστε αντικείμενα ή μέρη, και αντιγράψτε ή μεταφράστε κείμενο. Όταν χρησιμοποιείτε το Google Lens, ένα στιγμιότυπο οθόνης της σελίδας αποστέλλεται στην Google. <ph name="LEARN_MORE" /></translation>
<translation id="3622797965165704966">Τώρα μπορείτε να χρησιμοποιείτε πιο εύκολα το Ultimatum με το Λογαριασμό σας Google και σε κοινόχρηστους υπολογιστές.</translation>
<translation id="3635073343384702370">Το Ultimatum μπορεί να ελέγξει τους κωδικούς πρόσβασής σας όταν τους αποθηκεύετε</translation>
<translation id="3667616615096815454">Δεν είναι δυνατή η εγκατάσταση, ο διακομιστής δεν γνωρίζει την εφαρμογή.</translation>
<translation id="3673813398384385993">Το Ultimatum εντόπισε κακόβουλο πρόγραμμα στην επέκταση "<ph name="EXTENSION_NAME" />".</translation>
<translation id="3697952514309507634">Άλλα προφίλ Ultimatum</translation>
<translation id="3703994572283698466">Το Ultimatum OS υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS" />λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS" />, όπως είναι το <ph name="BEGIN_LINK_LINUX_OSS" />περιβάλλον ανάπτυξης Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="3716540481907974026">Έκδοση UltimatumOS Flex</translation>
<translation id="3718181793972440140">Με αυτή την ενέργεια θα διαγραφεί 1 στοιχείο από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Ultimatum ως <ph name="USER_EMAIL" />.</translation>
<translation id="3723744677043446310">{NUM_EXTENSIONS,plural, =1{Το Ultimatum προτείνει να την καταργήσετε. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK" />}other{Το Ultimatum προτείνει να την καταργήσετε. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK" />}}</translation>
<translation id="3780814664026482060">Ultimatum - <ph name="PAGE_TITLE" /></translation>
<translation id="3785324443014631273">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το UltimatumOS Flex λόγω σφάλματος κατά τη σύνδεση.</translation>
<translation id="3795971588916395511">Λειτουργικό σύστημα Ultimatum OS</translation>
<translation id="3809772425479558446">Το Ultimatum απαιτεί Windows 10 ή νεότερη έκδοση.</translation>
<translation id="383928141529488001">Το Ultimatum χρειάζεται πρόσβαση στο Bluetooth για εξερεύνηση 
 Συσκευών Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="386202838227397562">Κλείστε όλα τα παράθυρα του Ultimatum και προσπαθήστε ξανά.</translation>
<translation id="3873044882194371212">Άνοιγμα συνδέσμου σε παράθυρο ανών&amp;υμης περιήγησης Ultimatum</translation>
<translation id="3885770153807205175">Εργαλείο επιλογής γλώσσας</translation>
<translation id="3889417619312448367">Απεγκατάσταση Ultimatum</translation>
<translation id="3892148308691398805">Αντιγραφή κειμένου</translation>
<translation id="3941890832296813527">Σφάλμα εγκατάστασης: Το όνομα αρχείου του προγράμματος εγκατάστασης δεν είναι έγκυρο ή δεν υποστηρίζεται.</translation>
<translation id="395904275706073188">Δεν είναι δυνατή η ανάγνωση προστατευμένων σελίδων. Δοκιμάστε διαφορετική σελίδα.</translation>
<translation id="3968962723676998462">Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιείτε και να αποθηκεύετε δεδομένα Ultimatum στον λογαριασμό σας, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="3973161977468201858">Το Ultimatum θέλει να διαγράψει τα δεδομένα της Διαχείρισης κωδικών πρόσβασης Google. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτή την ενέργεια.</translation>
<translation id="400161754580828648">Για να μοιραστείτε την οθόνη σας, επιτρέψτε την εγγραφή οθόνης για το Ultimatum στις Ρυθμίσεις συστήματος.</translation>
<translation id="4022972681110646219">Μετάφραση οθόνης</translation>
<translation id="4023601594785368013">Αρχική γλώσσα: <ph name="LANGUAGE" /></translation>
<translation id="4035053306113201399">Για να εφαρμοστεί η ενημέρωση, πρέπει να γίνει επανεκκίνηση του Ultimatum OS.</translation>
<translation id="4050175100176540509">Στην πιο πρόσφατη έκδοση διατίθενται σημαντικές βελτιώσεις ασφάλειας και νέες λειτουργίες.</translation>
<translation id="4053720452172726777">Προσαρμογή και έλεγχος του Ultimatum</translation>
<translation id="408393047846373801">Για να έχετε πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Ultimatum. Αυτός ο κωδικός πρόσβασης θα αποθηκευτεί στον Λογαριασμό σας Google αφού συνδεθείτε.</translation>
<translation id="409936259433005390">Θα κάνετε σύντομα αναβάθμιση σε Windows 11; Κατεβάστε το πρόγραμμα εγκατάστασης του Ultimatum στο OneDrive, για να είστε έτοιμοι από την πρώτη κιόλας ημέρα.</translation>
<translation id="4110895483821904099">Ρυθμίστε το νέο σας προφίλ στο Ultimatum</translation>
<translation id="4111566860456076004">Το Ultimatum δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης και ενδέχεται να μην είναι ασφαλής. Καταργήστε την από το Ultimatum, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων.</translation>
<translation id="4128488089242627000">Το Ultimatum εκτελείται πιο γρήγορα και οι λειτουργίες που χρησιμοποιούν JavaScript θα πρέπει να λειτουργούν με τον αναμενόμενο τρόπο (συνιστάται)</translation>
<translation id="4147555960264124640">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο Ultimatum. Τα δεδομένα σας στο Ultimatum, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME" />. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών Google, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. <ph name="LEARN_MORE" /></translation>
<translation id="4148957013307229264">Γίνεται εγκατάσταση...</translation>
<translation id="4149882025268051530">Η αποσυμπίεση του αρχείου από το πρόγραμμα εγκατάστασης απέτυχε. Κατεβάστε το Ultimatum ξανά.</translation>
<translation id="415112847282352845">Για να έχετε πρόσβαση στις διευθύνσεις σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Ultimatum. Αυτή η διεύθυνση θα αποθηκευτεί στον Λογαριασμό σας Google μετά τη σύνδεσή σας.</translation>
<translation id="4153934450158521343">Το Ultimatum θα κλείσει σύντομα και θα διαγράψει δεδομένα</translation>
<translation id="4173512894976930765">Οι ιστότοποι πιθανώς θα λειτουργούν με τον αναμενόμενο τρόπο. Θα αποσυνδεθείτε από τους περισσότερους ιστοτόπους όταν κλείσετε όλα τα παράθυρα του Ultimatum, εκτός από τον Λογαριασμό σας Google εάν είστε συνδεδεμένοι στο Ultimatum.</translation>
<translation id="4175922240926474352">Το Ultimatum απέκλεισε αυτή τη λήψη επειδή ο ιστότοπος δεν χρησιμοποιεί ασφαλή σύνδεση και το αρχείο μπορεί να έχει παραβιαστεί</translation>
<translation id="4191857738314598978">{0,plural, =1{Επανεκκίνηση του Ultimatum σε μία ημέρα}other{Επανεκκίνηση του Ultimatum σε # ημέρες}}</translation>
<translation id="4205939740494406371">Το Ultimatum δεν μπορεί να ελέγξει τους κωδικούς πρόσβασής σας. Δοκιμάστε ξανά μετά από 24 ώρες ή <ph name="BEGIN_LINK" />ελέγξτε τους κωδικούς πρόσβασης στον Λογαριασμό σας Google<ph name="END_LINK" />.</translation>
<translation id="4222932583846282852">Ακύρωση…</translation>
<translation id="4224210481850767180">Η εγκατάσταση ακυρώθηκε.</translation>
<translation id="4242034826641750751">Το Ultimatum χρειάζεται άδειες κάμερας και μικροφώνου για αυτόν τον ιστότοπο.</translation>
<translation id="424864128008805179">Αποσύνδεση από το Ultimatum;</translation>
<translation id="4251615635259297716">Να συνδεθούν τα δεδομένα σας στο Ultimatum με αυτόν το λογαριασμό;</translation>
<translation id="4281844954008187215">Όροι Παροχής Υπηρεσιών</translation>
<translation id="4293420128516039005">Συνδεθείτε, για να συγχρονίσετε και να εξατομικεύσετε το Ultimatum στις συσκευές σας</translation>
<translation id="430327780270213103">Να επιτρέπεται στην επέκταση να εμφανίζει αιτήματα πρόσβασης στη γραμμή εργαλείων του Ultimatum</translation>
<translation id="4326552909330437744">{NUM_TABS,plural, =1{Το Ultimatum συνιστά να θέσετε σε παύση την καρτέλα που επιβραδύνει το πρόγραμμα περιήγησης}other{Το Ultimatum συνιστά να θέσετε σε παύση τις καρτέλες που επιβραδύνουν το πρόγραμμα περιήγησης}}</translation>
<translation id="4328355335528187361">Ultimatum Dev (mDNS-In)</translation>
<translation id="4329315893554541805">Για να αξιοποιήσετε την εξατομίκευση και άλλες λειτουργίες, συμπεριλάβετε το Ultimatum στη Δραστηριότητα ιστού και εφαρμογών και στις συνδεδεμένες υπηρεσίες Google</translation>
<translation id="4334294535648607276">Η λήψη ολοκληρώθηκε.</translation>
<translation id="4337324600316876133">Για τη λήψη μελλοντικών ενημερώσεων του Ultimatum, θα χρειαστείτε macOS 12 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί macOS 11.</translation>
<translation id="4343195214584226067">Η επέκταση <ph name="EXTENSION_NAME" /> προστέθηκε στο Ultimatum</translation>
<translation id="4348548358339558429">Για εξατομίκευση, συμπεριλάβετε το Ultimatum στη Δραστηριότητα ιστού και εφαρμογών</translation>
<translation id="436060642166082913">Το Ultimatum απέκλεισε αυτή τη λήψη, επειδή το αρχείο μπορεί να βλάψει τους προσωπικούς σας λογαριασμούς και τους λογαριασμούς σας σε κοινωνικά δίκτυα</translation>
<translation id="4367027658822022112">Μπορείτε να καρφιτσώσετε το Google Lens για εύκολη πρόσβαση, κάνοντας κλικ στο κουμπί Καρφίτσωμα στο επάνω μέρους του πλαϊνού πλαισίου</translation>
<translation id="4389991535395284064">Κατά την περιήγηση σε Κατάσταση ανώνυμης περιήγησης, το Ultimatum θα σας ειδοποιεί πριν από τη φόρτωση ενός ιστοτόπου με μη ασφαλή σύνδεση</translation>
<translation id="4427306783828095590">Η βελτιωμένη προστασία κάνει περισσότερα για τον αποκλεισμό ηλεκτρονικού ψαρέματος (phishing) και κακόβουλων προγραμμάτων</translation>
<translation id="4434353761996769206">Σφάλμα προγράμματος εγκατάστασης: <ph name="INSTALLER_ERROR" /></translation>
<translation id="4450664632294415862">Ultimatum - Σύνδεση δικτύου - <ph name="PAGE_TITLE" /></translation>
<translation id="4458462641685292929">Μια άλλη λειτουργία βρίσκεται σε εξέλιξη στο Ultimatum. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="4459234553906210702">Η Μέτρηση διαφημίσεων επιτρέπει στους ιστοτόπους που επισκέπτεστε να ζητούν πληροφορίες από το Ultimatum που βοηθούν τον ιστότοπο να μετρήσει την απόδοση των διαφημίσεών του. Η Μέτρηση διαφημίσεων περιορίζει την παρακολούθηση μεταξύ ιστοτόπων μεταφέροντας όσο το δυνατόν λιγότερες πληροφορίες μεταξύ των ιστοτόπων.</translation>
<translation id="4493028449971051158">Σφάλμα εκκίνησης: Εκτελέστε το πρόγραμμα εγκατάστασης ως διαχειριστής.</translation>
<translation id="4501471624619070934">Η εγκατάσταση απέτυχε επειδή η πρόσβαση είναι περιορισμένη σε αυτήν τη χώρα.</translation>
<translation id="4567424176335768812">Έχετε συνδεθεί ως <ph name="USER_EMAIL_ADDRESS" />. Τώρα μπορείτε να αποκτήσετε πρόσβαση στους σελιδοδείκτες, το ιστορικό και σε άλλες ρυθμίσεις από όλες τις συσκευές στις οποίες έχετε συνδεθεί.</translation>
<translation id="4571503333518166079">Μετάβαση στις ρυθμίσεις ειδοποιήσεων του Ultimatum</translation>
<translation id="459622048091363950">Όταν το Ultimatum αποκτήσει πρόσβαση, οι ιστότοποι θα μπορούν να σας ζητήσουν πρόσβαση.</translation>
<translation id="4598116752460667024">Αναζητήστε οποιαδήποτε διεργασία από τη λίστα.</translation>
<translation id="4600710005438004015">Δεν ήταν δυνατή η ενημέρωση του Ultimatum στην πιο πρόσφατη έκδοση και έτσι δεν θα έχετε πρόσβαση στις νέες λειτουργίες και στις επιδιορθώσεις ασφαλείας.</translation>
<translation id="4624065194742029982">Ανώνυμη περιήγηση Ultimatum</translation>
<translation id="4627412468266359539">Προαιρετικά: Συμβάλετε στη βελτίωση των λειτουργιών και της απόδοσης του UltimatumOS Flex με την αυτόματη αποστολή διαγνωστικών στοιχείων και δεδομένων χρήσης στην Google.</translation>
<translation id="4633000520311261472">Για να κάνουμε το Ultimatum πιο ασφαλές, απενεργοποιήσαμε ορισμένες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="4680828127924988555">Ακύρωση εγκατάστασης</translation>
<translation id="4720851490453439956">Εσωτερική υπηρεσία Google Updater</translation>
<translation id="4724676981607797757">Η εγκατάσταση απέτυχε λόγω σφάλματος μη υποστηριζόμενου πρωτοκόλλου.</translation>
<translation id="4728575227883772061">Η εγκατάσταση απέτυχε λόγω απροσδιόριστου σφάλματος. Αν το Ultimatum εκτελείται αυτήν τη στιγμή, κλείστε το και δοκιμάστε ξανά.</translation>
<translation id="4737281654364167024">Για να συνεχίσετε, συνδεθείτε στο Ultimatum ως <ph name="EMAIL" />. Αυτή η ενέργεια διασφαλίζει ότι ακολουθείτε τις πολιτικές του οργανισμού σας.</translation>
<translation id="4741235124132242877">Καρφιτσώθηκε! Χρησιμοποιήστε ξανά το Google Lens από τη γραμμή εργαλείων</translation>
<translation id="4747730611090640388">Το Ultimatum μπορεί να κάνει εκτιμήσεις για τα ενδιαφέροντά σας.  Αργότερα, ένας ιστότοπος που επισκέπτεστε μπορεί να ζητήσει από το Ultimatum να δει τα ενδιαφέροντά σας, προκειμένου να εξατομικεύσει τις διαφημίσεις που βλέπετε.</translation>
<translation id="475321580758063259">Ενημερώστε το Ultimatum, για να συνεχίσετε να χρησιμοποιείτε τα δεδομένα του Ultimatum στον Λογαριασμό σας Google, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="4754614261631455953">Ultimatum Canary (mDNS-In)</translation>
<translation id="479167709087336770">Αυτό χρησιμοποιεί τον ίδιο ορθογραφικό έλεγχο που χρησιμοποιείται στην Αναζήτηση Google. Το κείμενο που πληκτρολογείτε στο πρόγραμμα περιήγησης αποστέλλεται στην Google. Μπορείτε ανά πάσα στιγμή να αλλάξετε αυτήν τη συμπεριφορά στις ρυθμίσεις.</translation>
<translation id="4793679854893018356">Μάθετε πώς σας προστατεύει το Ultimatum</translation>
<translation id="4828579605166583682">Το Ultimatum προσπαθεί να αντικαταστήσει τους υπάρχοντες κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτή την ενέργεια.</translation>
<translation id="4842397268809523050">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το UltimatumOS Flex επειδή ο συγχρονισμός δεν είναι διαθέσιμος για τον τομέα σας.</translation>
<translation id="4851866215237571846">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος.  Για να διατηρήσετε ξεχωριστά την περιήγησή σας, συνδεθείτε στο Ultimatum στο δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="4855026984605187434">Για να μοιραστείτε την οθόνη σας, επιτρέψτε την εγγραφή οθόνης για το Ultimatum στις Ρυθμίσεις συστήματος</translation>
<translation id="4873783916118289636">Ελέγξτε σημαντικά στοιχεία ελέγχου για το απόρρητο και την ασφάλεια στο Ultimatum</translation>
<translation id="4885446229353981848">Να εμφανίζεται πάντα η συντόμευση Google Lens</translation>
<translation id="4891791193823137474">Να επιτρέπεται στο Ultimatum να εκτελείται στο παρασκήνιο</translation>
<translation id="4895437082222824641">Άνοιγμα συνδέσμου σε νέα καρτέ&amp;λα Ultimatum</translation>
<translation id="4918844574251943176">Η εικόνα αντιγράφηκε</translation>
<translation id="492720062778050435">Το Ultimatum συνιστά να ελέγξετε αυτή την επέκταση</translation>
<translation id="4953650215774548573">Ορίστε το Ultimatum ως προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="495931528404527476">Στο Ultimatum</translation>
<translation id="4969674060580488087">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το UltimatumOS Flex επειδή τα στοιχεία σύνδεσης του λογαριασμού σας δεν είναι ενημερωμένα.</translation>
<translation id="4970761609246024540">Καλώς ήρθατε στα προφίλ του Ultimatum</translation>
<translation id="4970880042055371251">Έκδοση Ultimatum OS</translation>
<translation id="4990567037958725628">Ultimatum Canary</translation>
<translation id="5003967926796347400">Κάντε κλικ στην επιλογή Διαχείριση κωδικών πρόσβασης Google</translation>
<translation id="504867494566807945">Ανοίξτε συνδέσμους στο Ultimatum από οποιαδήποτε εφαρμογή. Επιπλέον, για εύκολη πρόσβαση, καρφιτσώνεται στη γραμμή εργαλείων.</translation>
<translation id="5114340746415930644">Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Ultimatum στον λογαριασμό σας, <ph name="USER_EMAIL" /></translation>
<translation id="5120334927898581447">Σύνδεση στο Ultimatum όταν συνδέεστε σε άλλες υπηρεσίες Google</translation>
<translation id="5126049312684316860">Το Ultimatum προφορτώνει ακόμα περισσότερες σελίδες που είναι πιθανό να επισκεφτείτε, ώστε να φορτώνουν πιο γρήγορα όταν τις επισκέπτεστε</translation>
<translation id="5132929315877954718">Ανακαλύψτε υπέροχες εφαρμογές, παιχνίδια, επεκτάσεις και θέματα για το Ultimatum.</translation>
<translation id="5139423532931106058">Προσαρμόστε το προφίλ σας Ultimatum</translation>
<translation id="5163087008893166964">Καλωσορίσατε στο Ultimatum. Ένα νέο παράθυρο προγράμματος περιήγησης έχει ανοίξει.</translation>
<translation id="5166439563123238795">Το Ultimatum χρειάζεται άδεια για να παρακολουθεί τα χέρια σας</translation>
<translation id="5170938038195470297">Το προφίλ σας δεν μπορεί να χρησιμοποιηθεί επειδή προέρχεται από μια νεότερη έκδοση του Ultimatum.

Ορισμένες λειτουργίες μπορεί να μην είναι διαθέσιμες. Προσδιορίστε έναν διαφορετικό κατάλογο προφίλ ή χρησιμοποιήστε μια νεότερη έκδοση του Ultimatum.</translation>
<translation id="5174969993834422967">Συνήθως αποκλείετε τις ειδοποιήσεις. Για να επιτρέψετε σε αυτόν τον ιστότοπο να σας στέλνει ειδοποιήσεις, κάντε κλικ στο εικονίδιο ειδοποίησης στη δεξιά γωνία της γραμμής τοποθεσίας.</translation>
<translation id="5201744974236816379">Ενημέρωση chrome</translation>
<translation id="521447420733633466">Εάν χρησιμοποιείτε μια συσκευή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το Ultimatum ακριβώς όπως θέλουν.</translation>
<translation id="5234764350956374838">Παράβλεψη</translation>
<translation id="5239627039202700673">Χρησιμοποιήστε το Ultimatum κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές</translation>
<translation id="5251420635869119124">Οι επισκέπτες μπορούν να χρησιμοποιούν το Ultimatum χωρίς να αφήνουν κανένα ίχνος.</translation>
<translation id="5286907366254680517">Εντοπίστηκε</translation>
<translation id="5320351714793324716">Εάν επιτρέψετε τη χρήση cookie, το Ultimatum μπορεί να τα χρησιμοποιεί κατά την προφόρτωση</translation>
<translation id="5321325624576443340">Το Google Lens δεν είναι διαθέσιμο. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="5334309298019785904">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Ultimatum OS, επειδή ο συγχρονισμός δεν είναι διαθέσιμος για τον τομέα σας.</translation>
<translation id="5334487786912937552">Το Ultimatum χρειάζεται άδεια πρόσβασης στον αποθηκευτικό χώρο για τη λήψη αρχείων.</translation>
<translation id="5337648990166757586">Προαιρετικό: Συμβάλετε στη βελτίωση των λειτουργιών και της απόδοσης του Ultimatum OS με αυτόματη αποστολή διαγνωστικών και δεδομένων χρήσης στην Google.</translation>
<translation id="5368118228313795342">Επιπλέον κωδικός: <ph name="EXTRA_CODE" />.</translation>
<translation id="5386244825306882791">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του Ultimatum ή όταν κάνετε αναζήτηση από το κύριο πλαίσιο.</translation>
<translation id="5394833366792865639">Μοιραστείτε μια καρτέλα του Ultimatum</translation>
<translation id="5412485296464121825">Οι ιστότοποι μπορούν να αποθηκεύουν πληροφορίες σχετικά με τα ενδιαφέροντά σας στο Ultimatum. Για παράδειγμα, εάν επισκεφτείτε έναν ιστότοπο για να αγοράσετε παπούτσια για έναν μαραθώνιο, ο ιστότοπος μπορεί να ορίσει τους μαραθώνιους τρεξίματος ως ενδιαφέρον σας. Αργότερα, εάν επισκεφτείτε έναν διαφορετικό ιστότοπο για να εγγραφείτε σε έναν αγώνα, αυτός ο ιστότοπος μπορεί να σας εμφανίσει μια διαφήμιση για παπούτσια τρεξίματος με βάση τα ενδιαφέροντά σας.</translation>
<translation id="5430073640787465221">Το αρχείο προτιμήσεών σας είναι κατεστραμμένο ή μη έγκυρο.Το Ultimatum δεν μπορεί να ανακτήσει τις ρυθμίσεις σας.</translation>
<translation id="5468572406162360320">Για να συμβάλετε στη βελτίωση αυτών των λειτουργιών, το Ultimatum στέλνει στην Google τις αλληλεπιδράσεις σας με τις λειτουργίες. Αυτά τα δεδομένα ενδέχεται να αναγνωστούν, να υποβληθούν σε επεξεργασία και να σχολιαστούν από αναθεωρητές.</translation>
<translation id="5524761631371622910">Όταν είναι ενεργοποιημένες οι δοκιμές και εάν το Ultimatum σας έχει τοποθετήσει τυχαία σε μια ενεργή δοκιμή, το ιστορικό περιήγησής σας επηρεάζει τις διαφημίσεις που βλέπετε και τις εκτιμήσεις για τα ενδιαφέροντά σας παρακάτω. Για την προστασία του απορρήτου σας, το Ultimatum διαγράφει τα ενδιαφέροντά σας σε κυλιόμενη βάση κάθε μήνα.</translation>
<translation id="5524890928877629608">επάνω αριστερή γωνία της περιοχής αναζήτησης: αριστερά <ph name="LEFT" />%, επάνω <ph name="TOP" />%</translation>
<translation id="5530733413481476019">Κάντε το Ultimatum πιο γρήγορο</translation>
<translation id="5566025111015594046">Ultimatum (mDNS-In)</translation>
<translation id="5579324208890605088">Σφάλμα εκκίνησης: Εκτελέστε το πρόγραμμα εγκατάστασης ως απλός χρήστης και όχι ως διαχειριστής.</translation>
<translation id="5596627076506792578">Περισσότερες επιλογές</translation>
<translation id="5602351063754773347">Το Ultimatum προτείνει να την καταργήσετε. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK" /></translation>
<translation id="5649156266046089790">Με τα προφίλ του Ultimatum μπορείτε να διαχωρίσετε όλη τη δραστηριότητα και το περιεχόμενό σας στο Ultimatum. Δημιουργήστε προφίλ για φίλους και μέλη της οικογένειας ή διαχωρίστε την εργασία και τη διασκέδαση.</translation>
<translation id="565744775970812598">Το αρχείο <ph name="FILE_NAME" /> μπορεί να είναι επικίνδυνο, επομένως έχει αποκλειστεί από το Ultimatum.</translation>
<translation id="566568153320186256">Το Ultimatum εξοικονομεί μπαταρία περιορίζοντας τη δραστηριότητα στο παρασκήνιο και τα οπτικά εφέ, όπως είναι η ομαλή κύλιση και οι ρυθμοί καρέ βίντεο. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με την Εξοικονόμηση ενέργειας<ph name="END_LINK" /></translation>
<translation id="567202749201779594">Διαγράψτε τα δεδομένα του Ultimatum στον λογαριασμό σας</translation>
<translation id="5678190148303298925">{COUNT,plural, =0{Ο διαχειριστής σας ζητά να επανεκκινήσετε το Ultimatum, προκειμένου να εφαρμοστεί αυτή η ενημέρωση.}=1{Ο διαχειριστής σας ζητά να επανεκκινήσετε το Ultimatum, προκειμένου να εφαρμοστεί αυτή η ενημέρωση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Ο διαχειριστής σας ζητά να επανεκκινήσετε το Ultimatum, προκειμένου να εφαρμοστεί αυτή η ενημέρωση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="5686916850681061684">Προσαρμογή και έλεγχος του Ultimatum. Θα πρέπει να ελέγξετε μια ειδοποίηση, κάντε κλικ για λεπτομέρειες.</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="569897634095159764">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. Ο διακομιστής μεσολάβησης απαιτεί έλεγχο ταυτότητας.</translation>
<translation id="5709557627224531708">Ορισμός του Ultimatum ως προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="5727531838415286053">Εάν το Ultimatum σας έχει τοποθετήσει τυχαία σε μια ενεργή δοκιμή, το ιστορικό περιήγησής σας επηρεάζει τις διαφημίσεις που βλέπετε και τις εκτιμήσεις για τα ενδιαφέροντά σας παρακάτω. Για την προστασία του απορρήτου σας, το Ultimatum διαγράφει τα ενδιαφέροντά σας σε κυλιόμενη βάση κάθε μήνα. Τα ενδιαφέροντα ανανεώνονται, εκτός εάν τα καταργήσετε.</translation>
<translation id="5736850870166430177">Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό σας ή όταν κάνετε λήψη ενός επιβλαβούς αρχείου, το Ultimatum μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση</translation>
<translation id="5756509061973259733">Υπάρχει ήδη σε αυτήν τη συσκευή ένα προφίλ Ultimatum με αυτόν τον λογαριασμό</translation>
<translation id="5759947850379142561">Επιλέξτε οποιοδήποτε κείμενο ή εικόνα για αναζήτηση με το Google Lens ή πατήστε Escape για έξοδο από το Google Lens</translation>
<translation id="5795887333006832406"><ph name="PAGE_TITLE" /> - Ultimatum Canary</translation>
<translation id="5804318322022881572">Δεν ήταν δυνατή η εκκίνηση του Ultimatum. Προσπάθησε ξανά.</translation>
<translation id="5809516625706423866">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. HTTP 401 Unauthorized. Ελέγξτε τη διαμόρφωση παραμέτρων του διακομιστή μεσολάβησης.</translation>
<translation id="5824893331272123205">Δεν ήταν δυνατή η φόρτωση αυτού του πλαισίου. Δοκιμάστε ξανά.</translation>
<translation id="5825922397106002626">Κατάργηση της επέκτασης <ph name="EXTENSION_NAME" /> από το Ultimatum</translation>
<translation id="58431560289969279">Ενώ είστε συνδεδεμένοι, μπορείτε να χρησιμοποιήσετε τους κωδικούς πρόσβασής σας και πολλά άλλα από τον Λογαριασμό σας Google στο Ultimatum. Μπορείτε να αλλάξετε αυτή την επιλογή ανά πάσα στιγμή στις Ρυθμίσεις.</translation>
<translation id="5858486459377137936">Θα αποσυνδεθείτε από τους περισσότερους ιστοτόπους όταν κλείσετε όλα τα παράθυρα του Ultimatum, εκτός από τον Λογαριασμό σας Google εάν είστε συνδεδεμένοι στο Ultimatum. Για να επιτρέψετε στους ιστοτόπους να απομνημονεύουν τα στοιχεία σας, <ph name="SETTINGS_LINK" />.</translation>
<translation id="586971344380992563"><ph name="BEGIN_LINK" />Το Ultimatum σας προειδοποιεί<ph name="END_LINK" /> σχετικά με μη ασφαλείς ιστοτόπους και λήψεις</translation>
<translation id="5895138241574237353">Επανεκκίνηση</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - Σύνδεση δικτύου</translation>
<translation id="5924017743176219022">Γίνεται σύνδεση στο διαδίκτυο…</translation>
<translation id="5925596746603389877">Λήψη προγράμματος εγκατάστασης Ultimatum</translation>
<translation id="5940385492829620908">Εδώ μπορείτε να βρείτε τις ιστοσελίδες, τους σελιδοδείκτες σας και άλλα δεδομένα του Ultimatum.</translation>
<translation id="5941711191222866238">Ελαχιστοποίηση</translation>
<translation id="5941830788786076944">Ορισμός Ultimatum ως προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="5947104538377036631">Συντόμευση Ultimatum</translation>
<translation id="5953954252731207958">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Ultimatum κατάργησε την άδεια <ph name="PERMISSION" /></translation>
<translation id="5980111191913430208">Οι επεκτάσεις, οι εφαρμογές και τα θέματα από άγνωστες πηγές μπορούν να βλάψουν τη συσκευή σας. Το Ultimatum συνιστά την εγκατάστασή τους μόνο από το <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /></translation>
<translation id="6003112304606738118">Λήψη… Απομένουν <ph name="HOURS" /> ώρες</translation>
<translation id="6008161919456049856">Οι κωδικοί πρόσβασης, οι τρόποι πληρωμής και οι διευθύνσεις που αποθηκεύσατε στον Λογαριασμό σας Google θα καταργηθούν από αυτή τη συσκευή. Για να τα χρησιμοποιήσετε ξανά στο Ultimatum, συνδεθείτε ξανά.</translation>
<translation id="6014316319780893079">Με τα <ph name="BEGIN_LINK" />εργαλεία του Ultimatum<ph name="END_LINK" />, μπορείτε να περιηγείστε με ασφάλεια και να διατηρείτε τον έλεγχο</translation>
<translation id="6022659036123304283">Προσαρμόστε το Ultimatum για εσάς</translation>
<translation id="6025087594896450715">Θα γίνει επανεκκίνηση του Ultimatum σε <ph name="REMAINING_TIME" /></translation>
<translation id="6040143037577758943">Κλείσιμο</translation>
<translation id="604424701295382420">Καρφιτσώθηκε! Μπορείτε να αποκτήσετε ξανά πρόσβαση στο Google Lens από το νέο κουμπί στη γραμμή εργαλείων</translation>
<translation id="6069027071882229820">Αντιγραφή ως εικόνα</translation>
<translation id="6070348360322141662">Για επιπλέον ασφάλεια, το Ultimatum θα κρυπτογραφήσει τα δεδομένα σας</translation>
<translation id="6075300983329039771">Ο οργανισμός σας, <ph name="MANAGER" />, απαιτεί να συνδεθείτε στο Ultimatum</translation>
<translation id="6113794647360055231">Το Ultimatum έγινε ακόμα καλύτερο</translation>
<translation id="6116252277240876590">Αυτή η γλώσσα χρησιμοποιείται για την προβολή μενού, ρυθμίσεων, ειδοποιήσεων και άλλου κειμένου στο Ultimatum</translation>
<translation id="6127237283587442951">Χρήση Ultimatum από προεπιλογή και καρφίτσωμα</translation>
<translation id="6134085236017727171">Για χρήση του μικροφώνου, παραχωρήστε πρόσβαση στο Ultimatum στις <ph name="BEGIN_LINK" />ρυθμίσεις συστήματος<ph name="END_LINK" /></translation>
<translation id="6135456723633883042">Αυτές οι καρτέλες χρησιμοποιούν επιπλέον πόρους. Για να βελτιώσετε την απόδοσή σας, επιτρέψτε στο Ultimatum να τις απενεργοποιήσει.</translation>
<translation id="6145313976051292476">Άνοιγμα αρχείων PDF στο Ultimatum</translation>
<translation id="6150706324143004339">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Ultimatum στον Λογαριασμό σας Google, ενημερώστε το Ultimatum</translation>
<translation id="6157638032135951407">Ο οργανισμός σας διαγράφει τα δεδομένα του Ultimatum όταν δεν χρησιμοποιούνται για <ph name="TIMEOUT_DURATION" />. Σε αυτά περιλαμβάνονται το ιστορικό, τα δεδομένα αυτόματης συμπλήρωσης και οι λήψεις.</translation>
<translation id="6165508094623778733">Μάθετε περισσότερα</translation>
<translation id="6169866489629082767"><ph name="PAGE_TITLE" /> - Ultimatum</translation>
<translation id="6173637689840186878"><ph name="PAGE_TITLE" /> - Ultimatum Beta</translation>
<translation id="6180522807229584611">Αυτή η καρτέλα χρησιμοποιεί επιπλέον πόρους. Για να βελτιώσετε την απόδοση, επιτρέψτε στο Ultimatum να την απενεργοποιήσει.</translation>
<translation id="6182736845697986886">Η εγκατάσταση απέτυχε λόγω εσωτερικού σφάλματος στον διακομιστή ενημέρωσης.</translation>
<translation id="6200139057479872438">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Ultimatum κατάργησε τις άδειες <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /></translation>
<translation id="6235018212288296708">Εισερχόμενος κανόνας για το Ultimatum για να επιτρέπεται η κυκλοφορία του mDNS.</translation>
<translation id="624230925347970731">Το Ultimatum θα κλείσει σύντομα</translation>
<translation id="6247557882553405851">Διαχείριση κωδικών πρόσβασης Google</translation>
<translation id="6251759518630934363">Σας προειδοποιεί για επικίνδυνους ιστοτόπους, ακόμα και για όσους δεν γνώριζε η Google στο παρελθόν, αναλύοντας περισσότερα δεδομένα από ιστοτόπους σε σχέση με την βασική προστασία. Μπορείτε να επιλέξετε να παραβλέψετε τις ειδοποιήσεις του Ultimatum.</translation>
<translation id="6277547788421725101">Ο γονέας σου απενεργοποίησε την επιλογή "Άδειες για ιστοτόπους, εφαρμογές και επεκτάσεις" για το Ultimatum</translation>
<translation id="627882678981830918">Προσαρμογή και έλεγχος του Ultimatum. Ορίστε το Ultimatum ως προεπιλογή.</translation>
<translation id="6288580400488258237">Ορίστε το Ultimatum ως προεπιλεγμένο πρόγραμμα περιήγησης και καρφιτσώστε το στη γραμμή εργαλείων</translation>
<translation id="6291089322031436445">Εφαρμογές Ultimatum Dev</translation>
<translation id="6291549208091401781">Το Ultimatum είναι ήδη εγκατεστημένο για όλους τους χρήστες στον υπολογιστή σας.</translation>
<translation id="6319856120645568262">Το Ultimatum χρειάζεται άδεια για να χαρτογραφήσει τον περιβάλλοντα χώρο και να παρακολουθεί τα χέρια σας</translation>
<translation id="6321592572353357376">Η επέκταση <ph name="EXTENSION_NAME" /> θέλει να συνδεθείτε στο Ultimatum</translation>
<translation id="6326175484149238433">Κατάργηση από το Ultimatum</translation>
<translation id="6327105987658262776">Δεν υπάρχει διαθέσιμη ενημέρωση.</translation>
<translation id="6360449101159168105">Ενώ αυτή η καρτέλα ήταν ανενεργή, ελευθερώθηκε μνήμη για να παραμείνει γρήγορο το Ultimatum. Μπορείτε να επιλέξετε να εξαιρείται πάντα αυτός ο ιστότοπος, ώστε να παραμένει ενεργός.</translation>
<translation id="6412673304250309937">Ελέγχει αν τα URL περιλαμβάνονται στην λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο Ultimatum. Εάν ένας ιστότοπος προσπαθήσει να κλέψει τον κωδικό σας ή όταν κάνετε λήψη ενός επιβλαβούς αρχείου, το Ultimatum μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση.</translation>
<translation id="6417690341895039567">{COUNT,plural, =1{Ο οργανισμός σας κλείνει αυτόματα το Ultimatum όταν δεν χρησιμοποιείται για 1 λεπτό. Τα δεδομένα περιήγησης διαγράφονται. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις.}other{Ο οργανισμός σας κλείνει αυτόματα το Ultimatum όταν δεν χρησιμοποιείται για # λεπτά. Τα δεδομένα περιήγησης διαγράφονται. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις.}}</translation>
<translation id="6418662306461808273">Εναλλαγή σε υπάρχον προφίλ Ultimatum;</translation>
<translation id="6473905796280459355">Μετάβαση στη σελίδα Σχετικά με το Ultimatum</translation>
<translation id="6481963882741794338">Σύνδεση του Ultimatum και άλλων υπηρεσιών Google για εξατομίκευση και για άλλους σκοπούς</translation>
<translation id="648319183876919572">Η Βελτιωμένη Ασφαλής περιήγηση κάνει περισσότερα για την προστασία σας από επικίνδυνους ιστοτόπους και λήψεις</translation>
<translation id="6489302989675808168">Ενεργή • Το Ultimatum δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης</translation>
<translation id="6493527311031785448">Το Ultimatum προσπαθεί να <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="6497147134301593682">Το Ultimatum έκλεισε αυτόματα</translation>
<translation id="6506909944137591434">Το Ultimatum χρειάζεται άδεια κάμερας για να δημιουργήσει έναν τρισδιάστατο χάρτη του περιβάλλοντα χώρου σας.</translation>
<translation id="6515495397637126556"><ph name="PAGE_TITLE" /> - Ultimatum Dev</translation>
<translation id="6520670145826811516">Για χρήση της τοποθεσίας σας, παραχωρήστε πρόσβαση στο Ultimatum στις <ph name="BEGIN_LINK" />ρυθμίσεις συστήματος<ph name="END_LINK" /></translation>
<translation id="659498884637196217">Στον Διαχειριστή κωδικών πρόσβασης της Google σε αυτήν τη συσκευή</translation>
<translation id="6632473616050862500">Το UltimatumOS Flex υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS" />λογισμικού ανοιχτού κώδικα<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6634299872736643004">Οι αλλαγές σε αυτή τη ρύθμιση θα εφαρμοστούν μετά την επανεκκίνηση του Ultimatum.</translation>
<translation id="6660596345553328257">Σύνδεση στο Ultimatum;</translation>
<translation id="6664219008737641504">Εάν ξεχάσατε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, <ph name="SETTINGS_LINK" /> τα δεδομένα του Ultimatum στον λογαριασμό σας</translation>
<translation id="6676384891291319759">Πρόσβαση στο Διαδίκτυο</translation>
<translation id="6679975945624592337">Να επιτρέπεται στο Ultimatum να εκτελείται στο παρασκήνιο</translation>
<translation id="6696915334902295848">Το Ultimatum χρειάζεται άδεια μικροφώνου για αυτόν τον ιστότοπο.</translation>
<translation id="6712881677154121168">Σφάλμα λήψης: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="6718739135284199302">Κάντε το Ultimatum πιο γρήγορο</translation>
<translation id="6735387454586646204">Σύστημα UltimatumOS Flex</translation>
<translation id="6750954913813541382">Για τη διόρθωση ορθογραφικών λαθών, το Ultimatum στέλνει στην Google το κείμενο που πληκτρολογείτε στο πρόγραμμα περιήγησης</translation>
<translation id="677276454032249905">Να γίνει έξοδος από το Ultimatum ούτως ή άλλως;</translation>
<translation id="6794858689789885890">Να διαγράφονται πάντα τα δεδομένα ιστοτόπων από τη συσκευή σας όταν κλείνετε το Ultimatum</translation>
<translation id="6831043979455480757">Μετάφραση</translation>
<translation id="683440813066116847">Εισερχόμενος κανόνας για το Ultimatum Canary για να επιτρέπεται η κυκλοφορία του mDNS.</translation>
<translation id="684888714667046800">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. Εάν χρησιμοποιείτε τείχος προστασίας, βεβαιωθείτε ότι το <ph name="PRODUCT_EXE_NAME" /> είναι στη λίστα επιτρεπομένων.</translation>
<translation id="6851981911629679515">Ενεργοποιήστε την πρόσθετη προστασία στη μηχανή JavaScript και WebAssembly του Ultimatum</translation>
<translation id="6877155553248388166">κάτω δεξιά γωνία της περιοχής αναζήτησης: δεξιά <ph name="RIGHT" />%, κάτω <ph name="BOTTOM" />%</translation>
<translation id="6881299373831449287">Ενημέρωση Ultimatum</translation>
<translation id="6885412569789873916">Εφαρμογές Ultimatum Beta</translation>
<translation id="6893363893008038481">Κατάργηση λογαριασμού από το Ultimatum</translation>
<translation id="6896758677409633944">Αντιγραφή</translation>
<translation id="6930294499209825">Διατηρεί ενημερωμένο το λογισμικό Google που διαθέτετε. Εάν η υπηρεσία αυτή είναι απενεργοποιημένη ή έχει διακοπεί, το λογισμικό Google δεν θα διατηρείται ενημερωμένο, πράγμα που σημαίνει ότι δεν θα είναι δυνατή η επιδιόρθωση ευπαθειών ασφάλειας που μπορεί να εμφανιστούν και μπορεί να μη λειτουργούν ορισμένα χαρακτηριστικά. Η εγκατάσταση της υπηρεσίας αυτής καταργείται αυτόματα, όταν δεν υπάρχει λογισμικό Google που να τη χρησιμοποιεί.</translation>
<translation id="6933858244219479645">Σύστημα UltimatumOS</translation>
<translation id="6938166777909186039">Για τη λήψη μελλοντικών ενημερώσεων του Ultimatum, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 8.1.</translation>
<translation id="6943584222992551122">Τα δεδομένα περιήγησης αυτού του ατόμου θα διαγραφούν από αυτήν τη συσκευή. Για να επαναφέρετε τα δεδομένα, συνδεθείτε στο Ultimatum ως <ph name="USER_EMAIL" />.</translation>
<translation id="6965382102122355670">OK</translation>
<translation id="6967962315388095737">Εισερχόμενος κανόνας για το Ultimatum Beta για να επιτρέπεται η κυκλοφορία του mDNS.</translation>
<translation id="6979589607440534284">Μάθετε γιατί το Ultimatum αποκλείει ορισμένα αρχεία, ανοίγει σε νέα καρτέλα</translation>
<translation id="6991926986715044139">Να εμφανίζεται πάντα η συντόμευση Google Lens</translation>
<translation id="7011190694940573312">Η εγκατάσταση απέτυχε επειδή αυτή η έκδοση του λειτουργικού συστήματος δεν υποστηρίζεται.</translation>
<translation id="7024536598735240744">Σφάλμα αποσυσκευασίας: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7025789849649390912">Η εγκατάσταση διακόπηκε.</translation>
<translation id="7025800014283535195">Μπορείτε εδώ να κάνετε εναλλαγή μεταξύ των προφίλ του Ultimatum</translation>
<translation id="7059914902409643750">Προσαρμόστε το Ultimatum για εσάς</translation>
<translation id="7071827361006050863">Το Ultimatum θα διαγράψει σύντομα τα δεδομένα περιήγησης</translation>
<translation id="7085332316435785646">Επιλέξτε αν θέλετε να συμπεριλαμβάνεται το ιστορικό Ultimatum για πιο εξατομικευμένες εμπειρίες στις υπηρεσίες Google.</translation>
<translation id="7088681679121566888">Το Ultimatum έχει ενημερωθεί.</translation>
<translation id="7096221564931416126">Επιλέξτε οποιοδήποτε κείμενο ή εικόνα για αναζήτηση με το Google Lens</translation>
<translation id="7098166902387133879">Το Ultimatum χρησιμοποιεί το μικρόφωνό σας.</translation>
<translation id="7099479769133613710">Επανεκκίνηση για ενημέρωση του &amp;Ultimatum OS</translation>
<translation id="7106741999175697885">Διαχείριση Εργασιών - Ultimatum</translation>
<translation id="7140653346177713799">{COUNT,plural, =0{Υπάρχει νέα διαθέσιμη ενημέρωση για το Ultimatum και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση.}=1{Υπάρχει νέα διαθέσιμη ενημέρωση για το Ultimatum και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Υπάρχει νέα διαθέσιμη ενημέρωση για το Ultimatum και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="7155997830309522122">Σε αυτή την περίπτωση, επεξεργαστείτε τον αποθηκευμένο κωδικό πρόσβασής σας στο Ultimatum έτσι ώστε να ταιριάζει με τον νέο κωδικό πρόσβασής σας.</translation>
<translation id="7161904924553537242">Καλώς ήρθατε στο Ultimatum</translation>
<translation id="7193885263065350793">Ο οργανισμός σας κλείνει το Ultimatum όταν δεν χρησιμοποιείται για <ph name="TIMEOUT_DURATION" />.</translation>
<translation id="7242029209006116544">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο Ultimatum. Τα δεδομένα σας στο Ultimatum, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME" />. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών Google, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. Αν θέλετε, μπορείτε να δημιουργήσετε ένα νέο προφίλ στο οποίο θα διατηρηθούν ξεχωριστά τα υπάρχοντα δεδομένα του Ultimatum. <ph name="LEARN_MORE" /></translation>
<translation id="7285616922384953075">Ο οργανισμός <ph name="MANAGER" /> διαχειρίζεται το Ultimatum</translation>
<translation id="7288567540154601580">Καρτέλες και επεκτάσεις</translation>
<translation id="7296210096911315575">Σημαντικές πληροφορίες χρήσης και ασφάλειας</translation>
<translation id="7302361266603927550">Ορισμένα δεδομένα του Ultimatum δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="7308322188646931570">Το Ultimatum χρειάζεται πρόσβαση στο αποθηκευτικό χώρο για τη λήψη αρχείων</translation>
<translation id="7339898014177206373">Νέο παράθυρο</translation>
<translation id="7352651011704765696">Παρουσιάστηκε κάποιο πρόβλημα</translation>
<translation id="7386878009611068389">Για να είσαι πιο ασφαλής στο διαδίκτυο με τις επιλογές του γονέα σου, επίλεξε το προφίλ Ultimatum στο οποίο έχεις ήδη συνδεθεί ως <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="7398801000654795464">Συνδεθήκατε στο Ultimatum ως <ph name="USER_EMAIL_ADDRESS" />. Χρησιμοποιήστε τον ίδιο λογαριασμό για να συνδεθείτε ξανά.</translation>
<translation id="7412494426921990001">Κάντε κλικ στο μενού του Ultimatum</translation>
<translation id="7419819959108735624">Επιλέξτε οτιδήποτε για αναζήτηση με το Google Lens</translation>
<translation id="742463671275348370">{NUM_DEVICES,plural, =0{Αποκτήθηκε πρόσβαση σε 1 συσκευή USB από μία ή περισσότερες επεκτάσεις Ultimatum}=1{Αποκτήθηκε πρόσβαση σε 1 συσκευή USB από μία ή περισσότερες επεκτάσεις Ultimatum}other{Αποκτήθηκε πρόσβαση σε # συσκευές USB από μία ή περισσότερες επεκτάσεις Ultimatum}}</translation>
<translation id="7426611252293106642">Το Ultimatum ενδέχεται να μην λειτουργεί σωστά, επειδή δεν υποστηρίζεται πλέον σε αυτήν τη διανομή Linux.</translation>
<translation id="7437998757836447326">Αποσύνδεση από το Ultimatum</translation>
<translation id="7449333426561673451">{COUNT,plural, =1{Ο οργανισμός σας κλείνει αυτόματα το Ultimatum όταν δεν χρησιμοποιείται για 1 λεπτό.}other{Ο οργανισμός σας κλείνει αυτόματα το Ultimatum όταν δεν χρησιμοποιείται για # λεπτά.}}</translation>
<translation id="7450541714075000668">Το κείμενο αντιγράφηκε</translation>
<translation id="7452987490177144319">{COUNT,plural, =1{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το Ultimatum δεν χρησιμοποιείται για 1 λεπτό. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι καρτέλες σας θα παραμείνουν ανοιχτές.}other{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το Ultimatum δεν χρησιμοποιείται για # λεπτά. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι καρτέλες σας θα παραμείνουν ανοιχτές.}}</translation>
<translation id="7477130805345743099">Το Ultimatum θα σας ειδοποιεί πριν από τη φόρτωση ιστοτόπων με μη ασφαλή σύνδεση</translation>
<translation id="7481213027396403996">Λάβετε την ισχυρότερη ασφάλεια του Ultimatum</translation>
<translation id="749228101751499733">Ενώ είστε συνδεδεμένοι, μπορείτε να χρησιμοποιήσετε τους κωδικούς πρόσβασής σας και πολλά άλλα από τον Λογαριασμό σας Google στο Ultimatum. Η συντόμευση <ph name="SHORTCUT" /> μπορεί να αλλάξει τις ρυθμίσεις των υπηρεσιών Google.</translation>
<translation id="7496017508659652909">Το Ultimatum προφορτώνει τις σελίδες, κάτι το οποίο επιταχύνει την περιήγηση και την αναζήτηση. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις σελίδες προφόρτωσης<ph name="END_LINK" /></translation>
<translation id="7514258452813684157">Υπηρεσία Google Updater</translation>
<translation id="7515191208480168435">Μπορείτε να καρφιτσώσετε το Google Lens για εύκολη πρόσβαση</translation>
<translation id="7535429826459677826">Ultimatum Dev</translation>
<translation id="7543146567111253230">Για να αποκτήσετε αυτόν τον σελιδοδείκτη και άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Ultimatum</translation>
<translation id="756809126120519699">Τα δεδομένα του Ultimatum διαγράφηκαν</translation>
<translation id="7572537927358445944">Ανενεργή • Το Ultimatum δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης</translation>
<translation id="7583399374488819119">Πρόγραμμα εγκατάστασης <ph name="COMPANY_NAME" /></translation>
<translation id="7606334485649076285">UltimatumOS Flex</translation>
<translation id="7626032353295482388">Καλώς ήρθατε στο Ultimatum</translation>
<translation id="7626072681686626474">Το <ph name="MANAGER" /> απαιτεί να διαβάσετε και να αποδεχτείτε τους παρακάτω Όρους Παροχής Υπηρεσιών πριν από τη χρήση αυτής της συσκευής. Οι συγκεκριμένοι όροι δεν επεκτείνουν, τροποποιούν ή περιορίζουν τους Όρους του Ultimatum OS.</translation>
<translation id="7629695634924605473">Το Ultimatum σας ενημερώνει σε περίπτωση παραβίασης των κωδικών πρόσβασής σας.</translation>
<translation id="7641148173327520642">Ο διαχειριστής συστήματος έχει διαμορφώσει το Ultimatum έτσι ώστε να ανοίγει <ph name="ALTERNATIVE_BROWSER_NAME" /> για πρόσβαση σε <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7649070708921625228">Βοήθεια</translation>
<translation id="7651907282515937834">Λογότυπο Ultimatum Enterprise</translation>
<translation id="76531479118467370">Το Ultimatum απέκλεισε αυτή τη λήψη, επειδή απενεργοποιήσατε την Ασφαλή περιήγηση και δεν είναι δυνατή η επαλήθευση του αρχείου</translation>
<translation id="7655455401911432608">Το ιστορικό περιήγησής σας, δηλαδή ένα αρχείο των ιστοτόπων που έχετε επισκεφτεί χρησιμοποιώντας το Ultimatum σε αυτήν τη συσκευή.</translation>
<translation id="7655472416356262023">Κατάργηση λογαριασμού από το Ultimatum</translation>
<translation id="7658239707568436148">Ακύρωση</translation>
<translation id="7661924425853052955">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Ultimatum κατάργησε τις άδειες <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> και <ph name="COUNT" /> ακόμη</translation>
<translation id="7670287553302121848">Ο λογαριασμός Ultimatum απαιτεί εκ νέου έλεγχο ταυτότητας</translation>
<translation id="769538538642757151">Το Ultimatum θα σας ενημερώσει σε περίπτωση που χρειαστεί να ελέγξετε κάτι</translation>
<translation id="7716950018788545737">Οι εργασίες τερματίστηκαν.</translation>
<translation id="77283119132245232">Παρέχει υπηρεσίες ανίχνευσης συστήματος για το <ph name="BROWSER_NAME" />. Εάν αυτή η υπηρεσία είναι απενεργοποιημένη, τα ίχνη απόδοσης που δημιουργούνται από το πρόγραμμα περιήγησης δεν θα περιλαμβάνουν συμβάντα σε επίπεδο συστήματος, όπως συμβάντα εναλλαγής περιβάλλοντος και συμβάντα ετοιμότητας νήματος.</translation>
<translation id="7736869414036750079">Ο οργανισμός σας απαιτεί να συνδεθείτε στο Ultimatum</translation>
<translation id="7747138024166251722">Δεν ήταν δυνατή η δημιουργία ενός προσωρινού καταλόγου από το πρόγραμμα εγκατάστασης. Ελέγξτε τον κενό χώρο του δίσκου και το δικαίωμα εγκατάστασης του λογισμικού.</translation>
<translation id="7761834446675418963">Κάντε κλικ στο όνομά σας, για να ανοίξετε το Ultimatum και να ξεκινήσετε την περιήγηση.</translation>
<translation id="7777080907402804672">Εάν μια εικόνα δεν έχει κάποια χρήσιμη περιγραφή, το Ultimatum θα προσπαθήσει να σας προσφέρει μια περιγραφή. Για τη δημιουργία περιγραφών, αποστέλλονται εικόνες στην Google. Μπορείτε να απενεργοποιήσετε αυτήν τη λειτουργία στις ρυθμίσεις οποιαδήποτε στιγμή.</translation>
<translation id="778331955594035129">Το Ultimatum χρειάζεται άδεια τοποθεσίας για αυτόν τον ιστότοπο.</translation>
<translation id="7787950393032327779">Το προφίλ φαίνεται ότι χρησιμοποιείται από άλλη διεργασία του Ultimatum (<ph name="PROCESS_ID" />) σε άλλο υπολογιστή (<ph name="HOST_NAME" />). Το Ultimatum έχει κλειδώσει το προφίλ, για να μην καταστραφεί. Αν είστε σίγουροι ότι το προφίλ δεν χρησιμοποιείται από κάποια άλλη διεργασία, μπορείτε να το ξεκλειδώσετε και να επανεκκινήσετε το Ultimatum.</translation>
<translation id="7801699035218095297">Το Ultimatum προσπαθεί να αντιγράψει κωδικούς πρόσβασης. Για να επιτρέψετε αυτή την ενέργεια, πληκτρολογήστε τον κωδικό πρόσβασης των Windows.</translation>
<translation id="7808348361785373670">Κατάργηση από το Ultimatum…</translation>
<translation id="7825851276765848807">Η εγκατάσταση απέτυχε λόγω μη καθορισμένου σφάλματος. Κατεβάστε το Ultimatum ξανά.</translation>
<translation id="7827099906024714326">Το Ultimatum θα πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Google και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="7845233973568007926">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε τον υπολογιστή σας πριν από τη χρήση του <ph name="BUNDLE_NAME" />.</translation>
<translation id="7872446069773932638">Λήψη… Απομένουν <ph name="SECONDS" /> δευτερόλεπτα.</translation>
<translation id="7886087451482920026">Επιλογή κειμένου με το Google Lens</translation>
<translation id="7890208801193284374">Αν χρησιμοποιείτε έναν υπολογιστή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το Ultimatum ακριβώς όπως θέλουν.</translation>
<translation id="7896673875602241923">Κάποιο άτομο συνδέθηκε προηγουμένως στο Ultimatum σε αυτόν τον υπολογιστή ως <ph name="ACCOUNT_EMAIL_LAST" />. Δημιουργήστε έναν νέο χρήστη Ultimatum, για να διατηρείτε τις πληροφορίες σας ξεχωριστά.</translation>
<translation id="7917876797003313048">Μπορείτε να διαχειριστείτε τους συνδεδεμένους Λογαριασμούς σας Google. Οι Λογαριασμοί σας Google χρησιμοποιούνται για το πρόγραμμα περιήγησης Ultimatum, το Play Store, το Gmail κ.ά. Εάν θέλετε να προσθέσετε έναν λογαριασμό για κάποιο άλλο άτομο, όπως για ένα μέλος της οικογένειας, προσθέστε, αντ' αυτού, ένα νέο άτομο στη συσκευή σας <ph name="DEVICE_TYPE" />. <ph name="LINK_BEGIN" />Μάθετε περισσότερα<ph name="LINK_END" /></translation>
<translation id="7936702483636872823">Το Ultimatum απέκλεισε αυτή τη λήψη επειδή το αρχείο είναι παραπλανητικό και μπορεί να κάνει μη αναμενόμενες αλλαγές στη συσκευή σας</translation>
<translation id="7951272445806340501">Για να εφαρμοστεί η ενημέρωση, πρέπει να γίνει επανεκκίνηση του UltimatumOS Flex.</translation>
<translation id="7959172989483770734">Διαχείριση προφίλ Ultimatum</translation>
<translation id="7962410387636238736">Αυτός ο υπολογιστής δεν θα λαμβάνει πια ενημερώσεις Ultimatum, επειδή δεν υποστηρίζονται πλέον τα Windows XP και Windows Vista</translation>
<translation id="8004582292198964060">Πρόγραμμα περιήγησης</translation>
<translation id="8005666035647241369">Στον Διαχειριστή κωδικών πρόσβασης της Google σε αυτήν τη συσκευή</translation>
<translation id="8008534537613507642">Επανεγκατάσταση του Ultimatum</translation>
<translation id="8009904340233602924">Χρήση του Ultimatum χωρίς λογαριασμό</translation>
<translation id="8010081455002666927">Αυτόματος εντοπισμός</translation>
<translation id="8013993649590906847">Εάν μια εικόνα δεν έχει κάποια χρήσιμη περιγραφή, το Ultimatum θα προσπαθήσει να σας προσφέρει μια περιγραφή. Για τη δημιουργία περιγραφών, αποστέλλονται εικόνες στην Google.</translation>
<translation id="8019103195866286235">Η δημοσίευση αυτής της επέκτασης καταργήθηκε από τον προγραμματιστή της και ενδέχεται να μην είναι ασφαλής. Καταργήστε την από το Ultimatum, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="8040768861829554732">Μια επέκταση θέλει να συνδεθείτε στο Ultimatum</translation>
<translation id="80471789339884597">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε όλα τα προγράμματα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME" />.</translation>
<translation id="8064015041956107954">Μπορείτε να ανοίξετε σελιδοδείκτες, τη λειτουργία ανάγνωσης και πολλά άλλα από το μενού του Ultimatum επάνω δεξιά</translation>
<translation id="8064015586118426197">UltimatumOS Flex</translation>
<translation id="8077579734294125741">Άλλα προφίλ Ultimatum</translation>
<translation id="8086881907087796310">Η εγκατάσταση απέτυχε επειδή ο υπολογιστής σας δεν πληροί τις ελάχιστες απαιτήσεις εξοπλισμού.</translation>
<translation id="8113883687556086139">Επαληθεύστε την ταυτότητά σας, για να χρησιμοποιείτε και να αποθηκεύετε δεδομένα Ultimatum στον λογαριασμό σας, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="8118331347066725040">Αποστολή σχολίων για την αναζήτηση με το Lens</translation>
<translation id="8129812357326543296">Σχετικά με &amp;το Ultimatum</translation>
<translation id="813913629614996137">Εκκίνηση…</translation>
<translation id="8162006532256575008">Χρήση του Ultimatum χωρίς λογαριασμό</translation>
<translation id="8177472873527554730">Δεν είναι δυνατή η εύρεση περιεχομένου στη σελίδα</translation>
<translation id="8221491193165283816">Συνήθως αποκλείετε τις ειδοποιήσεις. Για να επιτρέψετε σε αυτόν τον ιστότοπο να σας στέλνει ειδοποιήσεις, κάντε κλικ εδώ.</translation>
<translation id="8255190535488645436">Το Ultimatum χρησιμοποιεί την κάμερα και το μικρόφωνό σας.</translation>
<translation id="8257796129973882597">Μπορείτε να ανοίξετε σελιδοδείκτες, τη λειτουργία ανάγνωσης και πολλά άλλα από το Μενού του Ultimatum</translation>
<translation id="8267953129876836456">Το Ultimatum εντόπισε ορισμένες προτάσεις ασφάλειας για να ελέγξετε</translation>
<translation id="8286862437124483331">Το Ultimatum προσπαθεί να εμφανίσει τους κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασής σας Windows για να το επιτρέψετε αυτό.</translation>
<translation id="829923460755755423">Προσθέστε μια συντόμευση στον Διαχειριστή κωδικών πρόσβασης Google</translation>
<translation id="8313851650939857356">Σφάλμα εκκίνησης: <ph name="STARTUP_ERROR" />.</translation>
<translation id="8321888067342493336">Αποθήκευση ως εικόνα</translation>
<translation id="8336463659890584292">Όταν ένας ιστότοπος ζητά την ιδιωτική προφόρτωση συνδέσμων στη σελίδα του, το Ultimatum χρησιμοποιεί τους διακομιστές της Google. Με αυτόν τον τρόπο, η ταυτότητά σας αποκρύπτεται από τον προφορτωμένο ιστότοπο, αλλά η Google μαθαίνει ποιοι ιστότοποι προφορτώνονται.</translation>
<translation id="8342675569599923794">Αυτό το αρχείο είναι επικίνδυνο και έχει αποκλειστεί από το Ultimatum.</translation>
<translation id="8362914115861174987">Μετάφραση στα</translation>
<translation id="8370517070665726704">Πνευματικά δικαιώματα <ph name="YEAR" /> Google LLC. Με την επιφύλαξη παντός δικαιώματος.</translation>
<translation id="8387459386171870978">Συνέχεια χρήσης του Ultimatum</translation>
<translation id="8394720698884623075">Ελέγχει εάν τα URL περιλαμβάνονται στην λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο Ultimatum</translation>
<translation id="8403038600646341038">Λογότυπο Ultimatum μέσα σε οθόνη υπολογιστή.</translation>
<translation id="8418845734693287262">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Ultimatum OS, επειδή τα στοιχεία σύνδεσης του λογαριασμού σας δεν είναι ενημερωμένα.</translation>
<translation id="842386925677997438">Εργαλεία ασφάλειας του Ultimatum</translation>
<translation id="8425765582779547329">Για να είσαι πιο ασφαλής στο διαδίκτυο με τις επιλογές του γονέα σου, συνδέσου στο Ultimatum</translation>
<translation id="8433638294851456451">Για να στείλετε από εδώ έναν αριθμό στο τηλέφωνό σας Android, συνδεθείτε στο Ultimatum και στις δύο συσκευές.</translation>
<translation id="8496177819998570653">Διαχειριστής κ&amp;ωδικών πρόσβασης Google</translation>
<translation id="8498858610309223613">Μόλις εφαρμόστηκε μια ειδική ενημέρωση ασφαλείας για το Ultimatum. Επανεκκινήστε τώρα και θα γίνει επαναφορά των καρτελών σας.</translation>
<translation id="8516431725144212809">Τα ενδιαφέροντά σας σύμφωνα με την εκτίμηση του Ultimatum</translation>
<translation id="8521348052903287641">Εισερχόμενος κανόνας για το Ultimatum Dev για να επιτρέπεται η κυκλοφορία του mDNS.</translation>
<translation id="852529348814672339">Προβολή του Ultimatum σε αυτή τη γλώσσα</translation>
<translation id="8533056045953418157">Ορισμός του Ultimatum ως προεπιλεγμένου προγράμματος προβολής PDF</translation>
<translation id="8555465886620020932">Σφάλμα υπηρεσίας: <ph name="SERVICE_ERROR" />.</translation>
<translation id="856656450041460113">Αναζήτηση λίστας γλωσσών</translation>
<translation id="8601359445272098721">Νέο! Μπορείτε να μεταφράσετε κείμενο και εικόνες που εμφανίζονται στην οθόνη σας, επιλέγοντας το κουμπί Μετάφραση οθόνης</translation>
<translation id="8614913330719544658">Το Ultimatum δεν αποκρίνεται. Επανεκκίνηση τώρα;</translation>
<translation id="861702415419836452">Το Ultimatum χρειάζεται άδεια πρόσβασης στην κάμερά σας, για να δημιουργήσει έναν τρισδιάστατο χάρτη του περιβάλλοντα χώρου σας.</translation>
<translation id="8625237574518804553">{0,plural, =1{Η επανεκκίνηση του Ultimatum θα γίνει σε 1 λεπτό}other{Η επανεκκίνηση του Ultimatum θα γίνει σε # λεπτά}}</translation>
<translation id="8637932705841171563">Για να μοιραστείτε το παράθυρό σας, επιτρέψτε την εγγραφή οθόνης για το Ultimatum στις Ρυθμίσεις συστήματος</translation>
<translation id="8641606876632989680">Το Ultimatum θα σας ειδοποιήσει όταν συνδεθείτε με έναν παραβιασμένο κωδικό πρόσβαση</translation>
<translation id="8649026945479135076">Είναι σύνηθες οι ιστότοποι που επισκέπτεστε να απομνημονεύουν τα ενδιαφέροντά σας για να εξατομικεύουν την εμπειρία σας. Οι ιστότοποι μπορούν να αποθηκεύουν επίσης πληροφορίες σχετικά με τα ενδιαφέροντά σας στο Ultimatum.</translation>
<translation id="8669527147644353129">Ultimatum Helper</translation>
<translation id="8679801911857917785">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του Ultimatum.</translation>
<translation id="8712767363896337380">Σχεδόν ενημερώθηκε! Επανεκκινήστε το Ultimatum για να ολοκληρώσετε την ενημέρωση.</translation>
<translation id="8718062187489036808">Αποσύνδεση από το Ultimatum</translation>
<translation id="873133009373065397">Το Ultimatum δεν μπορεί να καθορίσει ή να ορίσει το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="8747073452963259673">κάτω αριστερή γωνία της περιοχής αναζήτησης: αριστερά <ph name="LEFT" />%, κάτω <ph name="BOTTOM" />%</translation>
<translation id="8748735421235723888">Το Ultimatum αποδεσμεύει μνήμη από τις ανενεργές καρτέλες. Αυτό προσφέρει στις ενεργές καρτέλες και σε άλλες εφαρμογές περισσότερους πόρους υπολογιστή και διατηρεί το Ultimatum γρήγορο. Οι ανενεργές καρτέλες σας ενεργοποιούνται ξανά αυτόματα, όταν επιστρέψετε σε αυτές. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με την Εξοικονόμηση μνήμης<ph name="END_LINK" /></translation>
<translation id="8753189155654018347">Κατάργηση αυτών των δεδομένων εφαρμογών από το Ultimatum</translation>
<translation id="8765470054473112089">Όταν πληκτρολογείτε στη γραμμή διευθύνσεων ή στο πλαίσιο αναζήτησης, το Ultimatum στέλνει αυτό που πληκτρολογείτε στην προεπιλεγμένη μηχανή αναζήτησης για να λάβει καλύτερες προτάσεις. Αυτή η επιλογή είναι απενεργοποιημένη στην Ανώνυμη περιήγηση.</translation>
<translation id="8781673607513845160">Για χρήση της κάμερας, παραχωρήστε πρόσβαση στο Ultimatum στις <ph name="BEGIN_LINK" />ρυθμίσεις συστήματος<ph name="END_LINK" /></translation>
<translation id="878572486461146056">Σφάλμα εγκατάστασης: Ο διαχειριστής του δικτύου σας έχει εφαρμόσει μια πολιτική ομάδας που εμποδίζει την εγκατάσταση: <ph name="INSTALL_ERROR" /></translation>
<translation id="8798550110818026746">Ο οργανισμός σας μπορεί να βλέπει και να διαχειρίζεται τα δεδομένα περιήγησης, όπως σελιδοδείκτες, ιστορικό και κωδικούς πρόσβασης. Δεν μπορεί να βλέπει τα δεδομένα περιήγησης σε άλλα προφίλ στο Ultimatum</translation>
<translation id="8801657293260363985">Ο βελτιστοποιητής V8 είναι η μηχανή JavaScript και WebAssembly του Ultimatum που χρησιμοποιείται για τη βελτίωση της απόδοσης ιστοτόπων</translation>
<translation id="8821043148920470810">Για τη λήψη μελλοντικών ενημερώσεων του Ultimatum, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 7.</translation>
<translation id="8823341990149967727">Το Ultimatum δεν είναι ενημερωμένο</translation>
<translation id="8825634023950448068">Για την προστασία του απορρήτου σας, διαγράφουμε αυτόματα τα ενδιαφέροντα που είναι παλαιότερα των 4 εβδομάδων. Καθώς συνεχίζετε την περιήγηση, ενδέχεται να εμφανιστεί ξανά ένα ενδιαφέρον στη λίστα. Και εάν το Ultimatum κάνει κάποιο λάθος ή δεν θέλετε να βλέπετε συγκεκριμένες διαφημίσεις, μπορείτε να καταργήσετε ένα ενδιαφέρον.</translation>
<translation id="8834965163890861871">Το Ultimatum προσπαθεί να επεξεργαστεί κωδικούς πρόσβασης. Για να επιτρέψετε αυτή την ενέργεια, πληκτρολογήστε τον κωδικό πρόσβασης των Windows.</translation>
<translation id="8843516219908676469">Το Ultimatum κατανοεί καλύτερα τις φόρμες και μπορεί να τις συμπληρώνει αυτόματα πιο γρήγορα για εσάς</translation>
<translation id="8851180723659088381">{NUM_EXTENSIONS,plural, =1{Το Ultimatum συνιστά να την καταργήσετε}other{Το Ultimatum συνιστά να τις καταργήσετε}}</translation>
<translation id="8862326446509486874">Δεν έχετε τα απαραίτητα δικαιώματα για εγκατάσταση σε επίπεδο συστήματος. Δοκιμάστε να εκτελέσετε ξανά το πρόγραμμα εγκατάστασης ως Διαχειριστής.</translation>
<translation id="8914504000324227558">Επανεκκίνηση του Ultimatum</translation>
<translation id="8922193594870374009">Για να στείλετε έναν αριθμό από το <ph name="ORIGIN" /> στο τηλέφωνό σας Android, συνδεθείτε στο Ultimatum και στις δύο συσκευές.</translation>
<translation id="8948460679427074738">Αυτή η επέκταση δεν έχει δημοσιεύσει πρακτικές απορρήτου, όπως τον τρόπο συλλογής και χρήσης δεδομένων. Το Ultimatum συνιστά να την καταργήσετε.</translation>
<translation id="8989968390305463310">Το ιστορικό περιήγησής σας επηρεάζει τις διαφημίσεις που βλέπετε και τις εκτιμήσεις για τα ενδιαφέροντά σας παρακάτω. Για την προστασία του απορρήτου σας, το Ultimatum διαγράφει αυτόματα τα ενδιαφέροντά σας σε κυλιόμενη βάση κάθε μήνα. Τα ενδιαφέροντα μπορούν να ανανεώνονται, εκτός εάν τα καταργήσετε.</translation>
<translation id="8992769679401294069">Τα δεδομένα σας κρυπτογραφούνται με τη φράση πρόσβασης. Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Ultimatum στον Λογαριασμό σας Google.</translation>
<translation id="8999117580775242387">Όταν δεν είναι διαθέσιμο το HTTPS, το Ultimatum θα χρησιμοποιεί μια μη ασφαλή σύνδεση χωρίς να σας ειδοποιεί</translation>
<translation id="8999208279178790196">{0,plural, =0{Υπάρχει μια διαθέσιμη ενημέρωση του Ultimatum}=1{Υπάρχει μια διαθέσιμη ενημέρωση του Ultimatum}other{Υπάρχει μια διαθέσιμη ενημέρωση του Ultimatum για # ημέρες}}</translation>
<translation id="9014771989710951291">Πολλοί οργανισμοί διαχειρίζονται το Ultimatum</translation>
<translation id="9024318700713112071">Ορισμός του Ultimatum ως προεπιλογής</translation>
<translation id="9090566250983691233">Μάθετε γιατί το Ultimatum αποκλείει ορισμένα αρχεία</translation>
<translation id="9106236359747881194">Επιλογή κειμένου για αναζήτηση</translation>
<translation id="911206726377975832">Να γίνει διαγραφή και των δεδομένων περιήγησης;</translation>
<translation id="9134482777260927479">Βοήθεια για σχολικές εργασίες</translation>
<translation id="9138603949443464873">Για να εφαρμόσετε τις αλλαγές σας, επανεκκινήστε το Ultimatum</translation>
<translation id="9148058034647219655">Έξοδος</translation>
<translation id="9195993889682885387">Το Ultimatum μπορεί να κάνει εκτιμήσεις για τα ενδιαφέροντά σας με βάση το ιστορικό περιήγησής σας τις τελευταίες εβδομάδες. Αυτές οι πληροφορίες παραμένουν στη συσκευή σας.</translation>
<translation id="919706545465235479">Για να ξεκινήσει ο συγχρονισμός, ενημερώστε το Ultimatum</translation>
<translation id="922152298093051471">Προσαρμογή του Ultimatum</translation>
<translation id="93760716455950538">Επανεκκίνηση του UltimatumOS Flex</translation>
<translation id="943390475793766444">Το Ultimatum συνιστά τη σάρωση αυτού του αρχείου επειδή μπορεί να είναι επικίνδυνο.</translation>
<translation id="945522503751344254">Αποστολή σχολίων</translation>
<translation id="983803489796659991">Η εγκατάσταση απέτυχε επειδή ο διακομιστής ενημέρωσης δεν διαθέτει δεδομένα κατακερματισμού για την εφαρμογή.</translation>
<translation id="989369509083708165">Το Ultimatum είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="989816563149873169">Με τη συντόμευση <ph name="SHORTCUT" /> μπορείτε να κάνετε εναλλαγή μεταξύ των προφίλ Ultimatum</translation>
</translationbundle>