<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="th">
<translation id="1026101648481255140">ดำเนินการติดตั้งต่อ</translation>
<translation id="1029669172902658969">เปิดอีกครั้งเพื่ออัปเดต &amp;Ultimatum OS</translation>
<translation id="1040916596585577953">Ultimatum ขอแนะนำให้คุณตรวจสอบส่วนขยายนี้</translation>
<translation id="1042552502243217427">เมื่อเว็บไซต์ขอโหลดลิงก์ในหน้าเว็บของตนล่วงหน้าแบบส่วนตัว Ultimatum จะใช้เซิร์ฟเวอร์ของ Google การดำเนินการนี้จะซ่อนตัวตนของคุณจากเว็บไซต์ที่โหลดล่วงหน้า แต่ Google จะทราบถึงเว็บไซต์ที่ได้รับการโหลดล่วงหน้า</translation>
<translation id="1065672644894730302">ค่ากำหนดของคุณไม่สามารถอ่านได้ ฟีเจอร์บางอย่างอาจใช้ไม่ได้และการเปลี่ยนแปลงค่ากำหนดจะไม่ได้รับการบันทึก</translation>
<translation id="1083934481477628225">ผู้ปกครองได้ปิด "สิทธิ์สำหรับเว็บไซต์ แอป และส่วนขยาย" ใน Ultimatum</translation>
<translation id="1104942323762546749">Ultimatum ต้องการส่งออกรหัสผ่านของคุณ พิมพ์รหัสผ่าน Windows เพื่ออนุญาตให้ดำเนินการ</translation>
<translation id="112640046208448578">ระบุสิ่งหรือสถานที่ต่างๆ แล้วคัดลอกหรือแปลข้อความ เมื่อใช้การค้นหารูปภาพ ระบบจะส่งภาพหน้าจอของหน้าเว็บไปยังเซิร์ฟเวอร์ <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Ultimatum เป็นเบราว์เซอร์เริ่มต้นของคุณ</translation>
<translation id="1131805035311359397"><ph name="BEGIN_LINK" />ลงชื่อเข้าใช้ Ultimatum<ph name="END_LINK" /> เพื่อตรวจสอบว่ารหัสผ่านของคุณไม่ได้รับผลกระทบจากการละเมิดข้อมูลและปัญหาด้านความปลอดภัยอื่นๆ</translation>
<translation id="1153368717515616349">คลิกเมนู Ultimatum</translation>
<translation id="1157985233335035034">ภาษาล่าสุด</translation>
<translation id="1184145431117212167">ติดตั้งไม่สำเร็จเนื่องจากระบบไม่รองรับ Windows เวอร์ชันที่คุณใช้</translation>
<translation id="1185134272377778587">เกี่ยวกับ Ultimatum</translation>
<translation id="1203500561924088507">ขอขอบคุณที่ติดตั้ง คุณต้องรีสตาร์ทเบราว์เซอร์ก่อนใช้ <ph name="BUNDLE_NAME" /></translation>
<translation id="1262876892872089030">ขณะที่แท็บนี้ไม่มีการใช้งาน ระบบจะเพิ่มพื้นที่ว่างในหน่วยความจำเพื่อให้ใช้ Ultimatum ได้อย่างรวดเร็วอยู่เสมอ ทั้งนี้คุณจะเลือกยกเว้นให้เว็บไซต์นี้ทำงานตลอดเวลาได้</translation>
<translation id="1265577313130862557">Ultimatum บล็อกการดาวน์โหลดนี้เนื่องจากไฟล์เป็นอันตราย</translation>
<translation id="126567311906253476">เมื่อลงชื่อเข้าใช้บริการของ Google อย่าง Gmail หรือ YouTube ด้วย <ph name="USER_EMAIL" /> คุณจะลงชื่อเข้าใช้ Ultimatum ด้วยบัญชีเดียวกันได้โดยอัตโนมัติ</translation>
<translation id="1290883685122687410">ข้อผิดพลาดในการตั้งค่า: <ph name="METAINSTALLER_EXIT_CODE" /> <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">ตั้งค่าโปรไฟล์ Ultimatum ใหม่</translation>
<translation id="1324107359134968521">Ultimatum ต้องการสิทธิ์เข้าถึงบลูทูธเพื่อสำรวจอุปกรณ์บลูทูธ <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1330562121671411446">ตรวจหาภาษา</translation>
<translation id="1342274909142618978">ลบข้อมูลออกจาก Ultimatum (<ph name="URL" />) ด้วย</translation>
<translation id="1345251407431278948">ปักหมุดแล้ว คุณเข้าถึงการค้นหารูปภาพได้อีกครั้งจากปุ่มใหม่ในแถบเครื่องมือ</translation>
<translation id="1356661055722410047">ใหม่! คุณแปลได้ทั้งข้อความและรูปภาพบนหน้าจอ</translation>
<translation id="1383876407941801731">ค้นหา</translation>
<translation id="1414495520565016063">คุณลงชื่อเข้าใช้ Ultimatum แล้ว!</translation>
<translation id="141901961143729572">แชร์ความคิดเห็นของคุณ</translation>
<translation id="1465192221147974788">หากต้องการแชร์หน้าต่าง ให้อนุญาตการบันทึกหน้าจอสำหรับ Ultimatum ใน "การตั้งค่าระบบ"</translation>
<translation id="1478370723027452770">รับความช่วยเหลือเกี่ยวกับ Ultimatum สำหรับการทดสอบ</translation>
<translation id="1497802159252041924">ข้อผิดพลาดในการติดตั้ง: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">หน้านี้ได้รับการป้องกัน</translation>
<translation id="1524282610922162960">แชร์แท็บ Ultimatum</translation>
<translation id="1547469039832541117">สิ้นสุดงานที่ไฮไลต์ไว้</translation>
<translation id="1553461853655228091">Ultimatum ต้องการสิทธิ์เข้าถึงกล้องเพื่อสร้างแผนที่ 3 มิติของสิ่งที่อยู่รอบตัวคุณ</translation>
<translation id="1555494096857516577">{NUM_EXTENSIONS,plural, =1{ระบบไม่รองรับส่วนขยายนี้อีกต่อไป Ultimatum ขอแนะนำให้คุณนำออก}other{ระบบไม่รองรับส่วนขยายเหล่านี้อีกต่อไป Ultimatum ขอแนะนำให้คุณนำออก}}</translation>
<translation id="1574377791422810894">เครื่องมือด้านความปลอดภัยของ Ultimatum</translation>
<translation id="1594928384848033697">Ultimatum ต้องการลบข้อมูลในเครื่องมือจัดการรหัสผ่าน โปรดพิมพ์รหัสผ่าน Windows ของคุณเพื่ออนุญาต</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{ผู้ดูแลระบบต้องการให้คุณเปิด Ultimatum ขึ้นมาใหม่เพื่อใช้การอัปเดต}=1{ผู้ดูแลระบบต้องการให้คุณเปิด Ultimatum ขึ้นมาใหม่เพื่อใช้การอัปเดต หน้าต่างที่ไม่ระบุตัวตนจะไม่เปิดให้อีก}other{ผู้ดูแลระบบต้องการให้คุณเปิด Ultimatum ขึ้นมาใหม่เพื่อใช้การอัปเดต หน้าต่างที่ไม่ระบุตัวตนจำนวน # หน้าต่างจะไม่เปิดให้อีก}}</translation>
<translation id="1625909126243026060">ตรวจสอบการควบคุมที่สำคัญด้านความเป็นส่วนตัวและความปลอดภัยใน Ultimatum</translation>
<translation id="1640672724030957280">กำลังดาวน์โหลด...</translation>
<translation id="1709772298389099340">ให้สิทธิ์ในระดับสูงขึ้นกับ <ph name="BROWSER_NAME" /></translation>
<translation id="1715127912119967311">Ultimatum จะส่งข้อมูลการโต้ตอบของคุณให้กับ Google เพื่อช่วยปรับปรุงฟีเจอร์เหล่านี้ เจ้าหน้าที่ตรวจสอบอาจอ่าน ประมวลผล และใส่คำอธิบายประกอบข้อมูลดังกล่าว</translation>
<translation id="1722488837206509557">สิทธิ์นี้จะช่วยให้คุณสามารถเลือกจากอุปกรณ์ที่พร้อมใช้งานและแสดงเนื้อหาบนอุปกรณ์เหล่านั้น</translation>
<translation id="1733725117201708356">Ultimatum จะลบข้อมูลการท่องเว็บเร็วๆ นี้</translation>
<translation id="1736443181683099871">Ultimatum จะพยายามอัปเกรดการนำทางให้เป็นแบบ HTTPS</translation>
<translation id="1736662517232558588">ล้างข้อมูล Ultimatum แล้ว</translation>
<translation id="1745121272106313518">Ultimatum จะรีสตาร์ทใน <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">เมื่อ HTTPS ไม่พร้อมใช้งาน Ultimatum จะใช้การเชื่อมต่อที่ไม่ปลอดภัยโดยไม่แจ้งเตือนคุณ</translation>
<translation id="1774152462503052664">ให้ Ultimatum ทำงานในพื้นหลัง</translation>
<translation id="1779356040007214683">เพื่อให้ Ultimatum ปลอดภัยขึ้น เราได้ปิดส่วนขยายบางรายการที่ไม่ได้ระบุไว้ใน <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> และอาจถูกเพิ่มเข้ามาโดยที่คุณไม่รู้ตัว</translation>
<translation id="1808667845054772817">ติดตั้ง Ultimatum ใหม่</translation>
<translation id="1820835682567584003">Ultimatum กำลังพยายาม<ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="1838374766361614909">ล้างการค้นหา</translation>
<translation id="18552579716432081">หากต้องการลบข้อมูลการท่องเว็บออกจากอุปกรณ์นี้เท่านั้น แต่ยังเก็บข้อมูลดังกล่าวไว้ในบัญชี Google ให้<ph name="BEGIN_LINK" />ออกจากระบบ Ultimatum<ph name="END_LINK" /></translation>
<translation id="185970820835152459">คุณจัดการบัญชี Google ที่ลงชื่อเข้าใช้ได้ บัญชี Google ใช้สำหรับเบราว์เซอร์ Ultimatum, Play Store, Gmail และอื่นๆ หากต้องการเพิ่มบัญชีให้คนอื่น เช่น สมาชิกในครอบครัว ให้เพิ่มบุคคลใหม่ลงใน <ph name="DEVICE_TYPE" /> แทน <ph name="LINK_BEGIN" />ดูข้อมูลเพิ่มเติม<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">ค้นหาด้วยการค้นหารูปภาพ</translation>
<translation id="1863308913976887472">เว็บไซต์สามารถจัดเก็บข้อมูลเกี่ยวกับความสนใจไว้กับ Ultimatum ตัวอย่างเช่น หากคุณเข้าชมเว็บไซต์เพื่อซื้อรองเท้าวิ่งมาราธอน เว็บไซต์นี้อาจระบุว่าคุณสนใจการวิ่งมาราธอน ภายหลัง เมื่อคุณเข้าชมเว็บไซต์อื่นเพื่อลงทะเบียนแข่งมาราธอน เว็บไซต์นี้ก็อาจแสดงโฆษณารองเท้าวิ่งโดยอิงจากความสนใจดังกล่าว</translation>
<translation id="1880677175115548835">เลือกข้อความ</translation>
<translation id="1881322772814446296">คุณกำลังลงชื่อเข้าใช้ด้วยบัญชีที่จัดการ และให้การควบคุมระดับผู้ดูแลระบบของบัญชีดังกล่าวเหนือโปรไฟล์ Ultimatum ของคุณ ข้อมูล Ultimatum เช่น แอป บุ๊กมาร์ก ประวัติการเข้าชม รหัสผ่าน และการตั้งค่าอื่นๆ จะเชื่อมโยงอย่างถาวรกับ <ph name="USER_NAME" /> คุณจะสามารถลบข้อมูลนี้ผ่านทางแผงควบคุมบัญชี Google แต่คุณจะไม่สามารถเชื่อมโยงข้อมูลนี้กับบัญชีอื่น คุณสามารถเลือกที่จะสร้างโปรไฟล์ใหม่เพื่อแยกเก็บข้อมูล Ultimatum ที่มีอยู่ของคุณ <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Ultimatum จะช่วยสงวนพลังงานแบตเตอรี่โดยการจำกัดกิจกรรมในเบื้องหลังและเอฟเฟกต์ภาพ เช่น การเลื่อนอย่างราบรื่นและอัตราเฟรมวิดีโอ <ph name="BEGIN_LINK" />ดูข้อมูลเพิ่มเติมเกี่ยวกับโหมดประหยัดพลังงาน<ph name="END_LINK" /></translation>
<translation id="1900969832270057921">บริการ Ultimatum Updater</translation>
<translation id="1911763535808217981">เมื่อปิดการตั้งค่านี้ คุณจะลงชื่อเข้าใช้เว็บไซต์ของ Google อย่างเช่น Gmail ได้โดยไม่ต้องลงชื่อเข้าใช้ Ultimatum</translation>
<translation id="1916451563296275579">นำข้อมูลแอปนี้ออกจาก Ultimatum</translation>
<translation id="1929939181775079593">Ultimatum ไม่ตอบสนอง เปิดใหม่เลยหรือไม่</translation>
<translation id="1933341829955786215">องค์กร <ph name="MANAGER" /> กำหนดให้คุณต้องลงชื่อเข้าใช้ Ultimatum</translation>
<translation id="193439633299369377">ต้องรีสตาร์ท Ultimatum OS เพื่อใช้การอัปเดต</translation>
<translation id="1951406923938785464">Ultimatum บล็อกการดาวน์โหลดนี้เนื่องจากไฟล์ประเภทนี้ไม่ได้มีการดาวน์โหลดกันโดยทั่วไปและอาจเป็นอันตราย</translation>
<translation id="1953553007165777902">กำลังดาวน์โหลด... เหลืออีก <ph name="MINUTE" /> นาที</translation>
<translation id="1966382378801805537">Ultimatum ไม่สามารถกำหนดหรือตั้งค่าเบราว์เซอร์เริ่มต้น</translation>
<translation id="1990262977744080398">ดูสาเหตุที่ Ultimatum บล็อกบางไฟล์ เปิดในแท็บใหม่</translation>
<translation id="1999715455684970349">โปรดอัปเดตซอฟต์แวร์ Ultimatum ให้เป็นเวอร์ชันล่าสุดอยู่เสมอ หากปิดใช้หรือหยุดบริการนี้ ซอฟต์แวร์ Ultimatum ของคุณจะไม่ได้รับการอัปเดต ซึ่งหมายความว่าช่องโหว่ด้านความปลอดภัยที่อาจเกิดขึ้นจะไม่สามารถแก้ไขได้และฟีเจอร์อาจไม่ทำงาน บริการนี้จะถอนการติดตั้งตัวเองเมื่อไม่มีซอฟต์แวร์ Ultimatum ใช้งานอยู่</translation>
<translation id="2008474315282236005">การดำเนินการนี้จะลบ 1 รายการออกจากอุปกรณ์นี้ หากต้องการดึงข้อมูลภายหลัง ให้ลงชื่อเข้าใช้ Ultimatum ด้วย <ph name="USER_EMAIL" /></translation>
<translation id="2018879682492276940">การติดตั้งไม่สำเร็จ โปรดลองอีกครั้ง</translation>
<translation id="2020032459870799438"><ph name="BEGIN_LINK" />ลงชื่อเข้าใช้ Ultimatum<ph name="END_LINK" /> เพื่อตรวจสอบว่ารหัสผ่านรายการอื่นไม่ได้รับผลกระทบจากการละเมิดข้อมูลและปัญหาด้านความปลอดภัยอื่นๆ</translation>
<translation id="2049376729098081731">เลือกว่าจะรวมประวัติการเข้าชม Ultimatum เพื่อรับประสบการณ์ที่ปรับเปลี่ยนในแบบของคุณมากขึ้นในบริการของ Google หรือไม่</translation>
<translation id="2054039611381840095">คุณจะต้องใช้ macOS 12 ขึ้นไปเพื่อรับการอัปเดต Ultimatum ในอนาคต คอมพิวเตอร์เครื่องนี้ใช้ macOS 11</translation>
<translation id="2086476982681781442">Ultimatum บล็อกการดาวน์โหลดนี้เนื่องจากไฟล์มีการหลอกลวงและอาจทำการเปลี่ยนแปลงที่ไม่คาดคิดกับอุปกรณ์</translation>
<translation id="2099452623287920103">ระบบจะนำรหัสผ่านและข้อมูลอื่นๆ ของ Ultimatum ที่คุณบันทึกไว้ในบัญชี Google ออกจากอุปกรณ์นี้ หากต้องการใช้ข้อมูลเหล่านี้ใน Ultimatum ให้ลงชื่อเข้าใช้อีกครั้ง</translation>
<translation id="2120965832000301375">{COUNT,plural, =1{องค์กรจะลบข้อมูลการท่องเว็บโดยอัตโนมัติเมื่อไม่มีการใช้ Ultimatum เป็นเวลา 1 นาที ซึ่งอาจรวมถึงประวัติการเข้าชม การป้อนข้อความอัตโนมัติ และการดาวน์โหลด ทั้งนี้ แท็บจะยังคงเปิดอยู่}other{องค์กรจะลบข้อมูลการท่องเว็บโดยอัตโนมัติเมื่อไม่มีการใช้ Ultimatum เป็นเวลา # นาที ซึ่งอาจรวมถึงประวัติการเข้าชม การป้อนข้อความอัตโนมัติ และการดาวน์โหลด ทั้งนี้ แท็บจะยังคงเปิดอยู่}}</translation>
<translation id="2126108037660393668">ไฟล์ที่ดาวน์โหลดไม่ผ่านการยืนยัน</translation>
<translation id="2137162749895930932">ปิดหน้าจอแปลภาษา</translation>
<translation id="215352261310130060">Ultimatum บล็อกการดาวน์โหลดนี้เนื่องจากเว็บไซต์ไม่ได้ใช้การเชื่อมต่อที่ปลอดภัยและไฟล์อาจมีการดัดแปลง</translation>
<translation id="2157600032285353789">คุณสามารถเปิดบุ๊กมาร์ก โหมดการอ่าน และอื่นๆ จากเมนู Ultimatum ได้</translation>
