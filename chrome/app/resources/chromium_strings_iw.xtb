<translation id="7585391435984513350">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאה '<ph name="PERMISSION" />' הוסרה על ידי Ultimatum</translation>
<translation id="761356813943268536">‏Ultimatum משתמש במצלמה ובמיקרופון שלך.</translation>
<translation id="7617377681829253106">‏Ultimatum השתפר</translation>
<translation id="7649070708921625228">עזרה</translation>
<translation id="7658239707568436148">ביטול</translation>
