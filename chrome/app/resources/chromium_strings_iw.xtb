<translation id="6173308241973263798">‏צריך למחוק את נתוני Ultimatum בחשבון</translation>
<translation id="6174920971222007286">‏הקובץ הזה עלול להיות מסוכן<ph name="LINE_BREAK" />דפדפן Ultimatum יכול לבדוק את ההורדה הזו אם מזינים את הסיסמה. מידע על הקובץ נשלח אל התכונה 'גלישה בטוחה של Google', אבל הסיסמה והתוכן של הקובץ נשארים במכשיר.</translation>
<translation id="6182736845697986886">ההתקנה נכשלה עקב שגיאה פנימית בשרת העדכון.</translation>
<translation id="6183079672144801177">‏יש לוודא שנכנסת ל-Ultimatum ב-<ph name="TARGET_DEVICE_NAME" /> שלך ולשלוח שוב.</translation>
<translation id="6212496753309875659">‏במחשב זה קיימת כבר גרסה מתקדמת יותר של Ultimatum. אם התוכנה אינה פועלת, יש להסיר את ההתקנה של Ultimatum ולנסות שוב.</translation>
<translation id="6219195342503754812">{0,plural, =0{‏Ultimatum יופעל מחדש עכשיו}=1{‏Ultimatum יופעל מחדש בעוד שנייה אחת}one{‏Ultimatum יופעל מחדש בעוד # שניות}two{‏Ultimatum יופעל מחדש בעוד # שניות}other{‏Ultimatum יופעל מחדש בעוד # שניות}}</translation>
<translation id="6241367896540709610">‏נדרשת הרשאת גישה לאחסון ב-Ultimatum כדי להוריד קבצים</translation>
