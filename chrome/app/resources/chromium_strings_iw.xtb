<!DOCTYPE translationbundle>
<translationbundle lang="iw">
<translation id="1026101648481255140">המשך בהתקנה</translation>
<translation id="1029669172902658969">‏הפעלה מחדש לצורך עדכון ‎&amp;UltimatumOS</translation>
<translation id="1040916596585577953">‏לפי המלצת Ultimatum, כדאי לבדוק את התוסף הזה</translation>
<translation id="1042552502243217427">‏כשאתר מבקש לטעון מראש קישורים בדף שלו באופן פרטי, מערכת Ultimatum משתמשת בשרתי Google. כך מוסתרת הזהות שלך מהאתר שנטען מראש, אבל Google יכולה לדעת אילו אתרים נטענים מראש.</translation>
<translation id="1065672644894730302">לא הייתה אפשרות לקרוא את ההעדפות שלך. ייתכן שחלק מהתכונות לא יהיו זמינות ושינויים בהעדפות לא יישמרו.</translation>
<translation id="1083934481477628225">‏ההורה שלך השבית ב-Ultimatum את ההגדרה 'הרשאות לאתרים, לאפליקציות ולתוספים'</translation>
<translation id="1104942323762546749">‏Ultimatum רוצה לייצא את הסיסמאות שלך. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
<translation id="112640046208448578">אפשר לנסות לזהות דברים או מקומות ולהעתיק או לתרגם טקסטים. כשמשתמשים בחיפוש תמונות, צילום מסך של הדף נשלח לשרת. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">‏Ultimatum מוגדר כדפדפן ברירת המחדל</translation>
<translation id="1131805035311359397">‏כדי לבדוק אם שאר הסיסמאות מוגנות מפני פרצות באבטחת מידע ובעיות אבטחה אחרות, <ph name="BEGIN_LINK" />יש להיכנס ל-Ultimatum<ph name="END_LINK" />.</translation>
<translation id="1153368717515616349">‏לוחצים על תפריט Ultimatum</translation>
<translation id="1157985233335035034">שפות אחרונות</translation>
<translation id="1184145431117212167">‏ההתקנה נכשלה כי הגרסה של Windows לא נתמכת.</translation>
<translation id="1185134272377778587">‏על Ultimatum</translation>
<translation id="1203500561924088507">תודה שהתקנת. עליך להפעיל מחדש את הדפדפן לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="1262876892872089030">‏בזמן שהכרטיסייה הזו לא הייתה פעילה, התפנה זיכרון כדי ש-Ultimatum ימשיך לפעול במהירות. ניתן לבחור להחריג תמיד את האתר הזה כדי שיישאר במצב פעיל.</translation>
<translation id="1265577313130862557">‏Ultimatum חסם את ההורדה הזאת כי הקובץ מסוכן</translation>
<translation id="126567311906253476">‏כשנכנסים לשירותי Google כמו Gmail או YouTube עם <ph name="USER_EMAIL" />, אפשר להיכנס אוטומטית ל-Ultimatum עם אותו חשבון</translation>
<translation id="1290883685122687410">שגיאה בהגדרה: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">‏הגדרת הפרופיל החדש שלך ב-Ultimatum</translation>
<translation id="1324107359134968521">‏ל-Ultimatum נדרשת גישה ל-Bluetooth כדי למצוא 
 מכשירי Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1330562121671411446">זיהוי שפה אוטומטי</translation>
<translation id="1342274909142618978">‏אני רוצה למחוק את הנתונים גם מ-Ultimatum (<ph name="URL" />)</translation>
<translation id="1345251407431278948">התכונה הוצמדה. מעכשיו אפשר לגשת לחיפוש התמונות דרך הכפתור החדש בסרגל הכלים</translation>
<translation id="1356661055722410047">חדש! אפשר לתרגם טקסט ותמונות במסך</translation>
<translation id="1383876407941801731">חיפוש</translation>
<translation id="1414495520565016063">‏נכנסת ל-Ultimatum!</translation>
<translation id="141901961143729572">כאן אפשר לשתף את המחשבות שלך</translation>
<translation id="1465192221147974788">‏כדי לשתף את החלון, צריך לאפשר הקלטת מסך ב-Ultimatum בקטע "הגדרות המערכת".</translation>
<translation id="1478370723027452770">‏קבלת עזרה לגבי Ultimatum for Testing</translation>
<translation id="1497802159252041924">שגיאת התקנה: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">הדף הזה מוגן</translation>
<translation id="1524282610922162960">‏שיתוף כרטיסיית Ultimatum</translation>
<translation id="1547469039832541117">סיום המשימה המודגשת.</translation>
<translation id="1553461853655228091">‏Ultimatum זקוק להרשאת גישה למצלמה כדי ליצור מפה תלת-ממדית של הסביבה שלך</translation>
<translation id="1555494096857516577">{NUM_EXTENSIONS,plural, =1{‏התוסף הזה כבר לא נתמך. אנחנו ממליצים להסיר אותו מ-Ultimatum.}one{‏התוספים האלה כבר לא נתמכים. אנחנו ממליצים להסיר אותם מ-Ultimatum.}two{‏התוספים האלה כבר לא נתמכים. אנחנו ממליצים להסיר אותם מ-Ultimatum.}other{‏התוספים האלה כבר לא נתמכים. אנחנו ממליצים להסיר אותם מ-Ultimatum.}}</translation>
<translation id="1574377791422810894">‏הכלים לבטיחות של Ultimatum</translation>
<translation id="1594928384848033697">‏‫Ultimatum רוצה למחוק את הנתונים שלך במנהל הסיסמאות. כדי לאפשר זאת, צריך להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{‏מנהל המערכת מבקש להפעיל מחדש את Ultimatum כדי להחיל עדכון}=1{‏מנהל המערכת מבקש להפעיל מחדש את Ultimatum כדי להחיל עדכון. החלון האנונימי לא ייפתח מחדש.}one{‏מנהל המערכת מבקש להפעיל מחדש את Ultimatum כדי להחיל עדכון. # החלונות האנונימיים לא ייפתחו מחדש.}two{‏מנהל המערכת מבקש להפעיל מחדש את Ultimatum כדי להחיל עדכון. # החלונות האנונימיים לא ייפתחו מחדש.}other{‏מנהל המערכת מבקש להפעיל מחדש את Ultimatum כדי להחיל עדכון. # החלונות האנונימיים לא ייפתחו מחדש.}}</translation>
<translation id="1625909126243026060">‏בדיקה של אמצעי הבקרה החשובים ביותר על פרטיות ואבטחה ב-Ultimatum</translation>
<translation id="1640672724030957280">מוריד...</translation>
<translation id="1709772298389099340">השירות הזה מספק הרשאות מורחבות ל-<ph name="BROWSER_NAME" />.</translation>
<translation id="1715127912119967311">‏כדי לשפר את התכונות האלו, Ultimatum שולח את האינטראקציות שלך איתן ל-Google. בודקים אנושיים יכולים לקרוא את הנתונים האלה, לעבד אותם ולהוסיף להם הערות.</translation>
<translation id="1722488837206509557">כך תהיה לך אפשרות לבחור מבין המכשירים הזמינים ולהציג בהם תוכן.</translation>
<translation id="1733725117201708356">‏נתוני הגלישה ב-Ultimatum יימחקו בקרוב</translation>
<translation id="1736443181683099871">‏Ultimatum ינסה לשדרג את הניווטים ל-HTTPS</translation>
<translation id="1736662517232558588">‏נתוני Ultimatum נמחקו</translation>
<translation id="1745121272106313518">‏Ultimatum יופעל מחדש בעוד <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">‏כש-HTTPS לא יהיה זמין, Ultimatum ישתמש בחיבור לא מאובטח בלי להציג אזהרה</translation>
<translation id="1774152462503052664">‏התרה ל-Ultimatum לפעול ברקע</translation>
<translation id="1779356040007214683">‏כדי לשפר את האבטחה של Ultimatum, השבתנו חלק מהתוספים שלא רשומים ב<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> וייתכן שנוספו ללא ידיעתך.</translation>
<translation id="1808667845054772817">‏התקנת Ultimatum מחדש</translation>
<translation id="1820835682567584003">‏Ultimatum מנסה <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="1838374766361614909">ניקוי חיפוש</translation>
<translation id="18552579716432081">‏כדי למחוק את נתוני הגלישה מהמכשיר הזה בלבד ועדיין לשמור אותם בחשבון שלך ב-Google, <ph name="BEGIN_LINK" />עליך לצאת מהחשבון ב-Ultimatum<ph name="END_LINK" />.</translation>
<translation id="185970820835152459">‏יש לך אפשרות לנהל את חשבונות Google שאליהם נכנסת. כדי ליהנות מחיבור לחשבון בדפדפן Ultimatum, בחנות Play, ב-‏Gmail ובשירותים נוספים, עליך להיכנס עם חשבונות Google שלך. כדי להוסיף חשבון של מישהו אחר, כמו חבר/ה בקבוצה המשפחתית, יש להוסיף משתמש חדש ל-<ph name="DEVICE_TYPE" />. <ph name="LINK_BEGIN" />מידע נוסף<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">חיפוש באמצעות התכונה 'חיפוש תמונות'</translation>
<translation id="1863308913976887472">‏אתרים יכולים לשמור מידע ב-Ultimatum לגבי תחומי העניין שלך. לדוגמה, אם ביקרת באתר כדי לקנות נעליים למרתון, האתר עשוי להגדיר 'ריצת מרתון' כתחום עניין שלך. לאחר מכן, בביקור באתר שונה, למשל כדי להירשם למרוץ, יכול להיות שתוצג לך מודעה לנעלי ריצה על סמך תחומי העניין שלך.</translation>
<translation id="1880677175115548835">בחירת טקסט</translation>
<translation id="1881322772814446296">‏נכנסת עם חשבון מנוהל שנותן למנהל המערכת שלו שליטה על הפרופיל שלך ב-Ultimatum. הנתונים שלך ב-Ultimatum, כגון אפליקציות, סימניות, היסטוריה, סיסמאות והגדרות אחרות ייקשרו באופן קבוע ל-<ph name="USER_NAME" />. ניתן למחוק את הנתונים האלה באמצעות לוח הבקרה של חשבונות Google, אבל אי אפשר לשייך את הנתונים האלה לחשבון אחר. לחלופין, באפשרותך ליצור פרופיל חדש כדי לשמור את הנתונים הקיימים שלך ב-Ultimatum בנפרד.<ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">‏‫Ultimatum חוסך בחיי הסוללה על ידי הגבלת הפעילות ברקע והאפקטים החזותיים, כמו גלילה חלקה וקצב פריימים של סרטונים. <ph name="BEGIN_LINK" />מידע נוסף על מצב חיסכון באנרגיה<ph name="END_LINK" /></translation>
<translation id="1900969832270057921">‏שירות לעדכון של Ultimatum</translation>
<translation id="1911763535808217981">‏כיבוי הגדרה זו יאפשר לך להיכנס לאתרי Google, כמו Gmail, בלי להיכנס אל Ultimatum</translation>
<translation id="1916451563296275579">‏הסרת הנתונים של האפליקציות האלה מ-Ultimatum</translation>
<translation id="1929939181775079593">‏Ultimatum אינו מגיב. להפעיל מחדש עכשיו?</translation>
<translation id="1933341829955786215">‏לפי דרישת הארגון שלך, <ph name="MANAGER" />, עליך להיכנס לחשבון ב-Ultimatum</translation>
<translation id="193439633299369377">‏צריך להפעיל מחדש את UltimatumOS כדי להחיל את העדכון הזה.</translation>
<translation id="1951406923938785464">‏Ultimatum חסם את ההורדה הזאת כי לרוב לא מתבצעת הורדה של קבצים מהסוג הזה ויכול להיות שהקובץ מסוכן</translation>
<translation id="1953553007165777902">מתבצעת הורדה… יש עוד <ph name="MINUTE" /> דק'</translation>
<translation id="1966382378801805537">‏ב-Ultimatum לא ניתן לקבוע או להגדיר את דפדפן ברירת המחדל</translation>
<translation id="1990262977744080398">‏מידע על חסימה של קבצים מסוימים ב-Ultimatum, נפתח בכרטיסייה חדשה</translation>
<translation id="1999715455684970349">‏השירות הזה שומר על תוכנת Ultimatum עדכנית. אם השירות הזה מושבת או מופסק, תוכנת Ultimatum לא תתעדכן באופן קבוע. כתוצאה מכך, לא ניתן יהיה לתקן פרצות אבטחה שעלולות להיווצר, וייתכן שחלק מהתכונות לא יפעלו. השירות הזה יוסר באופן אוטומטי אם אין תוכנת Ultimatum שמשתמשת בו.</translation>
<translation id="2008474315282236005">‏הפעולה הזו תמחק פריט אחד מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, היכנס אל Ultimatum עם <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">ההתקנה נכשלה. יש לנסות שוב.</translation>
<translation id="2020032459870799438">‏כדי לבדוק אם שאר הסיסמאות מוגנות מפני פרצות באבטחת מידע ובעיות אבטחה אחרות, <ph name="BEGIN_LINK" />יש להיכנס ל-Ultimatum<ph name="END_LINK" />.</translation>
<translation id="2049376729098081731">‏בוחרים אם לכלול את ההיסטוריה ב-Ultimatum להתאמה אישית מדויקת יותר בשירותי Google</translation>
<translation id="2054039611381840095">‏כדי לקבל עדכונים של Ultimatum בעתיד, צריך להשתמש ב-macOS מגרסה 12 ואילך. במחשב הזה פועלת גרסה 11 של macOS.</translation>
<translation id="2086476982681781442">‏Ultimatum חסם את ההורדה הזאת כי הקובץ מטעה ועשוי לבצע שינויים לא צפויים במכשיר שלך</translation>
<translation id="2099452623287920103">‏הסיסמאות ונתונים אחרים מ-Ultimatum ששמרת בחשבון שלך ב-Google יוסרו מהמכשיר הזה. כדי להשתמש בהם שוב ב-Ultimatum, צריך להיכנס בחזרה לחשבון.</translation>
<translation id="2120965832000301375">{COUNT,plural, =1{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-Ultimatum במשך דקה. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}one{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-Ultimatum במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}two{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-Ultimatum במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}other{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-Ultimatum במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}}</translation>
<translation id="2126108037660393668">נכשל האימות של הקובץ שהורד.</translation>
<translation id="2137162749895930932">סגירת המסך לתרגום</translation>
<translation id="215352261310130060">‏Ultimatum חסם את ההורדה הזאת כי האתר לא משתמש בחיבור מאובטח ויכול להיות שבוצעו שינויים לא מורשים בקובץ</translation>
<translation id="2157600032285353789">‏אפשר לפתוח את הסימניות, את מצב הקריאה ועוד מתפריט Ultimatum</translation>
<translation id="2174178932569897599">‏התאמה אישית של Ultimatum</translation>
<translation id="2174917724755363426">ההתקנה לא הושלמה. להמשיך בביטול?</translation>
<translation id="2185166961232948079">‏Ultimatum – כניסה לרשת – <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">השגיאה בבדיקת העדכון: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199210295479376551">‏הסרת החשבון מ-Ultimatum</translation>
<translation id="2210682093923538346">‏אתר מסוכן. ‫Ultimatum הסיר את ההתראות.</translation>
<translation id="2236949375853147973">הפעילות שלי</translation>
<translation id="2238130810669087193">‏כדי לקבל גישה לכתובות ולנתונים נוספים בכל המכשירים שלך, כדאי להיכנס ל-Ultimatum. לאחר הכניסה, הכתובת הזו תישמר בחשבון שלך ב-Google.</translation>
<translation id="2240214816234246077">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאות '<ph name="PERMISSION_1" />' ו'<ph name="PERMISSION_2" />' הוסרו על ידי Ultimatum</translation>
<translation id="2241627712206172106">‏אם משתפים מחשב, חברים ובני משפחה יכולים לגלוש בנפרד ולהגדיר את Ultimatum בדיוק כפי שהם רוצים.</translation>
<translation id="2287771843518581140">{NUM_TABS,plural, =1{‏ההמלצה של Ultimatum היא להשהות את הכרטיסייה שמאטה את הדפדפן}one{‏ההמלצה של Ultimatum היא להשהות את הכרטיסיות שמאטות את הדפדפן}two{‏ההמלצה של Ultimatum היא להשהות את הכרטיסיות שמאטות את הדפדפן}other{‏ההמלצה של Ultimatum היא להשהות את הכרטיסיות שמאטות את הדפדפן}}</translation>
<translation id="2313870531055795960">‏המערכת בודקת כתובות URL בעזרת רשימה של אתרים לא בטוחים ששמורה ב-Ultimatum. אם באתר כלשהו מתבצע ניסיון לגנוב את הסיסמה שלך, או אם המערכת מזהה הורדה של קובץ מזיק, Ultimatum עשוי גם לשלוח כתובות URL לבדיקה באמצעות 'גלישה בטוחה'. הנתונים שנשלחים לבדיקה כוללים ביטים מתוכן של דפים.</translation>
<translation id="2343156876103232566">‏כדי לשלוח מספר מכאן לטלפון Android, יש להיכנס ל-Ultimatum בשני המכשירים.</translation>
