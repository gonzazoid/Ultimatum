<translation id="7689606757190482937">‏סנכרון והתאמה אישית של Ultimatum בכל המכשירים שברשותך</translation>
<translation id="7699779824407626136">‏עדכון ל-Ultimatum</translation>
<translation id="7716950018788545737">המשימות הסתיימו.</translation>
<translation id="77283119132245232">השירות הזה מספק תיעוד של עקבות המערכת ל-<ph name="BROWSER_NAME" />. אם השירות הזה מושבת, נתוני המעקב אחר הביצועים שנוצרים על ידי הדפדפן לא יכללו אירועים כלל-מערכתיים, כמו אירועי החלפת הקשר ואירועי שרשור מוכנים.</translation>
<translation id="7745317241717453663">‏פעולה זו תמחק את נתוני הגלישה מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, יש להיכנס אל Ultimatum עם <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">המתקין לא הצליח ליצור ספרייה זמנית. יש לבדוק את המקום הפנוי בדיסק ואת האישור להתקנת תוכנה.</translation>
<translation id="7786760609782648049">‏שיפור המהירות ב-Ultimatum</translation>
<translation id="7790626492778995050">‏<ph name="PAGE_TITLE" /> – Ultimatum בגרסת Canary</translation>
<translation id="7803986347287457849">‏לאנשים שיש להם גישה לתעבורת הנתונים שלך יהיה קשה יותר לראות את האתרים שביקרת בהם. ‫Ultimatum משתמש בחיבור מאובטח לחיפוש כתובות IP של אתרים ב-DNS.</translation>
<translation id="7810005234485217901">אפשר להצמיד את התכונה 'חיפוש תמונות' כדי לאפשר גישה נוחה</translation>
<translation id="7828947555739565424">‏כבר קיים במכשיר פרופיל Ultimatum עם החשבון הזה.</translation>
<translation id="7845233973568007926">תודה שהתקנת. עליך להפעיל מחדש את המחשב לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="7859018312476869945">‏כשמקלידים טקסט בסרגל הכתובות או בתיבת החיפוש, Ultimatum שולח את הטקסט הזה למנוע החיפוש שמוגדר כברירת מחדל כדי לקבל הצעות טובות יותר. האפשרות הזו מושבתת במצב הפרטי.</translation>
<translation id="7867198900892795913">‏עדכון Ultimatum לגרסה האחרונה לא הצליח, ולכן אין לך גישה אל תכונות חדשות ותיקוני אבטחה.</translation>
<translation id="7872446069773932638">מתבצעת הורדה… יש עוד <ph name="SECONDS" /> שנ'</translation>
<translation id="7888981273428720788">‏הגדרת Ultimatum כדפדפן ברירת המחדל</translation>
<translation id="7934340546140346950">‏‫Ultimatum משדרג חיבורים לא מאובטחים ל-HTTPS באופן אוטומטי כשאפשר</translation>
<translation id="7937630085815544518">‏נכנסת ל-Ultimatum כ-<ph name="USER_EMAIL_ADDRESS" />. יש להשתמש באותו חשבון כדי להיכנס שוב.</translation>
<translation id="7975919845073681630">‏זוהי התקנה משנית של Ultimatum, ולא ניתן להפוך אותו לדפדפן ברירת המחדל שלך.</translation>
<translation id="7997934263947464652">‏תוספים, אפליקציות ועיצובים ממקורות לא מוכרים עלולים להזיק למכשיר. ההמלצה של Ultimatum היא להתקין אותם רק מ<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /></translation>
<translation id="8004582292198964060">דפדפן</translation>
<translation id="8010081455002666927">זיהוי אוטומטי</translation>
<translation id="8013436988911883588">‏אחרי מתן גישה ל-Ultimatum, אתרים יוכלו לבקש ממך גישה.</translation>
<translation id="80471789339884597">תודה שהתקנת. עליך להפעיל מחדש את כל הדפדפנים לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="8054112667659782652">תמיד להציג את קיצור הדרך לחיפוש תמונות</translation>
<translation id="8077498902115777962">‏השבתת הפעילות של Ultimatum ברקע לאפליקציות</translation>
<translation id="80790299200510644">חיפוש באמצעות תמונות</translation>
<translation id="8086881907087796310">ההתקנה נכשלה כי המחשב לא עומד בדרישות החומרה המינימליות.</translation>
<translation id="8096472344908884505">‏<ph name="PAGE_TITLE" /> –‏ Ultimatum for Testing</translation>
<translation id="8105840573057009683">‏נדרשת הרשאת מיקום ב-Ultimatum עבור האתר הזה</translation>
<translation id="8118331347066725040">‏שליחת משוב על חיפוש באמצעות Lens</translation>
<translation id="8133124826068723441">‏לא בוצע סנכרון של הנתונים ב-UltimatumOS כי אפשרות הסנכרון לא זמינה עבור הדומיין שלך.</translation>
