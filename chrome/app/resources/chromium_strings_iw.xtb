<translation id="7295544978856094497">{NUM_EXTENSIONS,plural, =1{‏ההמלצה של Ultimatum היא להסיר אותו}one{‏ההמלצה של Ultimatum היא להסיר אותם}two{‏ההמלצה של Ultimatum היא להסיר אותם}other{‏ההמלצה של Ultimatum היא להסיר אותם}}</translation>
<translation id="7309928523159922338">‏מדידת המודעות מאפשרת לאתרים שביקרת בהם לבקש מ-Ultimatum מידע שיעזור לבעלי האתרים למדוד את הביצועים של המודעות שלהם. מדידת המודעות מגבילה את המעקב באתרים שונים על ידי העברת כמות קטנה ככל האפשר של מידע בין אתרים.</translation>
<translation id="731795002583552498">‏העדכון של Ultimatum‏ מתבצע</translation>
<translation id="7318036098707714271">‏קובץ ההעדפות שלך פגום או לא חוקי. 

Ultimatum לא יכול לשחזר את ההגדרות שלך.</translation>
<translation id="7339898014177206373">חלון חדש</translation>
<translation id="734373864078049451">‏היסטוריית האתרים, הסימניות ונתונים נוספים מ-Ultimatum נמצאים כאן.</translation>
<translation id="7349591376906416160">‏לפי הגדרת מנהל המערכת, Ultimatum יפתח את<ph name="ALTERNATIVE_BROWSER_NAME" /> כדי לגשת אל <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">משהו השתבש</translation>
<translation id="7384121030444253939">‏התוסף הזה כבר לא נתמך. ההמלצה של Ultimatum היא להסיר אותו.</translation>
<translation id="7449453770951226939">‏<ph name="PAGE_TITLE" /> - Ultimatum בגרסת פיתוח</translation>
<translation id="7450541714075000668">הטקסט הועתק</translation>
<translation id="7451052299415159299">‏Ultimatum זקוק להרשאת גישה למצלמה בשביל האתר הזה</translation>
<translation id="7458892263350425044">‏כדי להשתמש במיקרופון, צריך להיכנס אל <ph name="BEGIN_LINK" />הגדרות המערכת<ph name="END_LINK" /> ולתת ל-Ultimatum גישה</translation>
<translation id="7461356015007898716">‏כדי לקבל עדכונים של Ultimatum בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 7.</translation>
<translation id="7467949745582939695">‏להפעיל את Ultimatum מחדש?</translation>
<translation id="7483335560992089831">‏לא ניתן להתקין את אותה גרסת Ultimatum שפועלת כרגע. יש לסגור את Ultimatum ולנסות שוב.</translation>
<translation id="751935028865900641">‏סביר להניח שאתרים יפעלו כצפוי. אם סוגרים את כל החלונות של Ultimatum, מתבצעת יציאה מהחשבון ברוב האתרים, חוץ מחשבון Google אם הוא מחובר ל-Ultimatum.</translation>
<translation id="753534427205733210">{0,plural, =1{‏Ultimatum יופעל מחדש בעוד דקה}one{‏Ultimatum יופעל מחדש בעוד # דקות}two{‏Ultimatum יופעל מחדש בעוד # דקות}other{‏Ultimatum יופעל מחדש בעוד # דקות}}</translation>
<translation id="7582945390259497898">‏Ultimatum יכול להעריך מהם תחומי העניין שלך. לאחר מכן, אתר שבו ביקרת יכול לשלוח בקשה ל-Ultimatum כדי לגלות מהם תחומי העניין שלך ולהתאים אישית את המודעות שמוצגות לך.</translation>
