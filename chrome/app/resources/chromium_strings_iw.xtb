<translation id="8166782796394721554">‏הפעלת הגנה נוספת במנוע WebAssembly ו-JavaScript של Ultimatum</translation>
<translation id="81770708095080097">‏Ultimatum‏ חסם את הקובץ הזה כי הוא מסוכן.</translation>
<translation id="8177472873527554730">לא נמצא תוכן בדף</translation>
<translation id="8200109504272824693">‏כדי להשתמש בנתונים של Ultimatum ולשמור אותם בחשבון <ph name="USER_EMAIL" />, צריך להזין את ביטוי הסיסמה</translation>
<translation id="8221491193165283816">הבחירה שלך היא בדרך כלל לחסום התראות. כדי לאפשר לאתר הזה להציג התראות יש ללחוץ כאן.</translation>
<translation id="8223363452568144035">‏כדי להשתמש במצלמה, צריך להיכנס אל <ph name="BEGIN_LINK" />הגדרות המערכת<ph name="END_LINK" /> ולתת ל-Ultimatum גישה</translation>
<translation id="8232193495299001329">‏‫Ultimatum לא יכול לאמת את מקור התוסף הזה ויכול להיות שהוא לא בטוח. צריך להסיר אותו מ-Ultimatum כדי לא לאפשר לו יותר לראות ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="8248265253516264921">‏אם אין לתמונה תיאור מועיל, Ultimatum ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל Google. אפשר להשבית את האפשרות הזו בכל זמן דרך ההגדרות.</translation>
<translation id="8254601181414348851">‏להיכנס ל-Ultimatum עם פרופיל חדש?</translation>
<translation id="8286943863733751221">‏<ph name="BEGIN_LINK" />ב-Ultimatum מוצגות אזהרות<ph name="END_LINK" /> מפני הורדות ואתרים לא בטוחים</translation>
<translation id="8313851650939857356">שגיאת הפעלה: <ph name="STARTUP_ERROR" />.</translation>
<translation id="8318772038038596122">‏לפי הגדרת הארגון, Ultimatum נסגר אוטומטית כשלא משתמשים בו במשך <ph name="TIMEOUT_DURATION" />.</translation>
<translation id="8321888067342493336">שמירה כתמונה</translation>
<translation id="8330519371938183845">‏כניסה לחשבון תסנכרן ותתאים אישית את Ultimatum בכל המכשירים שברשותך</translation>
<translation id="8340674089072921962">‏בכתובת <ph name="USER_EMAIL_ADDRESS" /> השתמשו בעבר ב-Ultimatum</translation>
<translation id="8359544530202147897">‏כדי להמשיך להשתמש בנתונים של Ultimatum בחשבון שלך ב-Google (<ph name="ACCOUNT_EMAIL" />), צריך לעדכן את Ultimatum</translation>
<translation id="8360718212975266891">‏כדי לקבל עדכונים של Ultimatum בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 8.</translation>
