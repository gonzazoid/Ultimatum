<translation id="6475912303565314141">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את Ultimatum.</translation>
<translation id="648319183876919572">הגרסה המשופרת של הגלישה הבטוחה מגנה עליך טוב יותר מפני הורדות ואתרים מסוכנים</translation>
<translation id="6510925080656968729">‏הסרה של התקנת Ultimatum</translation>
<translation id="651535675648445253">‏קיצורי הדרך נפתחים ב-Ultimatum</translation>
<translation id="6524389414524528185">‏כשמחוברים לחשבון, אפשר להשתמש בסיסמאות ובפרטים נוספים מחשבון Google ב-Ultimatum. אפשר לשנות את זה בכל שלב ב'הגדרות'.</translation>
<translation id="6539122709674868420">‏לפי הגדרת הארגון, Ultimatum נסגר אוטומטית כשלא משתמשים בו במשך <ph name="TIMEOUT_DURATION" />. נתוני הגלישה נמחקו. בין הנתונים שנמחקו: היסטוריה, מילוי אוטומטי והורדות.</translation>
<translation id="6542839706527980775">‏בכל פרופיל מאוחסנים נתוני Ultimatum משלו כמו סימניות, היסטוריה, סיסמאות ועוד</translation>
<translation id="6563921047760808519">‏<ph name="BEGIN_LINK" />מידע נוסף לגבי השמירה על פרטיות הנתונים ב-Ultimatum<ph name="END_LINK" /></translation>
<translation id="6564039629497156115">‏השינויים בהגדרה הזו ייכנסו לתוקף לאחר הפעלה מחדש של Ultimatum.</translation>
<translation id="656935081669708576">‏אפשר לעבור לפרופיל Ultimatum אחר כדי לראות סיסמאות</translation>
<translation id="6570579332384693436">‏Ultimatum שולח את הטקסט שמוקלד בשדות טקסט ל-Google כדי לתקן שגיאות כתיב</translation>
<translation id="6598877126913850652">‏מעבר אל הגדרות ההודעות של Ultimatum</translation>
<translation id="6600016381025017075">אפשר לחפש משהו בדף הזה</translation>
<translation id="6613594504749178791">‏השינויים שביצעת ייכנסו לתוקף בפעם הבאה שתפעיל מחדש את Ultimatum‏.</translation>
<translation id="665732753414869868">‏נדרשת הרשאת גישה למצלמה ב-Ultimatum כדי ליצור מפה תלת-ממדית של הסביבה שלך</translation>
<translation id="6669284030132180248">‏אם הסימניות שלך נשמרות גם בחשבון Google, יש לך אפשרות לעקוב אחרי מחירי מוצרים ב-Ultimatum ולקבל הודעות כשהמחירים יורדים</translation>
<translation id="6676384891291319759">גישה אל האינטרנט</translation>
<translation id="668175097507315160">‏לא בוצע סנכרון של הנתונים ב-UltimatumOS בגלל שגיאה בתהליך הכניסה.</translation>
<translation id="6692797197837897398">‏ב-Ultimatum יש לך יותר שליטה במודעות שמוצגות לך, וחלות הגבלות על המידע עליך שהאתרים יכולים לקבל בהצגת מודעות בהתאמה אישית.</translation>
<translation id="6709350901466051922">‏נדרשת הרשאת גישה למיקרופון ב-Ultimatum עבור האתר הזה</translation>
<translation id="6712881677154121168">שגיאה בהורדה: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="6717134281241384636">‏לא ניתן להשתמש בפרופיל שלך משום שהוא מגיע מגרסה חדשה יותר של Ultimatum.

ייתכן שחלק מהתכונות לא יהיו זמינות. יש לציין ספריית פרופיל אחרת או להשתמש בגרסה חדשה יותר של Ultimatum.</translation>
<translation id="6729124504294600478">‏כדי להשתמש בהתאמה אישית ובתכונות אחרות, צריך לכלול את Ultimatum ב'פעילות באינטרנט ובאפליקציות' ובשירותי Google המקושרים</translation>
<translation id="6734291798041940871">‏Ultimatum כבר מותקן במחשב ונגיש לכל המשתמשים.</translation>
<translation id="674245979920622322">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאות '<ph name="PERMISSION_1" />', '<ph name="PERMISSION_2" />' ועוד <ph name="COUNT" /> הרשאות הוסרו על ידי Ultimatum</translation>
<translation id="67706546131546258">‏ההמלצה של Ultimatum היא לסרוק את הקובץ הזה כי הוא עלול להיות מסוכן.</translation>
<translation id="6779406956731413166">‏<ph name="BEGIN_LINK_CROS_OSS" />תוכנת קוד פתוח<ph name="END_LINK_CROS_OSS" /> נוספת מאפשרת את השימוש ב-UltimatumOS.</translation>
<translation id="6831043979455480757">תרגום</translation>
<translation id="6847869444787758381">‏Ultimatum מודיע לך אם הסיסמאות שלך נמצאות בסיכון</translation>
<translation id="684888714667046800">לא ניתן להתחבר לאינטרנט. אם משתמשים בחומת אש, צריך לוודא ש-<ph name="PRODUCT_EXE_NAME" /> ברשימת ההיתרים.</translation>
<translation id="6857782730669500492">‏Ultimatum‏ - <ph name="PAGE_TITLE" /></translation>
<translation id="6873893289264747459">‏הפריט "<ph name="EXTENSION_NAME" />" שנמצא ב-Ultimatum מכיל תוכנה זדונית</translation>
<translation id="6877155553248388166">‏הפינה הימנית התחתונה של אזור החיפוש: ‎<ph name="RIGHT" />%‎ מימין, ‎<ph name="BOTTOM" />%‎ מלמטה</translation>
<translation id="6896758677409633944">העתקה</translation>
<translation id="6901631050894301805">‏הגדרת Ultimatum כדפדפן ברירת המחדל והצמדה שלו לסרגל המשימות</translation>
<translation id="6929417474050522668">‏כשגרסאות הניסיון פעילות, מדידת המודעות מאפשרת לאתרים שבהם ביקרת לבקש מ-Ultimatum מידע שיעזור לבעלי האתרים למדוד את הביצועים של המודעות שלהם. מדידת המודעות מגבילה את המעקב באתרים שונים על ידי העברת כמות קטנה ככל האפשר של מידע בין אתרים.</translation>
<translation id="6940431691900807093">‏לאחר מכן, אתר שבו ביקרת יכול לשלוח בקשה ל-Ultimatum כדי לגלות מהם תחומי העניין שלך ולהתאים אישית את המודעות שמוצגות לך. Ultimatum יכול לשתף עד 3 תחומי עניין.</translation>
<translation id="6964305034639999644">‏פתיחת הקישור בחלון &amp;אנונימי של Ultimatum</translation>
<translation id="6965382102122355670">אישור</translation>
<translation id="6978145336957848883">‏קל לנחש סיסמאות חלשות. באמצעות Ultimatum אפשר <ph name="BEGIN_LINK" />ליצור ולזכור סיסמאות חזקות<ph name="END_LINK" />.</translation>
<translation id="6985329841647292029">‏התנאים לשימוש ב-UltimatumOS</translation>
<translation id="6990124437352146030">‏Ultimatum זקוק להרשאת גישה למיקרופון בשביל האתר הזה</translation>
<translation id="7003299027384820442">‏כדי להשתמש בנתונים של Ultimatum ולשמור אותם בחשבון <ph name="ACCOUNT_EMAIL" />, צריך להזין את ביטוי הסיסמה</translation>
<translation id="7011190694940573312">ההתקנה נכשלה כי הגרסה הזו של מערכת ההפעלה לא נתמכת.</translation>
<translation id="7024536598735240744">שגיאה בפתיחה: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7025789849649390912">ההתקנה נעצרה.</translation>
<translation id="7045244423563602563">‏אפשר להתאים אישית את Ultimatum בדרך שנוחה לך</translation>
<translation id="705851970750939768">‏יש לעדכן את Ultimatum‏</translation>
<translation id="7067091210845072982">‏אם אין לתמונה תיאור מועיל, Ultimatum ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל Google.</translation>
<translation id="7141270731789036260">‏התאמה אישית של Ultimatum for Testing</translation>
<translation id="7163519456498498587">‏הסרה של <ph name="EXTENSION_NAME" /> מ-Ultimatum</translation>
<translation id="7173822816570314652">‏לפי הגדרת הארגון, נתוני Ultimatum נמחקים אוטומטית כשלא משתמשים בהם במשך <ph name="TIMEOUT_DURATION" />. בין הנתונים שנמחקו: היסטוריה, מילוי אוטומטי והורדות.</translation>
<translation id="718435575166326686">‏נדרשת הרשאת גישה למצלמה ב-Ultimatum עבור האתר הזה</translation>
<translation id="7196312274710523067">‏לא ניתן היה להפעיל את Ultimatum. יש לנסות שוב.</translation>
<translation id="7197677400338048821">‏Ultimatum לא יכול לבדוק את הסיסמאות שלך. יש לנסות שוב בעוד 24 שעות.</translation>
<translation id="7213407614656404070">‏שימוש ב-Ultimatum בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות.</translation>
<translation id="7223968959479464213">‏מנהל המשימות - Ultimatum</translation>
<translation id="7246575524853130370">‏תחומי העניין שלך בהתאם להערכה של Ultimatum</translation>
<translation id="7274695763216404502">התכונה הוצמדה. מעכשיו אפשר להשתמש בתכונה 'חיפוש תמונות' דרך סרגל הכלים</translation>
