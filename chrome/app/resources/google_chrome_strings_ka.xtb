<translation id="5003967926796347400">დაწკაპუნებით აირჩიეთ „Google პაროლების მმართველი“</translation>
<translation id="5043786843026425788">შეიტყვეთ მეტი Google Lens-ის მეშვეობით Ultimatum-ში ძიების შესახებ</translation>
<translation id="504867494566807945">გახსნის ბმულებს Ultimatum-ში ნებისმიერი აპიდან. დამატებით, მარტივი წვდომისთვის ის ჩამაგრდება თქვენს ამოცანათა ზოლში.</translation>
<translation id="5105120510934353742">მომავალში Ultimatum-ის განახლებების მისაღებად დაგჭირდებათ macOS 13 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს macOS 12-ს.</translation>
<translation id="5114340746415930644">შეიყვანეთ თქვენი საიდუმლო ფრაზა, რომ გამოიყენოთ და შეინახოთ Ultimatum-ის მონაცემები თქვენს ანგარიშში, <ph name="USER_EMAIL" /></translation>
<translation id="5120334927898581447">შედით Ultimatum-ში, როცა Google-ის სხვა სერვისებში შედიხართ</translation>
<translation id="5126049312684316860">Ultimatum წინასწარ ჩატვირთავს უფრო მეტ გვერდს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="5127558335897923940">დატოვეთ Ultimatum თქვენს სამაგრში, რომ მისი გახსნა ნებისმიერ დროს სწრაფად შეძლოთ</translation>
<translation id="5132929315877954718">აღმოაჩინეთ დიდებული აპები, თამაშები, გაფართოებები და თემები Ultimatum-ისთვის.</translation>
<translation id="5139423532931106058">თქვენი Ultimatum პროფილის მორგება</translation>
<translation id="5163087008893166964">მოგესალმებით Ultimatum-ში; გახსნილია ბრაუზერის ახალი ფანჯარა</translation>
<translation id="5166439563123238795">Ultimatum-ს სჭირდება ნებართვა თქვენი ხელების მოძრაობაზე თვალის მისადევნებლად</translation>
<translation id="5169778651486082413">გამოიყენეთ თქვენი პაროლები Ultimatum-ით თქვენს ტელეფონში</translation>
<translation id="5170938038195470297">თქვენი პროფილის გამოყენება შეუძლებელია, რადგან იგი მიღებულია Ultimatum-ის უფრო ახალი ვერსიიდან.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს. მიუთითეთ პროფილის სხვა დირექტორია ან გამოიყენეთ Ultimatum-ის უფრო ახალი ვერსია.</translation>
<translation id="5174969993834422967">როგორც წესი, თქვენ ბლოკავთ შეტყობინებებს. ამ საიტისგან შეტყობინებების მისაღებად დააწკაპუნეთ მდებარეობის ზოლის მარჯვენა კუთხეში მდებარე ხატულას.</translation>
<translation id="5174983315706567306">სივრცე დისკზე საკმარისი არ არის.</translation>
<translation id="5179933070463113976">იმისათვის რომ Gemini Ultimatum-ში გამოიყენოთ, საჭიროა, რომ Ultimatum-ში შესული იყოთ თქვენი Google ანგარიშით</translation>
<translation id="5190467473654176081">მოირგეთ Ultimatum, რომ მას ახალი იერი შესძინოთ</translation>
<translation id="5201744974236816379">Ultimatum-ის განახლება</translation>
<translation id="521447420733633466">თუ საზიარო მოწყობილობა გაქვთ, თქვენს მეგობრებსა და ოჯახის წევრებს შეუძლიათ ვების დამოუკიდებლად დათვალიერება და Ultimatum-ის საკუთარი შეხედულებისამებრ დაყენება</translation>
<translation id="5234764350956374838">გაუქმება</translation>
<translation id="5239627039202700673">გამოიყენეთ Ultimatum შეტყობინებებში, დოკუმენტებსა და სხვა აპებში არსებულ ბმულებზე ყოველი დაწკაპუნებისას.</translation>
<translation id="5251420635869119124">სტუმრებს შეუძლიათ Ultimatum-ის გამოყენება და მისი ყველა ფუნქციით სარგებლობა.</translation>
<translation id="5286907366254680517">ამოცნობილია</translation>
<translation id="5320351714793324716">ქუქი-ჩანაწერების დაშვების შემთხვევაში, Ultimatum-მა, შესაძლოა, გამოიყენოს ისინი წინასწარ ჩატვირთვისთვის</translation>
<translation id="5321325624576443340">Google Lens მიუწვდომელია. ცადეთ მოგვიანებით.</translation>
<translation id="5334309298019785904">UltimatumOS-მა ვერ დაასინქრონა თქვენი მონაცემები, რადგან სინქრონიზაცია თქვენი დომენისთვის არ არის ხელმისაწვდომი.</translation>
<translation id="5334487786912937552">ფაილების ჩამოსატვირთად Ultimatum საჭიროებს მეხსიერებაზე წვდომის ნებართვას</translation>
<translation id="5337648990166757586">არასავალდებულო: UltimatumOS-ის ფუნქციებისა და წარმადობის გაუმჯობესების ხელშეწყობა დიაგნოსტიკური და გამოყენების მონაცემების Google-ისთვის ავტომატურად გაგზავნის მეშვეობით.</translation>
<translation id="5346389065299425353">გააღრმავეთ თქვენი ძიება რამდენიმე ჩანართის, ფაილისა და ხელსაწყოს დამატებით</translation>
<translation id="5353252989841766347">პაროლების ექსპორტი Ultimatum-იდან</translation>
<translation id="5368118228313795342">დამატებითი კოდი: <ph name="EXTRA_CODE" />.</translation>
<translation id="5386244825306882791">იგი ასევე აკონტროლებს, თუ რომელი გვერდი გამოჩნდება Ultimatum-ის გაშვებისას ან Omnibox-დან ძიების დროს.</translation>
<translation id="5394833366792865639">Ultimatum-ის ჩანართის გაზიარება</translation>
<translation id="5402307365844630024">Gemini Ultimatum Beta-შის ჩართვა/გამორთვა</translation>
<translation id="5430073640787465221">თქვენი გამორჩეული ფაილი დაზიანებულია ან არასწორია.

Ultimatum ვერ შეძლებს თქვენი პარამეტრების აღდგენას.</translation>
<translation id="5465210843490471889">აირჩიეთ Ultimatum-ის პროფილი, რომელსაც გამოიყენებთ <ph name="START_GLIC_STYLING" />Gemini<ph name="END_GLIC_STYLING" />-სთან ერთად</translation>
<translation id="5468572406162360320">ამ ფუნქციების გაუმჯობესების მიზნით, თქვენს მათთან ურთიერთქმედებას Ultimatum გაუგზავნის Google-ს. აღნიშნული მონაცემების წაკითხვა, დამუშავება და ანოტირება, შესაძლოა, განხორციელდეს ადამიანი მიმომხილველების მიერ.</translation>
<translation id="547202872422499512">Ultimatum ახლა Windows-ის ჩართვისას გაეშვება, რათა დათვალიერება მომენტალურად დაიწყოთ. ამის გამორთვა პარამეტრებიდან შეგიძლიათ.</translation>
<translation id="5486346529181556467">გააძლიერეთ ონლაინ უსაფრთხოება ყველასთვის, როცა მოხსენებას გაგზავნით საიტის შესახებ, რომელიც, თქვენი აზრით, საზიანოა. შეიტყვეთ მეტი <ph name="BEGIN_LINK" />Google-ის საფრთხის შემცველი საიტების წესების შესახებ.<ph name="END_LINK" /></translation>
<translation id="5524890928877629608">ძიების არეალის ზედა მარცხენა კუთხე: მარცხნივ <ph name="LEFT" />%, ზემოთ <ph name="TOP" />%</translation>
<translation id="5550137307985173298">დააწკაპუნეთ ღილაკზე „Ultimatum-ის მორგება“ ახალი ჩანართის გვერდზე, რათა Ultimatum-ს ახალი იერი შესძინოთ</translation>
<translation id="5566025111015594046">Ultimatum (mDNS-In)</translation>
<translation id="5579324208890605088">გაშვების შეცდომა: გაუშვით ინსტალატორი, როგორც რიგითმა მომხმარებელმა და არა — ადმინისტრატორმა.</translation>
<translation id="5596627076506792578">დამატებითი ვარიანტები</translation>
<translation id="5600352656975192682">ჩაამაგრეთ Ultimatum ამოცანათა ზოლში, რომ ნებისმიერ დროს გამოიყენოთ ის</translation>
<translation id="5602351063754773347">Ultimatum გირჩევთ მის ამოშლას. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი მხარდაჭერილი გაფართოებების შესახებ<ph name="END_LINK" /></translation>
<translation id="5610759359710387751">მოახდინეთ Ultimatum-ის პერსონალიზაცია</translation>
<translation id="5649156266046089790">Ultimatum პროფილები Ultimatum-ში არსებული თქვენი კონტენტის განცალკევების საშუალებას გაძლევთ. შექმენით პროფილები ოჯახის წევრებისა და მეგობრებისთვის, ან განაცალკევეთ სამსახურებრივი და პირადი მონაცემები.</translation>
<translation id="565744775970812598">Ultimatum-მა დაბლოკა <ph name="FILE_NAME" />, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="566040795510471729">თქვენი Ultimatum-ის მ&amp;ორგება</translation>
<translation id="566568153320186256">Ultimatum დაზოგავს ბატარეის მუხტს ვიზუალური ეფექტებისა (მაგალითად, ლივლივა გადაადგილებისა და ვიდეოკადრების სიხშირის) და ფონური აქტივობის შეზღუდვის გზით. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი ენერგიის დამზოგის შესახებ<ph name="END_LINK" /></translation>
<translation id="567202749201779594">გაასუფთავეთ Ultimatum-ის მონაცემები თქვენს ანგარიშში</translation>
<translation id="5678190148303298925">{COUNT,plural, =0{ამ განახლების მისასადაგებლად ადმინისტრატორი გთხოვთ Ultimatum-ის ხელახლა გაშვებას}=1{ამ განახლების მისასადაგებლად ადმინისტრატორი გთხოვთ Ultimatum-ის ხელახლა გაშვებას. თქვენი ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}other{ამ განახლების მისასადაგებლად ადმინისტრატორი გთხოვთ Ultimatum-ის ხელახლა გაშვებას. თქვენი # ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}}</translation>
<translation id="5686916850681061684">მოირგეთ და გააკონტროლეთ Ultimatum. საჭიროა თქვენი ყურადღება — დააწკაპუნეთ დეტალური ინფორმაციისთვის.</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="569897634095159764">ინტერნეტთან დაკავშირება ვერ ხერხდება. პროქსი-სერვერი საჭიროებს ავტორიზაციას.</translation>
<translation id="5709557627224531708">დააყენეთ Ultimatum ნაგულისხმევ ბრაუზერად</translation>
<translation id="5719246646468301581">Ultimatum-ისა და Ultimatum OS-ის მომსახურების დამატებითი პირობები</translation>
<translation id="5719324992913248873">ეს მოქმედება:
          <ph name="LINE_BREAKS" />
           • გადააყენებს Ultimatum-ის ზოგიერთ პარამეტრსა და Ultimatum-ის მალსახმობს
           <ph name="LINE_BREAK" />
           • გათიშავს მალსახმობებს
           <ph name="LINE_BREAK" />
           • წაშლის ქუქი-ჩანაწერებსა და საიტების სხვა დროებით მონაცემებს
            <ph name="LINE_BREAKS" />
           სანიშნეები, ისტორია და შენახული პაროლები ხელუხლებელი დარჩება.</translation>
<translation id="5736850870166430177">საიტის მიერ პაროლის მოპარვის მცდელობის ან თქვენ მიერ საზიანო ფაილის ჩამოტვირთვის შემთხვევაში Ultimatum-ის მიერ Safe Browsing-ს გაეგზავნება URL-ები და შესაბამისი გვერდის კონტენტის გარკვეული ნაწილი</translation>
<translation id="5756509061973259733">Ultimatum პროფილი ამ ანგარიშით უკვე არსებობს ამ მოწყობილობაზე</translation>
<translation id="5759947850379142561">მონიშნეთ ნებისმიერი ტექსტი ან სურათი, რომ მოიძიოთ Google Lens-ით ან დააჭირეთ Escape ღილაკს, რომ გახვიდეთ Google Lens-იდან</translation>
<translation id="5762867845020858790">დაამატეთ ახალი Ultimatum პროფილი, რათა სანიშნეები, პაროლები და პარამეტრები ცალკე შეინახოთ.</translation>
<translation id="5779427581965287859">დააყენეთ Ultimatum ნაგულისხმევ ბრაუზერად და ჩაამაგრეთ ის ამოცანათა ზოლში</translation>
<translation id="5795887333006832406"><ph name="PAGE_TITLE" /> — Ultimatum Canary</translation>
<translation id="5804318322022881572">Ultimatum-ის გაშვება ვერ მოხერხდა. ცადეთ ხელახლა.</translation>
