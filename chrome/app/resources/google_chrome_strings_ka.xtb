<ph name="EXTENSION_NAME" /></translation>
<translation id="7606334485649076285">UltimatumOS Flex</translation>
<translation id="7626072681686626474"><ph name="MANAGER" /> მოითხოვს, რომ ამ მოწყობილობის გამოყენებამდე წაიკითხოთ ქვემოთ მოცემული მომსახურების პირობები და დაეთანხმოთ მათ. აღნიშნული პირობები არ არის UltimatumOS-ის წესების დამატება, ასევე, არ ცვლის და არც ზღუდავს მათ.</translation>
<translation id="7627609214560473136">თქვენი მონაცემების დაცვის მიზნით, მიეცით საშუალება Ultimatum-ს გაუუქმოს ნებართვები საიტებს, რომლებზეც ბოლო დროს არ გადასულხართ.</translation>
<translation id="7629695634924605473">Ultimatum გაცნობებთ, თუ თქვენს პაროლებს ვინმე გატეხავს</translation>
<translation id="7641148173327520642">თქვენი სისტემის ადმინისტრატორმა მოახდინა Ultimatum-ის კონფიგურაცია იმგვარად, რომ <ph name="TARGET_URL_HOSTNAME" />-ზე წვდომისთვის საჭიროა <ph name="ALTERNATIVE_BROWSER_NAME" />-ის გახსნა.</translation>
<translation id="7641448682796883218">Ultimatum მინიშნება: გაძლიერებული Safe Browsing</translation>
<translation id="7649070708921625228">დახმარება</translation>
<translation id="7651907282515937834">Ultimatum Enterprise-ის ლოგო</translation>
<translation id="76531479118467370">Ultimatum-მა დაბლოკა ეს ჩამოტვირთვა, რადგან Safe Browsing გამორთეთ და ფაილის შემოწმება ვერ ხერხდება</translation>
<translation id="7655472416356262023">ანგარიშის ამოშლა Ultimatum-იდან</translation>
<translation id="7658239707568436148">გაუქმება</translation>
<translation id="7670287553302121848">Ultimatum ანგარიში საჭიროებს ხელახლა ავტორიზაციას</translation>
<translation id="7675756456029023637">ჰკითხეთ Ultimatum-ს</translation>
<translation id="769538538642757151">Ultimatum გაცნობებთ, თუ რაიმეს შემოწმება დაგჭირდებათ</translation>
<translation id="769906121737764913">Gemini Ultimatum Beta-ში დახურვა</translation>
<translation id="7716950018788545737">ამოცანა(ები) დასრულდა.</translation>
<translation id="7723388585204724670">ნაგულისხმევ Ultimatum-ზე გადაყენება</translation>
<translation id="77283119132245232">უზრუნველყოფს სისტემის კონტროლის სერვისს <ph name="BROWSER_NAME" />-ისთვის. თუ ეს სერვისი გათიშულია, ბრაუზერის მიერ შექმნილი ეფექტურობის ჩანაწერები არ მიიღებს მონაწილეობას სისტემის დონის მოვლენებში, როგორიცაა კონტექსტის გადართვა თუ მზა ნაკადების მოვლენები.</translation>
<translation id="7736869414036750079">თქვენი ორგანიზაცია მოითხოვს, რომ Ultimatum-ში შეხვიდეთ</translation>
<translation id="7747138024166251722">ინსტალერმა ვერ შექმნა დროებითი დირექტორია. გთხოვთ, გადაამოწმოთ დისკზე თავისუფალი სივრცე და პროგრამული უზრუნველყოფის დაყენების ნებართვა.</translation>
<translation id="7748969056734910029">ბოლო დროს არ ყოფილხართ. Ultimatum-მა ამოშალა <ph name="PERMISSION_1" /> და <ph name="PERMISSION_2" />.</translation>
<translation id="7761834446675418963">დააწკაპუნეთ თქვენს სახელზე Ultimatum-ის გასახსნელად და დაიწყეთ დათვალიერება.</translation>
<translation id="7777080907402804672">თუ სურათს არ ექნება სასარგებლო აღწერილობა, Ultimatum შეეცდება მის უზრუნველყოფას. აღწერილობების შესაქმნელად სურათები იგზავნება Google-ში. ამის გამორთვა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>
<translation id="778331955594035129">Ultimatum საჭიროებს მდებარეობაზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="7787950393032327779">როგორც ჩანს, პროფილს იყენებს სხვა Ultimatum პროცესი (<ph name="PROCESS_ID" />) სხვა კომპიუტერზე (<ph name="HOST_NAME" />). Ultimatum-მა ჩაკეტა პროფილი, ასე რომ იგი არ დაზიანდება. თუ დარწმუნებული ხართ, რომ არც ერთი სხვა პროცესი არ იყენებს ამ პროფილს, თქვენ შეგიძლიათ პროფილის გახსნა და Ultimatum-ის ხელახლა გაშვება.</translation>
<translation id="7792336732117553384">Ultimatum პროფილების &amp;მართვა</translation>
<translation id="7801699035218095297">Ultimatum ცდილობს პაროლების კოპირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი ამის დასაშვებად.</translation>
<translation id="7804364787702057554">თქვენი ანგარიში Ultimatum-ში</translation>
<translation id="7808348361785373670">Ultimatum-იდან ამოღება...</translation>
<translation id="7827099906024714326">Ultimatum საჭიროებს თქვენი ვინაობის დადასტურებას, სანამ მონაცემები Google ანგარიშში შეინახება და თქვენს მოწყობილობებში გამოიყენება. ახლა გასვლის შემთხვევაში, აღნიშნული მონაცემები წაიშლება.</translation>
<translation id="7832314606810669113">თქვენს ყველა მოწყობილობაში სანიშნეებისა და სხვა ინფორმაციის მისაღებად შედით Ultimatum-ში. შესვლის შემდეგ ეს სანიშნე შეინახება თქვენს Google ანგარიშში.</translation>
<translation id="7845233973568007926">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME" />-ის გამოყენებამდე თქვენი კომპიუტერი უნდა გადატვირთოთ.</translation>
<translation id="7847170235260850604">Ultimatum-ის გაშვება Windows-ის ჩართვისას</translation>
<translation id="7849037457735762883">გააგრძელეთ იქიდან, სადაც გაჩერდით: Ultimatum-ს შეუძლია თქვენი ჩანართების აღდგენა ყოველი გადატვირთვის შემდეგ. ამის ჩასართავად გადადით აქ:</translation>
<translation id="7869620795354551924">შენახული პაროლების გამოსაყენებლად მიჰყევით QR კოდს, ჩამოტვირთეთ Ultimatum iOS-ისთვის და შედით თქვენს Google ანგარიშში</translation>
<translation id="7872446069773932638">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="SECONDS" /> წამი</translation>
<translation id="7886087451482920026">მონიშნეთ ტექსტი Google Lens-ით</translation>
<translation id="7890208801193284374">თუ თქვენ აზიარებთ კომპიუტერს, თქვენი მეგობრები და ოჯახის წევრები შეძლებენ ინტერნეტ-გვერდების დამოუკიდებლად დათვალიერებას და Ultimatum-ის დაყენებას საკუთარი სურვილის შესაბამისად.</translation>
<translation id="7896673875602241923">Ultimatum-ში უკვე განხორციელდა შესვლა ამ კომპიუტერიდან, როგორც <ph name="ACCOUNT_EMAIL_LAST" />. გთხოვთ, შექმნათ Ultimatum-ის ახალი მომხმარებელი თქვენი ინფორმაციის ცალკე შესანახად.</translation>
<translation id="7904985524660297937">ცადეთ Gemini Ultimatum-ში</translation>
