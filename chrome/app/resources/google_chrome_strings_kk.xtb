<translation id="742463671275348370">{NUM_DEVICES,plural, =0{1 USB құрылғысын бір немесе бірнеше Ultimatum кеңейтімі пайдаланды}=1{1 USB құрылғысын бір немесе бірнеше Ultimatum кеңейтімі пайдаланып жатыр}other{# USB құрылғысын бір немесе бірнеше Ultimatum кеңейтімі пайдаланып жатыр}}</translation>
<translation id="7426611252293106642">Ultimatum дұрыс жұмыс істемеуі мүмкін, себебі оған Linux дистрибутивінде қолдау көрсетілмейді</translation>
<translation id="7437998757836447326">Ultimatum жүйесінен шығу</translation>
<translation id="7449333426561673451">{COUNT,plural, =1{Ultimatum 1 минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады.}other{Ultimatum # минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады.}}</translation>
<translation id="7450541714075000668">Мәтін көшірмесі жасалды</translation>
<translation id="7452987490177144319">{COUNT,plural, =1{Ultimatum 1 минут бойы пайдаланылмаса, ұйымыңыз браузерді пайдалану деректерін автоматты түрде жояды. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін. Қойындыларыңыз ашық болады.}other{Ultimatum # минут бойы пайдаланылмаса, ұйымыңыз браузерді пайдалану деректерін автоматты түрде жояды. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін. Қойындыларыңыз ашық болады.}}</translation>
<translation id="7477130805345743099">Ultimatum кез келген сайтты қауіпті байланыс арқылы жүктеу алдында сізге ескертеді.</translation>
<translation id="7481213027396403996">Ultimatum браузерінің ең күшті қорғанысын қолданыңыз</translation>
<translation id="749228101751499733">Аккаунтқа кірсеңіз, Ultimatum-нан Google аккаунтыңыздағы құпия сөздер мен т.б. ақпаратты пайдалана аласыз. <ph name="SHORTCUT" /> тіркесімі арқылы Google қызметтерінің параметрлерін өзгертуге болады.</translation>
<translation id="7496017508659652909">Ultimatum беттерді алдын ала жүктейді, осылайша браузерді пайдалану және іздеу әрекеті тез жүреді. <ph name="BEGIN_LINK" />Беттерді алдын ала жүктеу туралы толық ақпарат<ph name="END_LINK" /></translation>
