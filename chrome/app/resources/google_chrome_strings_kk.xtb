<translation id="6247557882553405851">Google Password Manager</translation>
<translation id="6251759518630934363">Стандартты қорғанысқа қарағанда сайттардағы көбірек деректерді талдау арқылы қауіпті сайттар, тіпті Google-ға бұрын белгісіз болған сайттар туралы ескертеді. Ultimatum ескертулерін өткізіп жіберуді таңдауға болады.</translation>
<translation id="6277547788421725101">Ата-анаңыз Ultimatum браузері үшін "Сайттарға, қолданбаларға және кеңейтімдерге арналған рұқсаттар" параметрін өшірді</translation>
<translation id="627882678981830918">Ultimatum-ды бейімдеп, басқарыңыз. Ultimatum-ды әдепкі браузер етіп орнатыңыз.</translation>
<translation id="6280042952415350607">Күшейтілген қорғаныс Ultimatum танымайтын сайттар үшін JavaScript оңтайландыру мүмкіндігін өшіреді.</translation>
<translation id="6288580400488258237">Ultimatum-ды әдепкі браузер ретінде орнатып, тапсырмалар жолағына бекітіңіз.</translation>
<translation id="6291089322031436445">Ultimatum Dev қолданбалары</translation>
<translation id="6291549208091401781">Ultimatum компьютердегі барлық пайдаланушылар үшін әлдеқашан орнатылған.</translation>
<translation id="6311220991371174222">Профильді ашу кезінде қате кеткендіктен, Ultimatum іске қосылмады. Оны қайта іске қосып көріңіз.</translation>
<translation id="6319856120645568262">Ultimatum-ға айналаңызды картаға түсіруге және қолыңызды бақылауға рұқсат қажет.</translation>
<translation id="6321592572353357376">"<ph name="EXTENSION_NAME" />" кеңейтімін қолдану үшін Ultimatum-ға кіруіңіз керек</translation>
<translation id="6326175484149238433">Ultimatum бағдарламасынан жою</translation>
<translation id="6327105987658262776">Ешқандай жаңарту жоқ.</translation>
<translation id="6334815226785304306">Ultimatum қолданбасын әдепкі браузер етіп орнату және тапсырмалар жолағына бекіту</translation>
<translation id="63540178978900677">Ultimatum енді әдепкі браузеріңіз емес. Оны әдепкі браузер ретінде орнату қажет пе?</translation>
<translation id="6360449101159168105">Бұл қойынды әрекетсіз тұрған кезде, Ultimatum жылдам жұмыс істеуі үшін, жад босатылды. Сіз бұл сайтты әрекетсіз тұру тізімінен әрдайым шығарып отыру опциясын таңдай аласыз.</translation>
<translation id="6388799252195623474">осы бетке қатысты көмек қажет</translation>
<translation id="6412673304250309937">Ultimatum браузерінде сақталған қауіпсіз емес сайттар тізімімен URL сілтемелерін салыстырып тексереді. Егер сайт құпия сөзіңізді ұрлағысы келсе немесе сіз зиянды файл жүктеп алған кезде, Ultimatum браузері URL мекенжайларын, сонымен қатар бет контенті бөліктерін, "Қауіпсіз шолу" функциясына жіберуі мүмкін.</translation>
<translation id="6417690341895039567">{COUNT,plural, =1{Ultimatum 1 минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады. Браузерді пайдалану деректері жойылады. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін.}other{Ultimatum # минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады. Браузерді пайдалану деректері жойылады. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін.}}</translation>
<translation id="6418662306461808273">Бұрыннан бар Ultimatum профиліне ауыстырылсын ба?</translation>
<translation id="6426623519983252346">Ultimatum iOS браузерін келесіде ашқанда, <ph name="FEATURE_NAME" /> функциясын пайдаланып көру туралы нұсқауды көресіз.</translation>
<translation id="6434035853014503219">Ultimatum-ды әдепкі браузер етіп таңдағаныңызға рақмет!</translation>
<translation id="6438015621983209660">Телефоныңыздағы Ultimatum браузерімен күшейтілген Safe Browsing мүмкіндіктерін кеңейтіңіз</translation>
<translation id="6442774133615368941">Ultimatum iOS қолданбасында камера көмегімен нәрселерді сатып алуға, аударуға және анықтауға болады.</translation>
<translation id="6473905796280459355">"Ultimatum туралы ақпарат" бетіне өту</translation>
<translation id="6481963882741794338">Жекелендіру және басқа мақсаттарды орындау үшін Ultimatum мен басқа Google қызметтерін байланыстырыңыз.</translation>
<translation id="648319183876919572">Күшейтілген Safe Browsing-нің қауіпті веб-сайттар мен файлдардан қорғау қабілеті жоғарырақ.</translation>
<translation id="6489302989675808168">Қосулы • Ultimatum бұл кеңейтімнің қайдан келгенін анықтай алмайды.</translation>
<translation id="6491330562720922580">Ultimatum браузерін мобильдік құрылғыларға жүктеп алуға арналған QR коды</translation>
<translation id="6493527311031785448">Ultimatum <ph name="AUTHENTICATION_PURPOSE" /> қолданып көрейін деп жатыр</translation>
<translation id="6497147134301593682">Ultimatum автоматты түрде жабылған</translation>
<translation id="6506909944137591434">Ultimatum айналаңыздың 3D картасын жасау үшін камераны пайдалануға рұқсат сұрайды.</translation>
<translation id="6515495397637126556"><ph name="PAGE_TITLE" /> - Ultimatum әзірлеуші нұсқасы</translation>
<translation id="6520670145826811516">Локацияны пайдалану үшін <ph name="BEGIN_LINK" />жүйе параметрлерінде<ph name="END_LINK" /> Ultimatum-ға рұқсат беріңіз.</translation>
<translation id="652948702951888897">Ultimatum тарихы</translation>
<translation id="6532945796722480006">Ultimatum Canary-дегі Gemini-ды ашу</translation>
<translation id="6585124893636629274">Ultimatum-дағы Gemini-ды жабу</translation>
<translation id="659498884637196217">Құрылғыдағы Google Құпия сөз менеджерінде</translation>
<translation id="6631524303639368205">Тоқтаған жерден жалғастырыңыз: Ultimatum соңғы сеанстағы қойындыларды қалпына келтірді. Мұны келесі бөлімде өшіруге болады:</translation>
<translation id="6632473616050862500">UltimatumOS Flex операциялық жүйесі <ph name="BEGIN_LINK_CROS_OSS" />ашық кодты бағдарламалық құрал<ph name="END_LINK_CROS_OSS" /> арқылы қолжетімді болады.</translation>
<translation id="6634299872736643004">Бұл параметрге енгізілген өзгерістер Ultimatum өшіп қосылғаннан кейін күшіне енеді.</translation>
<translation id="6660596345553328257">Ultimatum-ға кіру қажет пе?</translation>
<translation id="6664219008737641504">Құпия фразаны ұмытып қалған болсаңыз немесе осы параметрді өзгерту керек болса, аккаунтыңыздағы Ultimatum деректерін <ph name="SETTINGS_LINK" />.</translation>
<translation id="6676384891291319759">Интернетке кіру</translation>
<translation id="6679975945624592337">Ultimatum браузеріне фондық режимде жұмыс істеуге рұқсат беру</translation>
<translation id="6696915334902295848">Ultimatum бұл сайт үшін микрофонды пайдалануға рұқсат сұрайды.</translation>
<translation id="6706525880530967390">{count,plural, =1{Ultimatum браузері деректерді Google аккаунтыңызға сақтау және барлық құрылғыңызда пайдалануға рұқсат беру үшін жеке басыңызды растауы қажет. Қазір шықсаңыз, бұл деректер (1 элемент) жойылады.}other{Ultimatum браузері деректерді Google аккаунтыңызға сақтау және барлық құрылғыңызда пайдалануға рұқсат беру үшін жеке басыңызды растауы қажет. Қазір шықсаңыз, бұл деректер ({count} элемент) жойылады.}}</translation>
<translation id="6712881677154121168">Жүктеп алу қатесі: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="6718739135284199302">Ultimatum жылдамдығын арттырыңыз</translation>
<translation id="6734827584173583205">Жақында кірмедіңіз. Ultimatum <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> рұқсаттарын және тағы <ph name="COUNT" /> рұқсатты өшірді.</translation>
<translation id="6735387454586646204">UltimatumOS Flex жүйесі</translation>
<translation id="6750954913813541382">Емле қателерін түзету үшін Ultimatum браузерде терілетін мәтінді Google-ға жібереді.</translation>
<translation id="6760235774835597023">Ultimatum-ның V8 жүйесімен сайттар жылдам жұмыс істейді, бірақ Ultimatum-ның шабуылдарға төзімділігі сәл азаяды. Бұл параметр қосулы.</translation>
<translation id="677276454032249905">Ultimatum браузерінен бәрібір шығасыз ба?</translation>
<translation id="6794858689789885890">Ultimatum браузерін жапқан кезде құрылғыңыздан сайт деректерін үнемі жою</translation>
<translation id="6800285125190089494">iOS жүйесіне арналған Ultimatum-да сақталған құпия сөздер арқылы сайттарға жылдам кіріңіз.</translation>
<translation id="6831043979455480757">Аудару</translation>
<translation id="683440813066116847">mDNS трафигіне рұқсат беретін Ultimatum кіріс ережесі.</translation>
<translation id="6841242485723266823">Ultimatum профильдері ақпаратыңыздың әртүрлі бөліктерін бөлек сақтауға көмектеседі. Жаңа профильді қазір қосыңыз.</translation>
<translation id="684888714667046800">Интернетке қосылу мүмкін емес. Брандмауэр пайдалансаңыз, <ph name="PRODUCT_EXE_NAME" /> өнімінің рұқсат тізімінде екеніне көз жеткізіңіз.</translation>
<translation id="6859580922007887573">Жалғастыру үшін Tab пернесін басыңыз.</translation>
<translation id="6877155553248388166">іздеу аймағының төменгі оң жақ бұрышы: оң жақ <ph name="RIGHT" />%, төменгі жақ <ph name="BOTTOM" />%</translation>
<translation id="6881299373831449287">Ultimatum жаңартылуда</translation>
<translation id="6885412569789873916">Ultimatum Beta қолданбалары</translation>
<translation id="6893363893008038481">Аккаунтты Ultimatum-нан өшіру</translation>
<translation id="6896758677409633944">Көшіру</translation>
<translation id="6908182077349113099">Құпия сөздеріңіз, бетбелгілеріңіз және тарихыңыз құрылғыларда синхрондалады. Әдепкі браузеріңізді Ultimatum-ға жаңартып, өзіңізге таныс және ұнайтын функцияларды оңай пайдаланыңыз.</translation>
<translation id="6930294499209825">Google бағдарламалық құралын жаңартып отырады. Егер бұл қызмет өшірілген немесе тоқтатылған болса, Google бағдарламалық құралыңыз жаңартылмайды. Нәтижесінде қауіпсіздік ақауларын жою мүмкін болмай, функциялар жұмыс істемеуі мүмкін. Бұл қызмет пайдаланылатын Google бағдарламалық құралы болмаса, өздігінен жойылады.</translation>
<translation id="6933858244219479645">UltimatumOS жүйесі</translation>
<translation id="6938166777909186039">Ultimatum-ның жаңа нұсқаларын алып тұру үшін Windows 10 не одан кейінгі операциялық жүйе керек болады. Бұл компьютерде Windows 8.1 нұсқасы орнатылған.</translation>
<translation id="6943584222992551122">Бұл адамның браузерді пайдалану деректері құрылғыдан жойылады. Деректерді қалпына келтіру үшін Ultimatum браузеріне <ph name="USER_EMAIL" /> болып кіріңіз.</translation>
<translation id="6965382102122355670">Жарайды</translation>
<translation id="6967962315388095737">mDNS трафигіне рұқсат беретін Ultimatum Beta кіріс ережесі.</translation>
<translation id="6979589607440534284">Неліктен Ultimatum кейбір файлдарды блоктайтыны туралы ақпарат жаңа қойындыдан ашылады.</translation>
<translation id="6985817499499247940">Браузерді жылдам пайдалану үшін Ultimatum-ды автоматты түрде іске қосады.</translation>
<translation id="6991926986715044139">Google Lens таңбашасын үнемі көрсету</translation>
<translation id="6999131147875565462">Ultimatum жылдам жұмыс істейді және JavaScript қолданатын функциялар тиісті түрде жұмыс істеуі керек.</translation>
<translation id="7011190694940573312">Орнатылмады, себебі операциялық жүйенің бұл нұсқасына қолдау көрсетілмейді.</translation>
<translation id="7024536598735240744">Пакеттен шығару қатесі: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7025789849649390912">Орнату тоқтап қалды.</translation>
<translation id="7025800014283535195">Осы жерде Ultimatum профильдерін ауыстыра аласыз.</translation>
<translation id="7047386856539490735">Бұл нәтижелер пайдалы ма?</translation>
<translation id="7051685429025310665">Жақында кірмедіңіз. Ultimatum <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" /> рұқсаттарын өшірді.</translation>
<translation id="7059914902409643750">Ultimatum браузерін өз талғамыңызға сай реттеңіз</translation>
<translation id="7060643578009939353">Бұл бейнені Google Lens-бен іздеу</translation>
<translation id="7071827361006050863">Ultimatum жақын арада браузерді пайдалану деректерін жояды</translation>
<translation id="7085332316435785646">Google қызметтерінде жекелендірілген мүмкіндіктерді пайдалану үшін Ultimatum тарихын қосу-қоспау нұсқасын таңдаңыз.</translation>
<translation id="7088681679121566888">Ultimatum жаңартылған.</translation>
<translation id="7096221564931416126">Google Lens-бен іздеу үшін кез келген мәтінді не суретті таңдаңыз.</translation>
<translation id="7098166902387133879">Ultimatum микрофоныңызды пайдалануда.</translation>
<translation id="7099479769133613710">&amp;UltimatumOS жүйесін жаңарту үшін қайта іске қосыңыз</translation>
<translation id="7106741999175697885">Тапсырмалар реттегіші – Ultimatum</translation>
<translation id="7121179479711575744">Ultimatum аккаунтына кіру</translation>
<translation id="7140653346177713799">{COUNT,plural, =0{Ultimatum браузерінің жаңа нұсқасы шықты. Ол браузерді өшіріп, қайта іске қосқанда орнатылады.}=1{Ultimatum браузерінің жаңа нұсқасы шықты. Ол браузерді өшіріп, қайта іске қосқанда орнатылады. Инкогнито терезесі қайта ашылмайды.}other{Ultimatum браузерінің жаңа нұсқасы шықты. Ол браузерді өшіріп, қайта іске қосқанда орнатылады. # инкогнито терезесі қайта ашылмайды.}}</translation>
<translation id="7155997830309522122">Егер өзгертсеңіз, Ultimatum браузерінде сақталған құпия сөзді де жаңасына өзгертіңіз.</translation>
<translation id="7161904924553537242">Ultimatum жүйесіне қош келдіңіз</translation>
<translation id="7193885263065350793">Ұйымыңыз Ultimatum-ды <ph name="TIMEOUT_DURATION" /> бойы пайдаланбаған кезде жабады.</translation>
<translation id="7242029209006116544">Бақыланатын аккаунт арқылы кіріп, оның әкімшісіне Ultimatum профиліңізді басқару мүмкіндігін бердіңіз. Қолданбалар, бетбелгілер, журнал, құпия сөздер сияқты Ultimatum деректеріңіз және басқа параметрлер біржола <ph name="USER_NAME" /> пайдаланушысына байланыстырылады. Бұл деректерді Google аккаунт бақылау тақтасы арқылы жоя аласыз, бірақ бұл деректерді басқа аккаунтмен байланыстыра алмайсыз. <ph name="LEARN_MORE" /></translation>
<translation id="7285616922384953075">Ultimatum-ды <ph name="MANAGER" /> басқарады</translation>
<translation id="7285990705317078173">Бағаларды бақылау және кез келген сайтта баға түскен кезде, хабарландырулар алу үшін телефоныңызға Ultimatum-ды жүктеп алыңыз.</translation>
<translation id="7288567540154601580">Қойындылар мен кеңейтімдер</translation>
<translation id="7296210096911315575">Пайдалану және қауіпсіздік туралы маңызды ақпарат</translation>
<translation id="7302361266603927550">Ultimatum деректерінің кейбірі Google аккаунтыңызға әлі сақталмаған. Шығу алдында бірнеше минут күтіп көріңіз. Қазір шықсаңыз, бұл деректер жойылады.</translation>
<translation id="7306401458628386911">Браузерден шолуды жылдам бастау: Windows жұмысын бастағанда, Ultimatum іске қосылады.</translation>
<translation id="7308322188646931570">Файлдарды жүктеп алу үшін Ultimatum браузеріне сақтау орнын пайдалану құқығы қажет</translation>
<translation id="7339898014177206373">Жаңа терезе</translation>
<translation id="7352651011704765696">Бірнәрсе дұрыс емес</translation>
<translation id="7386878009611068389">Ата-анаңыздың таңдауымен интернетті қауіпсіз пайдалану үшін <ph name="USER_EMAIL_ADDRESS" /> ретінде кірген Ultimatum профиліңізге ауысыңыз.</translation>
<translation id="7398801000654795464">Ultimatum жүйесіне <ph name="USER_EMAIL_ADDRESS" /> ретінде кірдіңіз. Қайта кіру үшін бірдей аккаунтты пайдаланыңыз.</translation>
<translation id="7412494426921990001">Ultimatum мәзірін басыңыз.</translation>
<translation id="7419819959108735624">Google Lens-бен іздеу үшін кез келген нәрсені таңдаңыз.</translation>
<translation id="742463671275348370">{NUM_DEVICES,plural, =0{1 USB құрылғысын бір немесе бірнеше Ultimatum кеңейтімі пайдаланды}=1{1 USB құрылғысын бір немесе бірнеше Ultimatum кеңейтімі пайдаланып жатыр}other{# USB құрылғысын бір немесе бірнеше Ultimatum кеңейтімі пайдаланып жатыр}}</translation>
<translation id="7426611252293106642">Ultimatum дұрыс жұмыс істемеуі мүмкін, себебі оған Linux дистрибутивінде қолдау көрсетілмейді</translation>
<translation id="7437998757836447326">Ultimatum жүйесінен шығу</translation>
<translation id="7449333426561673451">{COUNT,plural, =1{Ultimatum 1 минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады.}other{Ultimatum # минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады.}}</translation>
<translation id="7450541714075000668">Мәтін көшірмесі жасалды</translation>
<translation id="7452987490177144319">{COUNT,plural, =1{Ultimatum 1 минут бойы пайдаланылмаса, ұйымыңыз браузерді пайдалану деректерін автоматты түрде жояды. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін. Қойындыларыңыз ашық болады.}other{Ultimatum # минут бойы пайдаланылмаса, ұйымыңыз браузерді пайдалану деректерін автоматты түрде жояды. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін. Қойындыларыңыз ашық болады.}}</translation>
<translation id="7477130805345743099">Ultimatum кез келген сайтты қауіпті байланыс арқылы жүктеу алдында сізге ескертеді.</translation>
<translation id="7481213027396403996">Ultimatum браузерінің ең күшті қорғанысын қолданыңыз</translation>
<translation id="749228101751499733">Аккаунтқа кірсеңіз, Ultimatum-нан Google аккаунтыңыздағы құпия сөздер мен т.б. ақпаратты пайдалана аласыз. <ph name="SHORTCUT" /> тіркесімі арқылы Google қызметтерінің параметрлерін өзгертуге болады.</translation>
<translation id="7496017508659652909">Ultimatum беттерді алдын ала жүктейді, осылайша браузерді пайдалану және іздеу әрекеті тез жүреді. <ph name="BEGIN_LINK" />Беттерді алдын ала жүктеу туралы толық ақпарат<ph name="END_LINK" /></translation>
<translation id="7514258452813684157">"Google-ды жаңарту құралы" қызметі</translation>
<translation id="7515191208480168435">Google Lens-ге оңай қол жеткізу үшін оны бекітуге болады.</translation>
<translation id="7535429826459677826">Ultimatum Dev</translation>
<translation id="7543146567111253230">Осы бетбелгі және басқа да көптеген нәрселер барлық құрылғыңызда болуы үшін, Ultimatum-ға кіріңіз.</translation>
<translation id="756134248912568991">Келесі жолы Ultimatum-ды <ph name="DEVICE_TYPE" /> құрылғысынан ашқан кезде, қойындылар топтарын пайдалану туралы нұсқауды көресіз.</translation>
<translation id="756809126120519699">Ultimatum деректері өшірілді</translation>
<translation id="7572537927358445944">Өшірулі • Ultimatum бұл кеңейтімнің қайдан келгенін анықтай алмайды.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> орнату құралы</translation>
<translation id="7596160425942761210">Хабарлардағы, құжаттардағы және басқа қолданбалардағы сілтемелерді басып, Ultimatum браузерін кез келген уақытта пайдалана аласыз.</translation>
<translation id="7602868996817972616">Google-дан осы бет туралы сұрау</translation>
<translation id="760353356052806707">Компьютеріңіздегі басқа бір бағдарлама жаңа қолданба қосты, ол Ultimatum жұмысын өзгертуі мүмкін.

<ph name="EXTENSION_NAME" /></translation>
<translation id="7606334485649076285">UltimatumOS Flex</translation>
<translation id="7626072681686626474">Бұл құрылғыны пайдаланбас бұрын, <ph name="MANAGER" /> келесі Қызмет көрсету шарттарын оқып, қабылдауыңызды талап етеді. Бұл шарттар UltimatumOS Шарттарын толықтырмайды, өзгертпейді және шектемейді.</translation>
<translation id="7627609214560473136">Деректеріңізді қорғау үшін Ultimatum-ға сіз соңғы уақытта кірмеген сайттардың рұқсаттарын өшіруге рұқсат беріңіз.</translation>
<translation id="7629695634924605473">Құпия сөздеріңіз ұрланған жағдайда, Ultimatum бұл туралы хабарлайды.</translation>
<translation id="7641148173327520642">Жүйе әкімшісі Ultimatum браузерін <ph name="TARGET_URL_HOSTNAME" /> бетіне кіру кезінде <ph name="ALTERNATIVE_BROWSER_NAME" /> ашылатын етіп конфигурациялады.</translation>
<translation id="7641448682796883218">Ultimatum-мен жұмыс істеу бойынша кеңес: Күшейтілген Safe Browsing</translation>
<translation id="7649070708921625228">Анықтама</translation>
<translation id="7651907282515937834">Ultimatum Enterprise логотипі</translation>
<translation id="76531479118467370">Ultimatum жүктеп алуды блоктады, себебі Safe Browsing функциясы өшірілді және файлды растау мүмкін емес.</translation>
<translation id="7655472416356262023">Аккаунтты Ultimatum-нан өшіру</translation>
<translation id="7658239707568436148">Бас тарту</translation>
<translation id="7670287553302121848">Ultimatum аккаунтын қайта аутентификациялау қажет.</translation>
<translation id="7675756456029023637">Ultimatum-нан сұрау</translation>
<translation id="769538538642757151">Тексеруге қажетті нәрсе болса, Ultimatum сізге хабар береді</translation>
<translation id="769906121737764913">Ultimatum Beta-дағы Gemini-ды жабу</translation>
<translation id="7716950018788545737">Тапсырмалар аяқталды.</translation>
<translation id="7723388585204724670">Ultimatum-ның әдепкі күйіне қайта орнату</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME" /> браузеріне арналған жүйені трассалау қызметтерін ұсынады. Қызмет өшірілсе, браузер жасаған өнімділік трассалары контекст ауыстыру және дайын ағын оқиғалары сияқты жалпы жүйелік оқиғаларды қамтымайды.</translation>
<translation id="7736869414036750079">Ұйымыңыз Ultimatum-ға кіруді талап етеді</translation>
<translation id="7747138024166251722">Орнату құралы уақытша каталогті жасай алмады. Дисктегі бос орынды және бағдарламалық жасақтама рұқсатын тексеріңіз.</translation>
<translation id="7748969056734910029">Жақында кірмедіңіз. Ultimatum <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> рұқсаттарын өшірді.</translation>
<translation id="7761834446675418963">Ultimatum ашып, шолуды бастау үшін атыңызды басыңыз.</translation>
<translation id="7777080907402804672">Егер суреттің пайдалы сипаттамасы болмаса, Ultimatum оны өзі ұсынып көреді. Сипаттамалар жасау үшін суреттер Google-ға жіберіледі. Бұл функцияны кез келген уақытта параметрлерден өшіріп қоюға болады.</translation>
<translation id="778331955594035129">Ultimatum бұл сайт үшін локацияны пайдалануға рұқсат сұрайды.</translation>
<translation id="7787950393032327779">Профиль басқа компьютердегі (<ph name="HOST_NAME" />) басқа Ultimatum процесінде(<ph name="PROCESS_ID" />) пайдаланылуда. Бүлініп қалмауы үшін Ultimatum профильді құлыптап қойды. Басқа процестер бұл профильді пайдаланбайтынына көз жеткізсеңіз, профильді құлыптан ашып, Ultimatum қайта іске қосуыңызға болады.</translation>
<translation id="7792336732117553384">&amp;Ultimatum профильдерін басқару</translation>
<translation id="7801699035218095297">Ultimatum құпия сөздерді көшіргісі келеді. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="7804364787702057554">Ultimatum-дағы аккаунтыңыз</translation>
<translation id="7808348361785373670">Ultimatum ішінен жою…</translation>
<translation id="7827099906024714326">Ultimatum браузері деректерді Google аккаунтыңызға сақтау және барлық құрылғыңызда пайдалануға рұқсат беру үшін жеке басыңызды растауы қажет. Қазір шықсаңыз, бұл деректер жойылады.</translation>
<translation id="7832314606810669113">Бетбелгілер мен басқа ақпаратты барлық құрылғыдан алу үшін Ultimatum аккаунтына кіріңіз. Аккаунтқа кіргеннен кейін, бұл бетбелгі Google аккаунтыңызға сақталады.</translation>
<translation id="7845233973568007926">Орнатқаныңыз үшін рақмет. <ph name="BUNDLE_NAME" /> пайдаланбас бұрын компьютерді өшіріп қосуыңыз керек.</translation>
<translation id="7847170235260850604">Windows жұмысын бастағанда, Ultimatum-ды іске қосады</translation>
<translation id="7849037457735762883">Тоқтаған жерден жалғастырыңыз: өшіріп қосқан сайын, Ultimatum қойындыларды қалпына келтіре алады. Мұны қосу үшін келесі бөлімге өтіңіз:</translation>
<translation id="7869620795354551924">Сақталған құпия сөздерді пайдалану үшін QR кодын қолданып, iOS-ке арналған Ultimatum браузерін жүктеп алып, Google аккаунтына кіріңіз.</translation>
<translation id="7872446069773932638">Жүктеп алынып жатыр… <ph name="SECONDS" /> секунд қалды.</translation>
<translation id="7886087451482920026">Google Lens көмегімен мәтінді таңдаңыз</translation>
<translation id="7890208801193284374">Компьютерді бөлісетін болсаңыз, достарыңыз бен жақындарыңыз интернетке бөлек кіріп, Ultimatum браузерін қалауларынша реттей алады.</translation>
<translation id="7896673875602241923">Әлдекім бұл компьютерден Ultimatum жүйесіне <ph name="ACCOUNT_EMAIL_LAST" /> болып кірген. Ақпаратты бөлек сақтау үшін жаңа Ultimatum пайдаланушысын жасаңыз.</translation>
<translation id="7904985524660297937">Ultimatum-дағы Gemini-ды пайдаланып көру</translation>
<translation id="7917876797003313048">Кірген Google аккаунттарыңызды басқара аласыз. Google аккаунттарыңыз Ultimatum браузері, Play Store, Gmail және тағы басқа қызметтерде пайдаланылады. Егер отбасы мүшесі сияқты әлдебіреудің аккаунтын қосқыңыз келсе, жаңа пайдаланушыны <ph name="DEVICE_TYPE" /> құрылғыңызға қосыңыз. <ph name="LINK_BEGIN" />Толығырақ<ph name="LINK_END" /></translation>
<translation id="7936702483636872823">Ultimatum жүктеп алуды блоктады, себебі бұл – алдамшы файл және ол құрылғыңызға күтпеген өзгерістер енгізуі мүмкін.</translation>
<translation id="7951272445806340501">Жаңарту күшіне енуі үшін UltimatumOS Flex операциялық жүйесін өшіріп қосу керек.</translation>
<translation id="7959172989483770734">Ultimatum профильдерін басқару</translation>
<translation id="7962410387636238736">Windows XP және Windows Vista жүйелеріне қолдау көрсетілмейтіндіктен, бұл компьютер енді Ultimatum жаңартылған нұсқаларын қабылдамайды</translation>
<translation id="8004582292198964060">Браузер</translation>
<translation id="8005666035647241369">Құрылғыдағы Google Құпия сөз менеджеріне</translation>
<translation id="8008534537613507642">Ultimatum қайта орнату</translation>
<translation id="8009904340233602924">Ultimatum браузерін аккаунтсыз қолдану</translation>
<translation id="8010081455002666927">Автоанықтау</translation>
<translation id="8013993649590906847">Егер суреттің пайдалы сипаттамасы болмаса, Ultimatum оны өзі ұсынып көреді. Сипаттамалар жасау үшін суреттер Google-ға жіберіледі.</translation>
<translation id="8019103195866286235">Бұл кеңейтімді әзірлеушісі жариялаудан бас тартқан, сондықтан ол қауіпті болуы мүмкін. Сіз кірген сайттардағы деректеріңізді, оның ішінде жеке ақпаратыңызды бұдан былай көрмеуі және өзгерте алмауы үшін, оны Ultimatum-нан жойыңыз.</translation>
<translation id="8040768861829554732">Кеңейтімді қолдану үшін Ultimatum-ға кіруіңіз керек</translation>
<translation id="8041795619940733262">Google-дан<ph name="LINE_BREAK" />осы қойынды туралы сұраңыз</translation>
<translation id="80471789339884597">Орнатқаныңыз үшін рақмет. <ph name="BUNDLE_NAME" /> пайдаланбас бұрын барлық браузерді жауып, қайта ашуыңыз керек.</translation>
<translation id="8064015586118426197">UltimatumOS Flex</translation>
<translation id="8064965390968184078">1. Төмендегі <ph name="BUTTON_LABEL" /> түймесін басыңыз.
2. Windows параметрлерінде <ph name="BUTTON_2" /> түймесін басыңыз.
3. Ultimatum-ға жылдам кіру үшін, оны тапсырмалар жолағына бекітіңіз. Ол үшін Windows хабарландыруындағы <ph name="BUTTON_3" /> түймесін басыңыз.</translation>
<translation id="8074398340364918139">Белгілі бір Ultimatum функциясын немесе кеңейтімін іздеу үшін мекенжай жолағына оның жылдам пәрменін енгізіп, содан кейін таңдалған пернені басыңыз.</translation>
<translation id="8077579734294125741">Ultimatum басқа профильдері</translation>
<translation id="8086881907087796310">Орнатылмады, себебі компьютер минималды жабдық талаптарына жауап бермейді.</translation>
<translation id="8113883687556086139">Ultimatum деректерін <ph name="ACCOUNT_EMAIL" /> аккаунтында қолдану және сақтау үшін жеке басыңызды растаңыз.</translation>
<translation id="8115695070094288807">Ultimatum-ды сізге бейімдеп жатырмыз...</translation>
<translation id="8118331347066725040">Lens-бен іздеуге қатысты пікіріңізді жазыңыз.</translation>
<translation id="8129812357326543296">Ultimatum туралы ақпарат</translation>
<translation id="813913629614996137">Дайындауда…</translation>
<translation id="8162006532256575008">Ultimatum браузерін аккаунтсыз қолдану</translation>
<translation id="8172231188687329735">Құпия сөздерді кез келген жерде сақтау үшін Ultimatum қолданбасын жүктеп алыңыз.</translation>
<translation id="8177472873527554730">Беттен ештеңе табылмады.</translation>
<translation id="8221491193165283816">Әдетте хабарландыруларға тыйым саласыз. Осы сайттың сізге хабарландыру жіберуіне рұқсат ету үшін осы жерді басыңыз.</translation>
<translation id="8253851811470049684">Кез келген қолданбадағы сілтемелерді Ultimatum-нан ашып, браузерді тапсырмалар жолағында қолжетімді етіп қойыңыз.</translation>
<translation id="8255190535488645436">Ultimatum камераңыз бен микрофоныңызды пайдалануда.</translation>
<translation id="8267953129876836456">Ultimatum тексеруге қажетті қауіпсіздікке қатысты кейбір ұсыныстарды тапты</translation>
<translation id="8286862437124483331">Ultimatum құпия сөздерді көрсетпек. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="829923460755755423">Google Password Manager таңбашасын қосу</translation>
<translation id="8313851650939857356">Іске қосу қатесі: <ph name="STARTUP_ERROR" />.</translation>
<translation id="8321888067342493336">Сурет түрінде сақтау</translation>
<translation id="8336463659890584292">Сайт беттегі сілтемелерді құпия түрде алдын ала жүктеуді сұрағанда, Ultimatum браузері Google серверлерін пайдаланады. Осылайша жеке деректеріңіз алдын ала жүктелетін сайттан жасырылады, бірақ Google алдын ала жүктелетін сайттарды біледі.</translation>
<translation id="8342675569599923794">Бұл файл қауіпті болғандықтан, Ultimatum оны бөгеді.</translation>
<translation id="835927394551949760">Google-дан сұрау</translation>
<translation id="8362914115861174987">Аударма тілі:</translation>
<translation id="8366770919198174997">Өнімділік азаяды, бірақ Ultimatum шабуылдарға төзімді болады.</translation>
<translation id="8367705492654390392">Кез келген нәрсе сұраңыз</translation>
<translation id="8370517070665726704">Copyright <ph name="YEAR" /> Google LLC. Барлық құқықтары қорғалған.</translation>
<translation id="8377158135256176353">Ultimatum Canary-дегі Gemini-ды қосу/өшіру</translation>
<translation id="8387459386171870978">Ultimatum-ды пайдалана беру</translation>
<translation id="8394720698884623075">URL мекенжайларын Ultimatum браузерінде сақталған қауіпсіз емес сайттар тізімімен салыстырып тексереді.</translation>
<translation id="8403038600646341038">Компьютер экранындағы Ultimatum логотипі.</translation>
<translation id="8418845734693287262">UltimatumOS деректеріңізді синхрондай алмады, себебі аккаунтыңызға кіру мәліметтері ескірген.</translation>
<translation id="842386925677997438">Ultimatum-ның қауіпсіздік құралдары</translation>
<translation id="8425765582779547329">Ата-анаңыздың таңдауымен интернетті қауіпсіз пайдалану үшін Ultimatum-ға кіріңіз.</translation>
<translation id="842852285618875960">Ultimatum-ның <ph name="BOOKMARK_LIMIT" /> бетбелгі шегіне жеттіңіз, сондықтан кейбір бетбелгілер Google аккаунтыңызға әлі сақталмады.

Кейбір бетбелгілерді жоймайынша, аккаунтыңызға жаңа бетбелгілерді сақтау мүмкін емес. Аккаунттан қазір шықсаңыз, сақталмаған бетбелгілер жойылады.</translation>
<translation id="8433638294851456451">Осы жерден Android телефонына нөмір жіберу үшін екі құрылғыда да Ultimatum браузеріне кіріңіз.</translation>
<translation id="8458117863387545390">Телефоныңызға Ultimatum-ды орнатыңыз</translation>
<translation id="8496177819998570653">Google P&amp;assword Manager</translation>
<translation id="8498858610309223613">Ultimatum браузеріне қазір ғана қауіпсіздік бойынша арнайы жаңартылған нұсқа қолданылды. Оны қазір қайта ашсаңыз, ондағы қойындылар қалпына келтіріледі.</translation>
<translation id="8516431725144212809">Ultimatum болжамымен анықталған қызығушылықтарыңыз</translation>
<translation id="8521348052903287641">mDNS трафигіне рұқсат беретін Ultimatum Dev кіріс ережесі.</translation>
<translation id="852529348814672339">Ultimatum-ды осы тілде көрсету</translation>
<translation id="8533056045953418157">Ultimatum-ды әдепкі PDF көру құралы ретінде орнату</translation>
<translation id="8555465886620020932">Қызмет қатесі: <ph name="SERVICE_ERROR" />.</translation>
<translation id="856656450041460113">Тілдер тізімін іздеу</translation>
<translation id="8575047640889685742">Google аккаунтындағы барлық Ultimatum дерегін шифрлау үшін <ph name="BEGIN_LINK" />жеке құпия фразаны<ph name="END_LINK" /> пайдаланыңыз. Google Pay қызметіндегі төлеу әдістері мен мекенжайлары шифрланбайды. Ultimatum-ның браузерді қолдану тарихы синхрондалмайды.</translation>
<translation id="8601359445272098721">Жаңалық! Енді "экранды аудару" түймесін басу арқылы экрандағы мәтін мен суреттерді де аудара аласыз.</translation>
<translation id="8614913330719544658">Ultimatum жауап бермейді. Қазір қайта іске қосасыз ба?</translation>
<translation id="861702415419836452">Ultimatum браузеріне айналаңыздың 3D картасын жасау үшін камераны пайдалану рұқсаты керек.</translation>
<translation id="8624541899164515475">Параметрлер, жаңа қойындыда ашылады.</translation>
<translation id="8625237574518804553">{0,plural, =1{Ultimatum браузері 1 минуттан кейін қайта іске қосылады}other{Ultimatum браузері # минуттан кейін қайта іске қосылады}}</translation>
<translation id="8637932705841171563">Терезені бөлісу үшін жүйе параметрлерінде Ultimatum-ға экран жазуға рұқсат беріңіз.</translation>
<translation id="8641606876632989680">Ұрланған құпия сөзбен кірген кезде, Ultimatum сізге хабарлайды.</translation>
<translation id="8647930742055103497">Барлығын Ultimatum-да сақтаңыз</translation>
<translation id="8656634243791296665">Ultimatum Dev-дегі Gemini-ды ашу</translation>
<translation id="8669527147644353129">Ultimatum Helper</translation>
<translation id="8679801911857917785">Сонымен қатар Ultimatum бастапқы бетін де бақылайды.</translation>
<translation id="8712637175834984815">Түсінікті</translation>
<translation id="8712767363896337380">Дайын болып қалды. Жаңартуды аяқтау үшін Ultimatum браузерін қайта іске қосыңыз.</translation>
<translation id="8718062187489036808">Ultimatum жүйесінен шығу</translation>
<translation id="8725440680697264016">Google-дан осы бейне жайында сұрау</translation>
<translation id="873133009373065397">Ultimatum әдепкі браузерді анықтай не орната алмайды</translation>
<translation id="8747073452963259673">іздеу аймағының төменгі сол жақ бұрышы: сол жақ <ph name="LEFT" />%, төменгі жақ <ph name="BOTTOM" />%</translation>
<translation id="8748735421235723888">Ultimatum әрекетсіз қойындылардағы жадты босатады. Мұның нәтижесінде белсенді қойындылар мен басқа қолданбаларға қосымша компьютер ресурстары үлестіріліп, Ultimatum жылдам жұмыс істейді. Әрекетсіз қойындыларды ашқанда, олар автоматты түрде қайтадан белсенді болады. <ph name="BEGIN_LINK" />Жад үнемдегіш туралы толық ақпарат<ph name="END_LINK" /></translation>
<translation id="8765470054473112089">Мекенжай жолағында немесе іздеу өрісінде терген кезде, Ultimatum браузері жақсырақ ұсыныстар алу үшін тергеніңізді әдепкі іздеу жүйесіне жібереді. Бұл Инкогнито режимінде өшірілген.</translation>
<translation id="8781673607513845160">Камераны пайдалану үшін <ph name="BEGIN_LINK" />жүйе параметрлерінде<ph name="END_LINK" /> Ultimatum-ға рұқсат беріңіз.</translation>
<translation id="878572486461146056">Орнату қатесі: желі әкімшісі орнатуға рұқсат бермейтін топтық саясатты қолданды: <ph name="INSTALL_ERROR" /></translation>
<translation id="8796919761992612392">Ultimatum браузеріңізді б&amp;ейімдеу</translation>
<translation id="8798550110818026746">Ұйымыңыз сіздегі бетбелгілер, тарих және құпия сөздер сияқты браузерді пайдалану деректерін көріп, басқара алады. Ол басқа Ultimatum профильдеріндегі браузерді пайдалану деректерін көре алмайды.</translation>
<translation id="8813277370772331957">Кейінірек еске салу</translation>
<translation id="8821043148920470810">Ultimatum-ның жаңа нұсқаларын алып тұру үшін Windows 10 не одан кейінгі операциялық жүйе керек болады. Бұл компьютерде Windows 7 нұсқасы орнатылған.</translation>
<translation id="8823341990149967727">Ultimatum ескірген</translation>
<translation id="8834965163890861871">Ultimatum құпия сөздерді өзгерткісі келеді. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="8851180723659088381">{NUM_EXTENSIONS,plural, =1{Ultimatum мұны өшіруге кеңес береді.}other{Ultimatum бұларды өшіруге кеңес береді.}}</translation>
<translation id="8862326446509486874">Жүйе деңгейінде орнату үшін тиісті құқықтарыңыз жоқ. Әкімші ретінде орнату құралын қайта іске қосып көріңіз.</translation>
<translation id="8865415417596392024">Аккаунтыңыздағы Ultimatum деректері</translation>
<translation id="8883862939660515976">Google Lens-ден осы сурет жайында сұрау</translation>
<translation id="8914504000324227558">Ultimatum қолданбасын қайта іске қосу</translation>
<translation id="8922193594870374009">Нөмірді <ph name="ORIGIN" /> құрылғысынан Android телефонына жіберу үшін екі құрылғыда да Ultimatum браузеріне кіріңіз.</translation>
<translation id="8922998289262614701">Ultimatum-нан бұл қолданба деректерін өшіру</translation>
<translation id="8925636929359899517">Біз бұл қызметті жақсарту үшін ақпаратты пайдаланамыз. <ph name="BEGIN_LINK1" />Құпиялық саясаты<ph name="END_LINK1" /> мен <ph name="BEGIN_LINK2" />Қызмет көрсету шарттарын<ph name="END_LINK2" /> қараңыз.</translation>
<translation id="8936233353620149764">Ultimatum-дағы Gemini-ды қосу/өшіру</translation>
<translation id="8948460679427074738">Бұл кеңейтім пайдаланушы деректерін қалай жинап, қолданатыны сияқты құпиялық шараларын жарияламаған. Ultimatum оны өшіруді ұсынады.</translation>
<translation id="8958307504142971576">Енді Ultimatum-дағы функциялар көбейді.</translation>
<translation id="8991530961471831170">Ultimatum-дағы Gemini-ды ашу</translation>
<translation id="8992769679401294069">Деректер құпия фразаңызбен шифрланды. Google аккаунтыңызда Ultimatum деректерін пайдалану және сақтау үшін оны енгізіңіз.</translation>
<translation id="8999117580775242387">HTTPS қолжетімді болмаған кезде, Ultimatum сізге ескертпестен, қауіпті байланысты пайдаланады.</translation>
<translation id="8999208279178790196">{0,plural, =0{Ultimatum браузерінің жаңартылған нұсқасы қолжетімді}=1{Ultimatum браузерінің жаңартылған нұсқасы қолжетімді}other{Ultimatum браузерінің жаңартылған нұсқасы # күннен бері қолжетімді}}</translation>
<translation id="9010418943148193727">Әдепкі іздеу жүйесі Ultimatum-нан тыс өзгертілді. Сізді қорғау үшін Ultimatum оны қайта орнатты.</translation>
<translation id="9014771989710951291">Ultimatum-ды бірнеше ұйым басқарады</translation>
<translation id="9024318700713112071">Ultimatum-ды әдепкі браузер етіп орнату</translation>
<translation id="9066987883552592250">Ultimatum Canary-дегі Gemini-ды жабу</translation>
<translation id="9090566250983691233">Неліктен Ultimatum кейбір файлдарды блоктайтыны туралы ақпарат алыңыз</translation>
<translation id="9106236359747881194">Іздеу үшін мәтін таңдаңыз.</translation>
<translation id="911206726377975832">Сонымен қатар шолу деректеріңізді жоясыз ба?</translation>
<translation id="9134482777260927479">Үй тапсырмасын орындауға көмектесу</translation>
<translation id="9138603949443464873">Өзгерістер енуі үшін, Ultimatum браузерін қайта қосыңыз</translation>
<translation id="9148058034647219655">Шығу</translation>
<translation id="919706545465235479">Синхрондауды бастау үшін Ultimatum жүйесін жаңартыңыз</translation>
<translation id="922152298093051471">Ultimatum-ды реттеу</translation>
<translation id="93760716455950538">UltimatumOS Flex операциялық жүйесін өшіріп қосу</translation>
<translation id="943390475793766444">Ultimatum бұл файлды сканерлеуді ұсынады, себебі ол қауіпті болуы мүмкін.</translation>
<translation id="945522503751344254">Пікір жіберу</translation>
<translation id="983803489796659991">Орнатылмады, себебі жаңарту серверінде қолданбаға арналған хештеу деректері жоқ.</translation>
<translation id="989369509083708165">Ultimatum әдепкі браузеріңіз болып табылады</translation>
<translation id="989816563149873169"><ph name="SHORTCUT" /> арқылы Ultimatum профильдерін ауыстыруға болады.</translation>
</translationbundle>