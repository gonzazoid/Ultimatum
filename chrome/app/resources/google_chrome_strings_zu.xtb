<translation id="8362914115861174987">Humushela ku-</translation>
<translation id="8366770919198174997">Yehlisa indlela yokusebenza kodwa yenza iUltimatum imelane nakakhulu nokuhlaselwa</translation>
<translation id="8367705492654390392">Buza noma ngabe yini</translation>
