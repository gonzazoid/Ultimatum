<translation id="1820835682567584003">Ultimatum <ph name="AUTHENTICATION_PURPOSE" /> በመሞከር ላይ ነው</translation>
<translation id="183031085822326697">በሚቀጥለው ጊዜ Ultimatumን በእርስዎ <ph name="DEVICE_TYPE" /> ላይ ሲከፍቱ Google የይለፍ ቃል አስተዳዳሪን ለመጠቀም ጥያቄ ያያሉ።</translation>
