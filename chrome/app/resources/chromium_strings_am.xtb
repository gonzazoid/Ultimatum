<translation id="4621240073146040695">የተዘመነ ለመሆን ጥቂት ብቻ ቀርቷል! ማዘመን ለማጠናቀቅ Ultimatumን ዳግም ያስጀምሩት።</translation>
<translation id="4625064703209785397">በUltimatum V8 ሞተር ጣቢያዎችን ያፋጥናል ነገር ግን የUltimatumን ጥቃቶችን የመቋቋም አቅም በመጠኑ ያነሰ ያደርገዋል</translation>
<translation id="4665829708273112819">ማስጠንቀቂያ፦ Ultimatum ቅጥያዎች የአሰሳ ታሪክዎን እንዳይመዘግቡ መከልከል አይችልም። ይህን ቅጥያ ማንነት በማያሳውቅ ሁነት ላይ ለማሰናከል ይህን አማራጭ አይምረጡ።</translation>
<translation id="4673151026126227699">እንዲሁም የUltimatum አጠቃቀም ሪፖርቶችን ካጋሩ፣ እነዚያ ሪፖርቶች እርስዎ የሚጎበኟቸውን ዩአርኤሎች ያካትታሉ</translation>
<translation id="4677944499843243528">መገለጫው በሌላ ኮምፒውተር (<ph name="HOST_NAME" />) ላይ በሌላ የUltimatum ሂደት (<ph name="PROCESS_ID" />) የተያዘ ይመስላል። Ultimatum መገለጫው እንዳይበላሽ ቆልፎታል። ሌሎች ሂደቶች ይህን መገለጫ እየተጠቀሙበት እንዳልሆኑ እርግጠኛ ከሆኑ መገለጫውን አስከፍተው Ultimatumን ዳግም ማስጀመር ይችላሉ።</translation>
<translation id="4680828127924988555">መጫኑን ሰርዝ</translation>
<translation id="469259825538636168">አንዳንድ የUltimatum ውሂብዎ በGoogle መለያዎ ውስጥ ገና አልተቀመጠም። ዘግተው ከመውጣትዎ በፊት ጥቂት ደቂቃዎች ለመጠበቅ ይሞክሩ። አሁን ዘግተው ከወጡ ይህ ውሂብ ይሰረዛል።</translation>
<translation id="4708193446201257833">በመለያ ገብተው ሳለ በUltimatum ውስጥ ከGoogle መለያዎ የይለፍ ቃላትዎን እና ሌሎችንም መጠቀም ይችላሉ። <ph name="SHORTCUT" /> የGoogle አገልግሎቶች ቅንብሮችዎን መለወጥ ይችላል።</translation>
<translation id="4708774505295300557">የሆነ ሰው ከዚህ ቀደም በዚህ ኮምፒውተር ላይ እንደ <ph name="ACCOUNT_EMAIL_LAST" /> ሆነው ገብተዋል። የእርስዎን መረጃ ለይተው ለማስቀመጥ እባክዎ አዲስ የUltimatum ተጠቃሚ ይፍጠሩ።</translation>
<translation id="4724676981607797757">በማይደገፍ የፕሮቶኮል ስህተት ምክንያት መጫኑ አልተሳካም።</translation>
<translation id="4746050847053251315">የሆነው ሆኖ Ultimatum ይቁም?</translation>
<translation id="4748217263233248895">ለUltimatum ልዩ የደህንነት ዝማኔ ተፈጻሚ ተደርጓል። አሁን ዳግም ያስጀምሩ እና የእርስዎን ትሮች ወደ ነበሩበት እንመልሳለን።</translation>
<translation id="4759645701210484457">Ultimatumን ጠይቅ</translation>
<translation id="4771701986670315895">በቅርብ ጊዜ አልጎበኙም። Ultimatum <ph name="PERMISSION_1" />፣ <ph name="PERMISSION_2" /> እና <ph name="COUNT" /> ሌሎችንም አስወግዷል።</translation>
<translation id="4788777615168560705">Ultimatum የእርስዎን የይለፍ ቃላት መፈተሽ አይችልም። ከ24 ሰዓቶች በኋላ እንደገና ይሞክሩ ወይም <ph name="BEGIN_LINK" />በGoogle መለያዎ ውስጥ የይለፍ ቃላትን ይፈትሹ<ph name="END_LINK" />።</translation>
<translation id="479167709087336770">ይህ በ Google ፍለጋ ውስጥ ጥቅም ላይ ጋር ተመሳሳይ የፊደል አራሚ ይጠቀማል። በአሳሽ ውስጥ የሚተይቡት ጽሁፍ ወደ Google ይላካል። ይህን ባህሪ ሁልጊዜ በቅንብሮች ውስጥ መለወጥ ይችላሉ።</translation>
<translation id="4814736265800133385">Ultimatumን ያለመለያ ይጠቀሙ</translation>
<translation id="4888717733111232871">Ultimatum ለmDNS ትራፊክ ለመፍቀድ የውስጥ ደንብ።</translation>
<translation id="4893347770495441059">&amp;Ultimatumን ለማዘመን ዳግም ያስነሱት</translation>
<translation id="4918086044614829423">ይቀበሉ</translation>
<translation id="4918844574251943176">ምስል ተቀድቷል</translation>
<translation id="4943838377383847465">Ultimatum በጀርባ ሁነታ ላይ ነው።</translation>
<translation id="494490797786467921">የUltimatum የመለያ መግቢያ መገናኛን ለመዝጋት ጠቅ ያድርጉ</translation>
<translation id="4950660488495335294">በUltimatum መገለጫዎች ሁሉንም የUltimatum ነገሮችዎን መለየት ይችላሉ። ለጓደኞች እና ለቤተሰብ መገለጫዎችን ይፍጠሩ፣ ወይም በሥራ እና በመዝናኛ መካከል ይከፋፈሉ።</translation>
<translation id="4987820182225656817">እንግዳዎች ማንኛውንም ነገር ወደኋላ ሳይተዉ Ultimatum መጠቀም ይችላሉ።</translation>
<translation id="4992938037305302429">Ultimatum ውስጥ ያለ መለያዎ</translation>
<translation id="4994636714258228724">እራስዎን በUltimatum ላይ ያክሉ</translation>
<translation id="5083712646171654472">Gemini በUltimatum ውስጥ በትሮችዎ ውስጥ ለመሥራት እና እርስዎ የሚሰጡትን ተግባራት ለማጠናቀቅ ራስ-ሰር አሰሳን ይጠቀማል። <ph name="LINK_BEGIN" />የበለጠ ለመረዳት<ph name="LINK_END" /></translation>
<translation id="5123973130450702873">Ultimatum እጆችዎን ለመከታተል ፈቃድ ያስፈልገዋል</translation>
<translation id="5141988424377517949">በቅርብ ጊዜ አልጎበኙም። Ultimatum <ph name="PERMISSION_1" />፣ <ph name="PERMISSION_2" />፣ <ph name="PERMISSION_3" />ን አስወግዷል።</translation>
<translation id="5174969993834422967">አብዛኛውን ጊዜ ማሳወቂያዎችን ያግዳሉ። ይህ ጣቢያ እንዲያሳውቅዎ ለመፍቀድ በአካባቢ አሞሌዎ ቀኝ ጥግ ላይ ያለውን የማሳወቂያ አዶ ጠቅ ያድርጉ።</translation>
<translation id="5174983315706567306">በቂ የዲስክ ቦታ የለም።</translation>
<translation id="5187123684706427865">የUltimatum መለያ ዳግም ማረጋገጥ ያስፈልገዋል</translation>
<translation id="5224391634244552924">ምንም የተቀመጡ የይለፍ ቃላት የሉም። እርስዎ የይለፍ ቃላትዎን ሲያስቀምጧቸው Ultimatum መፈተሽ ይችላል።</translation>
<translation id="5231355151045086930">ከUltimatum ዘግተው ይውጡ</translation>
<translation id="5234764350956374838">አሰናብት</translation>
<translation id="5254739261293693943">ስለዚህ ቪድዮ ይጠይቁ</translation>
<translation id="5276305953263010518">በመሄድ ላይ ሳሉ የይለፍ ቃላትን ለማስቀመጥ የUltimatum መተግበሪያን ያግኙ</translation>
<translation id="5277894862589591112">የእርስዎን ለውጦች ተፈጻሚ ለማድረግ፣ Ultimatumን ዳግም ያስጀምሩ</translation>
<translation id="5286907366254680517">ተገኝቷል</translation>
<translation id="5289287148052354622">የUltimatum መተግበሪያን አግኝ</translation>
<translation id="5294316920224716406">ማንነትን በማያሳውቅ ሁነታ ሲያስሱ፣ Ultimatum ደህንነቱ ያልተጠበቀ ግንኙነት በመጠቀም ጣቢያ ከመጫንዎ በፊት ያስጠነቅቀዎታል</translation>
<translation id="5313228254328109263">የUltimatum ማዘመኛ ውስጣዊ አገልግሎት</translation>
<translation id="5346389065299425353">ብዙ ትሮች፣ ፋይሎች እና መሣሪያዎችን በማከል ፍለጋዎን ያሳድጉ</translation>
<translation id="5352264705793813212">Ultimatum ለግምገማዎ አንዳንድ የደህንነት ምክሮችን አግኝቷል</translation>
<translation id="5352361688875342522">ሌሎች የUltimatum መገለጫዎች</translation>
<translation id="5358375970380395591">በሚተዳደር መለያ እየገቡ ነው፣ እና አስተዳዳሪው በእርስዎ Ultimatum መገለጫ ላይ ቁጥጥር እየሰጡት ነው። እንደ እርስዎ  መተግበሪያዎች፣ ዕልባቶች፣ ታሪክ፣ የይለፍ ቃላት እና ሌሎች ቅንብሮች ያሉ የእርስዎ Ultimatum ውሂብ እስከ መጨረሻው ከ<ph name="USER_NAME" /> ጋር የተያያዙ ይሆናሉ። ይህን ውሂብ በGoogle የመለያዎች Dashboard አማካኝነት ሊሰርዙት ይችላሉ፣ ነገር ግን ይህን ውሂብ ከሌላ መለያ ጋር ሊያጎዳኙት አይችሉም። <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">ተጨማሪ ኮድ፦ <ph name="EXTRA_CODE" />።</translation>
<translation id="5377622451696208284">ግላዊነት ለማላበስ Ultimatumን በድር እና በመተግበሪያ እንቅስቃሴ ውስጥ ያካትቱ</translation>
