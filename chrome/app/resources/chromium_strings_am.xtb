<!DOCTYPE translationbundle>
<translationbundle lang="am">
<translation id="1026101648481255140">መጫኑን ከቆመበት ቀጥል</translation>
<translation id="1029669172902658969">&amp;UltimatumOSን ለማዘመን ዳግም ያስነሱት</translation>
<translation id="1040916596585577953">Ultimatum ይህን ቅጥያ እንዲገመግሙ ይመክርዎታል</translation>
<translation id="1042552502243217427">አንድ ጣቢያ በገጻቸው ላይ በግል አገናኞችን ቅድሚያ ለመጫን ሲጠይቅ Ultimatum የGoogle አገልጋዮችን ይጠቀማል። ይህ ማንነትዎን ቅድሚያ ከተጫነው ጣቢያ ይደብቃል ነገር ግን Google ምን ጣቢያዎች ቅድሚያ እንደሚጫኑ ያውቃል።</translation>
<translation id="1051793555070215510">ይህን የ1 ደቂቃ የዳሰሳ ጥናት በመውሰድ ማንነት የማያሳውቅን እንድናሻሽል ያግዙን።</translation>
<translation id="1065672644894730302">አማራጮችዎ ሊነበቡ አልቻሉም።

አንዳንድ ባህሪያት ላይገኙ ይችላሉ፣ እና በአማራጮች ላይ የተደረጉ ለውጦች አይቀመጡም።</translation>
<translation id="1083934481477628225">የእርስዎ ወላጅ ለUltimatum «የጣቢያዎች፣ መተግበሪያዎች እና ቅጥያዎች ፈቃዶች» የሚለውን አጥፍተዋል።</translation>
<translation id="1090946077924227754">አንድን የተወሰነ የUltimatum ባህሪ ወይም ቅጥያ ለመፈለግ የእርስዎን የተመረጠ የቁልፍ ሰሌዳ ቁልፍ በማስከተል በአድራሻ አሞሌው ውስጥ አቋራጩን ይተይቡ</translation>
<translation id="1104942323762546749">Ultimatum የእርስዎን የይለፍ ቃላት ወደ ውጭ መላክ ይፈልጋል። ይህንን ለመፍቀድ የWindows የይለፍ ቃልዎን ይተይቡ።</translation>
<translation id="112640046208448578">ነገሮችን ወይም ቦታዎች ይለዩ እና ጽሁፍን ይቅዱ ወይም ይተርጉሙ። የምስል ፍለጋ ሲጠቀሙ የገፁ ቅጽበታዊ ገፅ ዕይታ ወደ አገልጋዩ ይላካል። <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Ultimatum የእርስዎ ነባሪ አሳሽ ነው</translation>
<translation id="1131805035311359397">የእርስዎ የይለፍ ቃላት ከውሂብ ጥሰቶች እና ሌሎች የደህንነት ችግሮች ነፃ መሆናቸውን ለማረጋገጥ <ph name="BEGIN_LINK" />በመለያ ወደ Ultimatum ይግቡ<ph name="END_LINK" />።</translation>
<translation id="1153368717515616349">Ultimatum ምናሌው ላይ ጠቅ ያድርጉ</translation>
<translation id="1157985233335035034">የቅርብ ጊዜ ቋንቋዎች</translation>
<translation id="1171831736360285680"><ph name="PARTNER_NAME" /> Ultimatum የሚሠራበትን መንገድ ሊለውጥ የሚችል ቅጥያ አክሏል።

<ph name="EXTENSION_NAME" /></translation>
<translation id="1184145431117212167">የእርስዎ የመስኮቶች ሥሪት ስለማይደገፍ ጭነቱ ተሰናክሏል።</translation>
<translation id="1185134272377778587">ስለUltimatum</translation>
<translation id="1203500561924088507">ሰለተጫኑ እናመሰግናለን። <ph name="BUNDLE_NAME" />ን ከመጠቀምዎ በፊት አሳሽዎን እንደገና ማስጀመር አለብዎት።</translation>
<translation id="1232234696885483911">የምስል ፍለጋን ሲከፍቱ PDFዎችን ጨምሮ የገጹ ርዕስ፣ ዩአርኤል እና ይዘት በራስ-ሰር ወደ አገልጋዩ ይላካሉ። <ph name="LEARN_MORE" /></translation>
<translation id="123265588161106468">በመለያ ገብተው ሳለ በUltimatum ውስጥ ከGoogle መለያዎ የይለፍ ቃላትዎን እና ሌሎችንም መጠቀም ይችላሉ። ይህን ለመለወጥ ወደ «Ultimatum ውስጥ የእርስዎ መለያ» ይሂዱ።</translation>
<translation id="1262876892872089030">ይህ ትር ቦዝኖ ሳለ Ultimatumን ፈጣን እንደሆነ ለማቆየት ማህደረ ትውስታ ነፃ ተደርጓል። ይህን ጣቢያ ሁልጊዜ ከመቦዘን ማግለል መምረጥ ይችላሉ።</translation>
<translation id="1265577313130862557">ፋይሉ አደገኛ ስለሆነ Ultimatum ይህን ውርድ አግዷል</translation>
<translation id="126567311906253476">በ<ph name="USER_EMAIL" /> እንደ Gmail ወይም YouTube ወዳሉ የGoogle አገልግሎቶች ሲገቡ በተመሳሳይ መለያ ወደ Ultimatum መግባት ይችላሉ</translation>
<translation id="1287534462498555020">Ultimatumን በስልክዎ ላይ ያግኙ</translation>
<translation id="1290883685122687410">የውቅረት ስህተት፦ <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">አዲሱን የUltimatum መገለጫዎ ያቀናብሩት</translation>
<translation id="132092532143527429">በGemini በUltimatum ውስጥ ይሞክሩ</translation>
<translation id="1324107359134968521">Ultimatum የብሉቱዝ መሣሪያዎችን ለማሰስ የብሉቱዝ መዳረሻ 
ያስፈልገዋል። <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1330562121671411446">ቋንቋ አግኝ</translation>
<translation id="1330742950061766891">በUltimatum የሚመከሩ የአሳሽ ቅንብሮችን ይጠቀሙ</translation>
<translation id="1342274909142618978">እንዲሁም ከUltimatum (<ph name="URL" />) ውሂብን ይሰርዙ</translation>
<translation id="1345251407431278948">ፒን ተደርጓል! የምስል ፍለጋን እንደገና የመሣሪያ አሞሌው ላይ ካለው ከአዲሱ አዝራር መድረስ ይችላሉ</translation>
<translation id="1356661055722410047">አዲስ! ማያ ገፅዎ ላይ ሁለቱንም ጽሁፍ እና ምስሎችን መተርጎም ይችላሉ</translation>
<translation id="1383876407941801731">ፍለጋ </translation>
<translation id="1397530502368084401">እና የUltimatum መገለጫዎችን ያስተዳድሩ</translation>
<translation id="1404026649028693342">ሁልጊዜ የሰው ሠራሽ አስተውሎት ሁነታን አሳይ</translation>
<translation id="141901961143729572">ሀሳቦችዎን ያጋሩ</translation>
<translation id="1465192221147974788">መስኮትዎን ለማጋራት በሥርዓት ቅንብሮች ውስጥ ለUltimatum የማያ ገፅ መቅረጽን ይፍቀዱ።</translation>
