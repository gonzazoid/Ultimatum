<translation id="7339898014177206373">አዲሰ መስኮት</translation>
<translation id="734373864078049451">የእርስዎ ድር፣ ዕልባቶች እና ሌሎች የUltimatum ነገሮች እዚህ ይኖራሉ።</translation>
<translation id="7347827960336370838">የእርስዎን የተመሰጠረ ውሂብ ማንበብ የሚችለው የይለፍ ሐረግዎ ያለው ሰው ብቻ ነው። የይለፍ ሐረጉ ወደ Google አይላክም ወይም በGoogle አይከማችም። የእርስዎን የይለፍ ሐረግ ከረሱ ወይም ይህን ቅንብር መለወጥ ከፈለጉ <ph name="BEGIN_LINK" />በመለያዎ ውስጥ ያለውን Ultimatum ውሂብ መሰረዝ<ph name="END_LINK" /> ይኖርብዎታል።</translation>
<translation id="7349591376906416160">የእርስዎ ስርዓት አስተዳዳሪ Ultimatum <ph name="TARGET_URL_HOSTNAME" />ን ለመድረስ <ph name="ALTERNATIVE_BROWSER_NAME" />ን እንዲከፍት አዋቅሮታል።</translation>
<translation id="7352651011704765696">የሆነ ችግር ተፈጥሯል</translation>
<translation id="7368826207863345663">የወደፊት የUltimatum ዝማኔዎችን ለማግኘት macOS 13 ወይም ከዚያ በላይ ያስፈልግዎታል። ይህ ኮምፒውተር macOS 12 እየተጠቀመ ነው።</translation>
<translation id="7376384068949534168">በቅርብ ጊዜ አልጎበኙም። Ultimatum <ph name="PERMISSION_1" />፣ <ph name="PERMISSION_2" />ን አስወግዷል።</translation>
<translation id="7384121030444253939">ይህ ቅጥያ ከአሁን በኋላ አይደገፍም። Ultimatum እንዲያስወግዱት ይመክራል።</translation>
<translation id="7413153308467572558">ካቆሙበት ይቀጥሉ፦ Ultimatum እንደገና በጀመሩ ቁጥር የእርስዎን ትሮች ወደነበሩበት ይመልሳል። ይህን ለማጥፋት ወደሚከተለው ይሂዱ</translation>
<translation id="7427879960656355200">የይለፍ ቃላትን ወደ Ultimatum ያምጡ</translation>
<translation id="744815265653811511">1. ከታች <ph name="BUTTON_LABEL" /> ላይ ጠቅ ያድርጉ
2. በWindows ቅንብሮችዎ ውስጥ <ph name="BUTTON_2" /> ላይ ጠቅ ያድርጉ
3. ለፈጣን መዳረሻ Ultimatumን በተግባር አሞሌዎ ላይ ለመሰካት በWindows ማሳወቂያ ውስጥ <ph name="BUTTON_3" /> ላይ ጠቅ ያድርጉ</translation>
<translation id="7449453770951226939"><ph name="PAGE_TITLE" /> - Ultimatum ግንባታ</translation>
<translation id="7450541714075000668">ጽሁፍ ገልብጧል</translation>
<translation id="7451052299415159299">Ultimatum ለዚህ ጣቢያ የእርስዎን ካሜራ ለመድረስ ፈቃድ ያስፈልገዋል</translation>
<translation id="7458892263350425044">ማይክሮፎንዎን ለመጠቀም <ph name="BEGIN_LINK" />የሥርዓት ቅንብሮች<ph name="END_LINK" /> ውስጥ ለUltimatum መዳረሻ ይስጡ</translation>
<translation id="7461356015007898716">የወደፊት የUltimatum ዝማኔዎችን ለማግኘት Windows 10 ወይም ከዚያ በላይ ያስፈልግዎታል። ይህ ኮምፒውተር Windows 7ን እየተጠቀመ ነው።</translation>
<translation id="7467949745582939695">Ultimatum ዳግም ይጀመር?</translation>
<translation id="7483335560992089831">እየሄደ ያለውን ተመሳሳዩን የUltimatum ስሪት መጫን አይቻልም። እባክዎ Ultimatumን ይዝጉና እንደገና ይሞክሩ።</translation>
<translation id="751935028865900641">ጣቢያዎች እንደተጠበቀው መስራታቸው አይቀርም። ከGoogle መለያዎ በስተቀር በ Ultimatum ውስጥ ገብተው ከሆነ፣ ሁሉንም የUltimatum መስኮቶች ሲዘጉ ከአብዛኞቹ ጣቢያዎች ይወጣሉ።</translation>
<translation id="753534427205733210">{0,plural, =1{Ultimatum በ1 ደቂቃ ውስጥ ዳግም ይጀመራል}one{Ultimatum በ# ደቂቃዎች ውስጥ ዳግም ይጀመራል}other{Ultimatum በ# ደቂቃዎች ውስጥ ዳግም ይጀመራል}}</translation>
<translation id="7565444033145385702">ውሂብዎን ለመጠበቅ Ultimatum እርስዎ በቅርቡ ካልጎበኟቸው ጣቢያዎች ላይ ፈቃዶችን እንዲያስወግድ ይፍቀዱ።</translation>
<translation id="7583104404158659071">በቅጽበት ማሰስ ለመጀመር Ultimatumን በራስ-ሰር አስጀምር።</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> ጫኝ</translation>
<translation id="761356813943268536">Ultimatum ካሜራዎን እና ማይክሮፎንዎን እየተጠቀመ ነው።</translation>
<translation id="7617377681829253106">Ultimatum አሁን ይበልጥ ተሻሽሏል</translation>
<translation id="7622753900276619808">አሁን Ultimatum ውስጥ የሚገኙ ተጨማሪ ባህሪያት አሉዎት</translation>
<translation id="7624307931717240213">ይህን አገልግሎት ለማሻሻል መረጃ እንጠቀማለን። የግላዊነት መመሪያን እና የአገልግሎት ውልን ይመልከቱ።</translation>
<translation id="7649070708921625228">እገዛ</translation>
<translation id="7650134251917003571">የUltimatum መተግበሪያን ያግኙ</translation>
<translation id="7656340475565475526">Ultimatum ለእርስዎ እንዲያስስ ይፍቀዱ</translation>
<translation id="7658239707568436148">ይቅር</translation>
<translation id="7686590090926151193">Ultimatum ነባሪ አሳሽዎ አይደለም</translation>
<translation id="7689606757190482937">በመላ መሣሪያዎችዎ ላይ Ultimatumን ያሳምሩ እና ግላዊነት ያላብሱ</translation>
<translation id="7699779824407626136">Ultimatum ዝማኔ</translation>
<translation id="7716950018788545737">ተግባር(ራት) አልቋል(አልቀዋል)።</translation>
<translation id="77283119132245232">ለ<ph name="BROWSER_NAME" /> የሥርዓት ክትትል አገልግሎቶች ያቀርባል። ይህ አገልግሎት ከተሰናከለ በአሳሹ የተፈጠሩ የአፈጻጸም መከታተያዎች እንደ የዓውድ መቀያየሪያ እና ዝግጁ ተከታታይ ክስተቶች ያሉ ሥርዓት አቀፍ ክስተቶችን አያካትቱም።</translation>
<translation id="7745317241717453663">ይሄ የአሰሳ ውሂብዎን ከዚህ መሣሪያ ይሰርዘዋል። ውሂብዎን በኋላ ላይ ሰርስረው ለማውጣት እንደ <ph name="USER_EMAIL" /> ሆነው ወደ Ultimatum ይግቡ።</translation>
<translation id="7747138024166251722">ጫኝው ጊዜያዊ ማውጫ መፍጠር አልቻለም። እባክዎ ነፃ የዲስክ ቦታ እና ሶፍትዌር የመጫን ፍቃድ እንዳለ ይፈትሹ።</translation>
<translation id="7750130090210923118">ወደ ነባሪ Ultimatum ዳግም አስጀምር</translation>
<translation id="7781047659465034537">Ultimatumን እንደ ነባሪ ያቀናብሩ እና የተግባር አሞሌው ላይ ይሰኩት</translation>
<translation id="7786760609782648049">Ultimatumን የበለጠ ፈጣን ያድርጉት</translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> - Ultimatum Canary</translation>
<translation id="7803986347287457849">የበይነመረብ ትራፊክዎ መዳረሻ ላላቸው ሰዎች እርስዎ የትኞቹን ጣቢያዎች እንደሚጎበኙ ማየት ያክብዱባቸው። Ultimatum የጣቢያውን አይ ፒ አድራሻ በዲኤንኤስ (የጎራ ስም ሥርዓት) ውስጥ ለመፈለግ የተመሰጠረ ግንኙነትን ይጠቀማል።</translation>
<translation id="7810005234485217901">በቀላሉ ለመድረስ የምስል ፍለጋን ፒን ማድረግ ይችላሉ</translation>
<translation id="7828947555739565424">ይህን መለያ ያለው አንድ የUltimatum መገለጫ አስቀድሞ በዚህ መሣሪያ ላይ አለ</translation>
<translation id="7845233973568007926">ሰለተጫኑ እናመሰግናለን። <ph name="BUNDLE_NAME" />ን ከመጠቀምዎ በፊት ኮምፒውተርዎን እንደገና ማስጀመር አለብዎት።</translation>
<translation id="7853661403199074278">Ultimatumን አዲስ መልክ ለመስጠት ያብጁት</translation>
<translation id="7859018312476869945">የአድራሻ አሞሌ ወይም የፍለጋ ሳጥን ውስጥ ሲተይቡ የተሻሉ ጥቆማዎችን ለማግኘት Ultimatum የሚተይቡትን ለእርስዎ ነባሪ የፍለጋ ፕሮግራም ይልካል። ይህ ማንነት የማያሳውቅ ውስጥ ጠፍቷል።</translation>
<translation id="7867198900892795913">Ultimatum ወደ የቅርብ ጊዜው ስሪት ሊዘመን አልቻለም፣ ስለዚህ አዲስ ባህሪያት እና የደህንነት ጥገናዎች እያመለጡዎት ናቸው። Ultimatumን ማዘመን አለብዎት።</translation>
<translation id="7872446069773932638">በማውረድ ላይ... <ph name="SECONDS" /> ሰከንድ(ዶች) ይቀራሉ</translation>
<translation id="7873537467422636035">የይለፍ ሐረግዎን ከረሱ ወይም ይህን ቅንብር መለወጥ ከፈለጉ <ph name="BEGIN_LINK" />በመለያዎ ውስጥ ያለውን የUltimatum ውሂብ ይሰርዙ<ph name="END_LINK" /></translation>
<translation id="7877212753140190672">ስለዚህ ምስል ይጠይቁ</translation>
<translation id="7888981273428720788">Ultimatumን እንደ ነባሪ ያቀናብሩት</translation>
<translation id="7934340546140346950">Ultimatum በሚቻልበት ጊዜ ደህንነታቸው ያልተጠበቀ ግንኙነቶችን በራስ-ሰር ወደ ኤችቲቲፒኤስ ያልቃል</translation>
<translation id="7937630085815544518">እንደ <ph name="USER_EMAIL_ADDRESS" /> ሆነው ወደ Ultimatum ገብተዋል። እባክዎ እንደገና ለመግባት ተመሳሳዩን መለያ ይጠቀሙ።</translation>
<translation id="7975919845073681630">ይሄ ሁለተኛ የUltimatum ጭነት ነው፣ እና ነባሪ አሳሽዎ ማድረግ አይቻልም።</translation>
<translation id="7997934263947464652">ካልታወቁ ምንጮች የመጡ ቅጥያዎች፣ መተግበሪያዎች እና ገጽታዎች መሣሪያዎን ሊጎዱ ይችላሉ። Ultimatum እነሱን ከ<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ብቻ መጫንን ይመክራል</translation>
<translation id="8004582292198964060">አሳሽ</translation>
<translation id="8010081455002666927">በራስ-አግኝ</translation>
<translation id="8013436988911883588">አንዴ Ultimatum መዳረሻ ከኖረው በኋላ ድር ጣቢያዎች እርስዎን መዳረሻ መጠየቅ ይችላሉ።</translation>
<translation id="8031714377769448844">በማንኛውም ጊዜ በፍጥነት ወደ Ultimatum ለመሄድ ፒን ያድርጉት</translation>
