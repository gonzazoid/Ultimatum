<translation id="7873537467422636035">Хэрэв та нэвтрэх үгээ мартсан эсвэл энэ тохиргоог өөрчилмөөр байвал <ph name="BEGIN_LINK" />бүртгэлийнхээ Ultimatum-н өгөгдлийг устгана уу<ph name="END_LINK" /></translation>
